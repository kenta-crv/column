.auth-wrapper.auth-wrapper--signup
  .auth-forms
    .auth-card.auth-card--signup.auth-card--login
      .auth-card__header
        h2.auth-card__title パスワード再設定

      = form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: "auth-signup-form" }) do |f|
        = render "admins/shared/error_messages", resource: resource

        .auth-form-section
          p.auth-card__lead 登録メールアドレスを入力してください。再設定用のリンクをお送りします。
          .field
            = f.label :email, "メールアドレス"
            = f.email_field :email, autofocus: true, autocomplete: "email", class: "input-field", placeholder: "admin@example.com", required: true

        .actions
          = f.submit "再設定メールを送信", class: "btn-signup"

      .auth-card__footer
        = render "admins/shared/links"
