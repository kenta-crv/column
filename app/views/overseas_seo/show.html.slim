        .features-grid
          - cards = [{ num: "01", title: "市場調査", desc: "対象とする国や言語の検索需要を見て、いま書くテーマを決めます。" }, { num: "02", title: "記事作成", desc: "決めたテーマで、検索と読者の両方に届く原稿を作ります。" }, { num: "03", title: "分析", desc: "公開後の順位や流入を見て、次に直すところと次に書くテーマを決めます。" }, { num: "04", title: "公開", desc: "サイトへ載せ、検索に届く状態まで持っていきます。" }]
          - cards.each do |fc|
