      .section-header
        span.overline FAQ
        h2.section-title よくあるご質問
        p.section-sub 海外SEOのコンサルティングについて、よくある点をまとめました。
      .faq-layout
        .faq-panel
          - faqs = [{ q: "ツールの契約ですか？", a: "いいえ。市場調査から記事作成、分析、公開までを継続して行うコンサルティングです。管理画面を渡して終わり、というサービスではありません。" }, { q: "料金はいくらですか？", a: "月額98,000円です。市場調査、記事作成、分析、公開までを、この料金で継続します。" }, { q: "対応する国や言語は決まっていますか？", a: "開始前にご相談のうえで決めます。まずは狙う市場を伺い、調査から始めます。" }, { q: "記事は月に何本ですか？", a: "本数は開始前にご相談のうえで決めます。テーマの難しさや対象市場に合わせて調整します。" }, { q: "公開は誰が行いますか？", a: "公開までこのサービスで行います。掲載先のサイトや、更新に必要な権限は開始時に確認します。" }, { q: "途中で止められますか？", a: "契約期間の細目は開始前にご案内します。ご不明点は info@j-work.jp までお問い合わせください。" }]
          - faqs.each_with_index do |item, idx|
            details.faq-panel__item class=("is-open-default" if idx.zero?) open=(idx.zero? || nil)
              summary.faq-panel__q = item[:q]
              p.faq-panel__a = item[:a]
      .faq-contact
        p ここにない内容は、お気軽にお問い合わせください。
        = mail_to "info@j-work.jp", class: "btn-primary", subject: "海外SEOのご相談" do
