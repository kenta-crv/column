- set_meta_tags title: "海外SEOの記事生成代行「Drafity」"
- set_meta_tags description: "ご希望の国・言語に合わせ、現地検索エンジンのアルゴリズム・構造化データに最適化した記事制作を代行。海外でのSEO上位表示を実現します。"

.drafify-lp.overseas-seo-lp
  nav.nav
    .nav-inner
      = link_to overseas_seo_path
        = image_tag drafity_logo_image, width: "150px", alt: "Drafity"
      .nav-links
        a href="#service" サービスの特徴
        a href="#flow" 制作の流れ
        a.active href="#pricing" 料金プラン
        a href="#faq" よくある質問
        a href="#about" 運営会社
      .nav-cta
        = mail_to "info@j-work.jp", "無料相談する", subject: "Drafityのご相談", class: "btn-primary"

  section.hero
    .hero-inner
      .hero-copy
        .hero-eyebrow
          span.eyebrow-badge 海外展開・グローバルSEO支援
          span.eyebrow-text 海外進出・集客をお考えの企業様へ
        h1.hero-title
          | 海外展開を成功を
          br.pc-only
          | 最適化SEO記事で加速する
          br
          span.num 『Drafity』
        p.hero-desc
          | ターゲット国の検索エンジン構造に完全最適化。現地ユーザーに刺さる高精度な記事を生成代行し、検索上位表示へと導きます。

      .hero-visual
        = image_tag "overseas-hero-bg.webp", alt: "海外SEO記事生成のイメージ", class: "hero-img"

      .hero-cards
        .hero-checks
          - ["検索エンジン最適化", "高品質記事作成", "SEO上位表示"].each do |check|
            span.check-pill
              svg viewBox="0 0 14 14" fill="none"
                path d="M2.5 7l3 3 6-6" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"
              = check

      .hero-cta-block
        .hero-actions
          = mail_to "info@j-work.jp", "まずは無料で相談する", subject: "Drafityのご相談", class: "btn-primary-lg"
          a.btn-ghost.btn-purple href="#pricing" 料金プランを見る
        p.hero-trial-note style="margin-left:16px"
          span.hero-trial-note__icon aria-hidden="true"
            svg viewBox="0 0 14 14" fill="none" focusable="false"
              path d="M2.5 7l3 3 6-6" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"
          span 英語圏・中国・韓国・ドイツなど、世界各国の言語・市場に対応

  .lang-marquee aria-label="対応言語一覧"
    .lang-marquee-track
      - langs = [{ flag: "🇰🇷", name: "한국어" }, { flag: "🇨🇳", name: "中文" }, { flag: "🇬🇧", name: "English" }, { flag: "🇩🇪", name: "Deutsch" }, { flag: "🇫🇷", name: "Français" }, { flag: "🇪🇸", name: "Español" }, { flag: "🇵🇹", name: "Português" }, { flag: "🇮🇹", name: "Italiano" }, { flag: "🇳🇱", name: "Nederlands" }, { flag: "🇵🇱", name: "Polski" }, { flag: "🇸🇪", name: "Svenska" }, { flag: "🇹🇷", name: "Türkçe" }, { flag: "🇷🇺", name: "Русский" }, { flag: "🇸🇦", name: "العربية" }, { flag: "🇮🇳", name: "हिन्दी" }, { flag: "🇹🇭", name: "ภาษาไทย" }, { flag: "🇻🇳", name: "Tiếng Việt" }, { flag: "🇮🇩", name: "Bahasa Indonesia" }]
      - 2.times do |copy|
        ul.lang-marquee-group aria-hidden=(copy.positive? || nil)
          - langs.each do |lang|
            li.lang-pill
              span.lang-pill-flag aria-hidden="true" = lang[:flag]
              span.lang-pill-name = lang[:name]

  section.whats-section#service
    .whats-inner
      .section-header
        span.overline SERVICE
        h2.section-title
          | WebサイトをグローバルSEO仕様へ
          br
          | 海外自然検索トラフィックを最大化
        p.whats-lead-text
          | 対象国や言語の特性、ガイドラインや検索アルゴリズムに合わせて最適な記事を生成・運用代行。ターゲット市場の検索結果で確実な上位表示を目指します。

      .whats-intro-block
        .whats-intro-left
          .whats-features-row
            - features = [{ class: "icon-lightning", title: "多国籍・多言語対応", desc: "ターゲット国の文化や検索トレンドに合わせた最適な言語で展開します。" }, { class: "icon-shield", title: "構造化SEO最適化", desc: "各検索エンジンの評価基準に沿った高度なサイト・記事構造を構築します。" }, { class: "icon-growth", title: "圧倒的なSEO成果", desc: "単なる翻訳ではなく、現地で「検索される」質の高い記事で上位表示を実現します。" }]
            - features.each do |wf|
              .whats-feature-pill
                .wfp-icon class=wf[:class]
                  svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"
                    - if wf[:class] == "icon-lightning"
                      polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"
                    - elsif wf[:class] == "icon-shield"
                      path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"
                    - else
                      line x1="18" y1="20" x2="18" y2="10"
                      line x1="12" y1="20" x2="12" y2="4"
                      line x1="6" y1="20" x2="6" y2="14"
                .wfp-body
                  h4.wfp-title = wf[:title]
                  p.wfp-desc = wf[:desc]

        .whats-intro-right
          .whats-mockup-container
            .whats-laptop-img
              = image_tag "whats.png", alt: "記事制作・管理画面イメージ"

  section.problem-section
    .problem-inner
      .section-header
        span.overline PAIN POINTS
        h2.section-title
          | 海外向けのマーケティングで、こんな
          span.text-highlight-blue 課題
          | を抱えていませんか？
        .section-dots
          span
          span
          span

      .problem-scroll-wrap
        button.problem-scroll-btn.problem-scroll-prev type="button" aria-label="前へ" onclick="scrollLpCards('.problem-grid', -1)"
          svg viewBox="0 0 24 24" fill="none"
            path d="M15 6l-6 6 6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
        .problem-grid
          - problems = [{ icon: "search", text: "現地ユーザーの検索ニーズが掴めない", desc: "国ごとに異なる検索習慣やキーワードの需要が分からず、施策に踏み切れない。" }, { icon: "clock", text: "各国検索エンジンの攻略法が不明", desc: "Google、Baidu、Naverなど、プラットフォームごとのアルゴリズムの違いに対応しきれない。" }, { icon: "chart", text: "現地語での高品質な記事作成が困難", desc: "単なる翻訳ではなく、検索上位を狙えるレベルの現地語コンテンツを社内で作れない。" }, { icon: "bell", text: "外注しても品質が安定しない", desc: "翻訳会社やクラウドソーシングへの都度発注では、トンマナや専門性がバラバラになってしまう。" }]
          - problems.each do |p|
            .problem-card-item
              .pci-meta
                .pci-visual-icon
                  svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                    - if p[:icon] == "clock"
                      circle cx="12" cy="12" r="10"
                      polyline points="12 6 12 12 16 14"
                    - elsif p[:icon] == "search"
                      circle cx="11" cy="11" r="8"
                      line x1="21" y1="21" x2="16.65" y2="16.65"
                    - elsif p[:icon] == "chart"
                      line x1="18" y1="20" x2="18" y2="10"
                      line x1="12" y1="20" x2="12" y2="4"
                      line x1="6" y1="20" x2="6" y2="14"
                    - else
                      path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"
                      path d="M13.73 21a2 2 0 0 1-3.46 0"
              .pci-content
                .pci-check-line
                  span.pci-check-box
                  p.pci-check-text = p[:text]
                p.pci-description = p[:desc]
        button.problem-scroll-btn.problem-scroll-next type="button" aria-label="次へ" onclick="scrollLpCards('.problem-grid', 1)"
          svg viewBox="0 0 24 24" fill="none"
            path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"

      .solution-arrow
        svg viewBox="0 0 24 24" fill="currentColor"
          path d="M12 21l-12-18h24z"

      .solution-banner-box
        .sb-content-left
          .sb-headline-row
            span.sb-lead-text 海外マーケティングの失敗を防ぐ！
            span.sb-badge-tag 海外SEO上位表示の決定版
          .sb-brand-row
            .sb-logo-mark
              svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"
                polyline points="14 2 14 8 20 8"
                line x1="16" y1="13" x2="8" y2="13"
                line x1="16" y1="17" x2="8" y2="17"
                polyline points="10 9 9 9 8 9"
            h3.sb-brand-name Drafity
            span.sb-suffix-text が
            span.sb-gradient-action すべて解決
            span.sb-suffix-text いたします。
        .sb-mockup-right
          .sb-dashboard-wrapper
            /img.sb-dashboard-img src=image_path('dashboard-preview.png') alt="Drafity Dashboard"
          .sb-deco-icon.deco-sparkle
            svg viewBox="0 0 24 24" fill="currentColor"
              path d="M12 0l3 9 9 3-9 3-3 9-3-9-9-3 9-3z"
          .sb-deco-icon.deco-chat
            svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
              path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"
          .sb-deco-icon.deco-chart
            svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"
              line x1="18" y1="20" x2="18" y2="10"
              line x1="12" y1="20" x2="12" y2="4"
              line x1="6" y1="20" x2="6" y2="14"

  section.features-strip#features
    .features-inner
      .section-header
        span.overline FEATURES
        h2.section-title 国が違えば、評価されるSEO基準も大きく異なります
        p.section-sub 日本語記事の機械翻訳だけでは、現地の検索上位には決して入りません。各国の検索エンジンが正しく評価する構造設計と、洗練された現地語表現でコンテンツを形にします。

      .features-scroll-wrap
        .features-grid
          - cards = [{ num: "01", title: "国ごとの主流検索エンジンに完全最適化", desc: "Googleをはじめ、Baidu（中国）やNaver（韓国）など、各国の主要プラットフォームの特徴やアルゴリズムに合わせた最適な記事構造を設計します。" }, { num: "02", title: "現地の検索意図を踏まえた構成案の策定", desc: "見出し構成・網羅すべき論点・情報の密度まで、現地ユーザーの生の検索ニーズを分析して構築。単なる「直訳」ではない実用的な構成を作成します。" }, { num: "03", title: "自然で高品質な現地語原稿を生成", desc: "一般的な翻訳サービスとは一線を画し、最初から「SEOでの集客」を目的とした原稿を生成。広告依存脱却に向けた、持続可能な自然流入を獲得します。" }]
          - cards.each do |fc|
            .feature-card
              .fc-top
                .fc-head-row
                  .fc-num = fc[:num]
                  .fc-icon
                    svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                      - if fc[:num] == "01"
                        circle cx="11" cy="11" r="8"
                        line x1="21" y1="21" x2="16.65" y2="16.65"
                      - elsif fc[:num] == "02"
                        path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"
                        polyline points="14 2 14 8 20 8"
                      - else
                        line x1="18" y1="20" x2="18" y2="10"
                        line x1="12" y1="20" x2="12" y2="4"
                        line x1="6" y1="20" x2="6" y2="14"
                  h3.fc-title = fc[:title]
                p.fc-desc = fc[:desc]

      .features-summary-banner
        .fsb-left
          p.fsb-lead
            span.text-brand Drafity
            |  なら、海外の検索アルゴリズムを味方につけたコンテンツ展開が可能です。
        .fsb-right
          - points = [{ icon: "clock", text: "Google / Baidu / Naverなど各国エンジンに対応" }, { icon: "trend", text: "直訳に頼らない、現地の検索意図に沿った構造化" }, { icon: "shield", text: "自然検索での確実な上位表示を狙える原稿制作" }]
          - points.each do |pt|
            .fsb-point-item
              .fsb-point-icon
                svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"
                  - if pt[:icon] == "clock"
                    circle cx="12" cy="12" r="10"
                    polyline points="12 6 12 12 16 14"
                  - elsif pt[:icon] == "trend"
                    polyline points="23 6 13.5 15.5 8.5 10.5 1 18"
                    polyline points="17 6 23 6 23 12"
                  - else
                    path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"
                    polyline points="9 12 11 14 15 10"
              .fsb-point-text = pt[:text]

  section.enterprise-agent-section#flow
    .ea-inner
      .ea-badge WORK FLOW
      h3.ea-title
        | 単なる翻訳ではなく、
        br
        | 「現地で検索される」コンテンツへ。
      p.ea-desc 韓国のNaver、中国のBaidu、英語圏のGoogleなど、国や地域によってアプローチすべきプラットフォームは全く異なります。ターゲット市場に合わせた最適な記事骨格の策定から現地語原稿の仕上げまで、トータルでサポートいたします。（※制作本数や施策範囲は事前に丁寧なヒアリングのうえ策定します）
      .ea-flow
        - steps = [{ num: "01", icon: "target", title: "ターゲット市場・言語の明確化", desc: "まずは進出を狙う国・地域および言語を特定。検索市場の特性や競合環境を分析し、最も効果的な戦略の軸を固めます。" }, { num: "02", icon: "pen", title: "検索エンジン別 記事骨格の設計", desc: "見出し構成、取り扱うトピック、情報の網羅性まで、現地の検索アルゴリズムが最も好む形にコンテンツの設計図を組み上げます。" }, { num: "03", icon: "layers", title: "即公開可能な現地語原稿の生成", desc: "現地ユーザーが違和感なく読み進められる自然な文章表現で、Webサイトにそのまま掲載できる高品質な原稿へ仕上げます。" }]
        - steps.each do |step|
          .ea-step
            .ea-step-top
              .ea-step-icon
                svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                  - if step[:icon] == "target"
                    circle cx="12" cy="12" r="10"
                    circle cx="12" cy="12" r="6"
                    circle cx="12" cy="12" r="2"
                  - elsif step[:icon] == "pen"
                    path d="M12 20h9"
                    path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"
                  - else
                    polygon points="12 2 2 7 12 12 22 7 12 2"
                    polyline points="2 17 12 22 22 17"
                    polyline points="2 12 12 17 22 12"
              .ea-step-num = step[:num]
            h4.ea-step-title = step[:title]
            p.ea-step-desc = step[:desc]

  section.pricing-section#pricing
    .pricing-inner
      .section-header
        span.overline PRICING
        h2.section-title 海外向けSEO記事生成を、わかりやすい月額定額で。
        p.section-sub 国別の検索エンジン構造にアジャストした現地語コンテンツを、そのまま公開・活用できるクオリティでご提供します。
      .pricing-solo
        .plan-card.popular.plan-card--solo
          .popular-badge 海外SEO支援
          .plan-solo-main
            .plan-name.accent Drafity
            .plan-desc 単なる翻訳にとどまらない、現地の検索エンジンに高く評価される構造化記事をスピーディーに生成・運用。
            .plan-price
              .plan-price-main
                span.price-yen ¥
                span.price-num 98,000
                span.price-unit
                  | / 月（税込）
              p.plan-price-note 記事の生成からWebサイトへの公開サポートまで一括対応
            = mail_to "info@j-work.jp", "このプランについて相談する", subject: "Drafityのご相談", class: "plan-cta filled"
          ul.plan-features
            - ["Google / Baidu / Naver等、主要検索エンジンに対応", "現地ユーザーの検索意図に即した記事構造の設計", "機械翻訳感のない、高品質な現地語原稿の生成", "そのままWebサイトに掲載できる状態までの仕上げ", "自然検索トラフィック（オーガニック流入）の獲得に特化"].each do |feature|
              li
                svg viewBox="0 0 16 16" fill="none"
                  path d="M3 8l3 3 7-7" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"
                = feature

  section.faq-section#faq
    .faq-inner
      .section-header
        span.overline FAQ
        h2.section-title よくあるご質問
        p.section-sub 海外向けSEO記事生成・運用に関して、お客様から多く寄せられる質問にお答えします。
      .faq-search
        input.faq-search__input type="search" placeholder="キーワードで検索（例：料金、公開、契約など）" data-faq-search=""
        svg.faq-search__icon viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
          circle cx="11" cy="11" r="8"
          line x1="21" y1="21" x2="16.65" y2="16.65"
      .faq-layout data-faq-root=""
        nav.faq-categories aria-label="FAQカテゴリ"
          h3 カテゴリ
          - faq_categories = [["service", "サービス・施策内容", "comments"], ["pricing", "料金・コスト", "yen"], ["usage", "運用・契約について", "chart"]]
          - faq_categories.each_with_index do |(key, label, icon_type), idx|
            button.faq-categories__btn type="button" class=("is-active" if idx.zero?) data-faq-category=key
              span.faq-cat-icon
                svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                  - if icon_type == "comments"
                    path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"
                  - elsif icon_type == "yen"
                    line x1="12" y1="2" x2="12" y2="22"
                    path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"
                  - else
                    line x1="18" y1="20" x2="18" y2="10"
                    line x1="12" y1="20" x2="12" y2="4"
                    line x1="6" y1="20" x2="6" y2="14"
              span = label
              svg.faq-cat-chevron viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
                polyline points="9 18 15 12 9 6"
        .faq-panel
          - faqs = [{ category: "service", q: "単なるアドバイスやコンサルティングのみのサービスですか？", a: "いいえ、分析やアドバイスにとどまらず、実際の原稿制作まで一貫して対応いたします。韓国のNaver、中国のBaidu、英語圏のGoogleなど、対象国の主要検索エンジンに最適化した現地語記事を生成し、そのままWebサイトに公開できる状態でお納めします。" }, { category: "service", q: "対応可能な国や言語に制限はありますか？", a: "特別な制限はございません。英語圏・中国・韓国・ドイツなどをはじめ、貴社の海外進出戦略に合わせた柔軟な対応が可能です。施策をスタートする対象国や言語は事前ヒアリングにて決定いたします。" }, { category: "pricing", q: "利用料金はいくらですか？", a: "月額98,000円（税込）となります。検索エンジン構造に合わせた現地語記事の生成代行から、Webサイトへの公開サポートまでが含まれます。（※広告運用費や、別個の特注制作費は含まれません）" }, { category: "pricing", q: "毎月作成できる記事の本数は決まっていますか？", a: "一律で固定本数を指定するプランではございません。進出市場の規模やキーワードの難易度、推奨される更新頻度を踏まえ、事前のお打ち合わせにて最適な年間・月間の公開ペースを策定いたします。" }, { category: "usage", q: "自社WebサイトやCMSへの直接入稿・公開作業も依頼できますか？", a: "はい、対応可能です。対象WebサイトのCMS（WordPress等）や更新権限を事前に共有いただくことで、入稿作業まで代行いたします。もちろん、テキスト・HTML原稿での納品にも対応しております。" }, { category: "usage", q: "途中で契約を解除することは可能ですか？", a: "契約期間および解約に関する規定につきましては、ご契約前に書面にて明瞭にご案内いたします。案件ごとの状況に応じて柔軟に対応しておりますので、お気軽にご相談ください。" }]
          - faqs.each_with_index do |item, idx|
