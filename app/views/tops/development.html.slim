  section.consult-section#consult
    .consult-inner
      .section-header
        span.overline CONSULT
        h2.section-title 開発のご相談・お問い合わせ
        p.section-sub 最適な開発範囲と月額費用をご案内するため、作りたいものや現在の状況をお聞かせください。ご入力いただいたメールアドレス宛に返信いたします。
      - if params[:sent] == "1"
        p.consult-success role="status" お問い合わせを受け付けました。内容を確認のうえ、ご入力いただいたメールアドレス宛にご連絡いたします。
      = form_with model: @inquiry, url: development_inquiry_path, scope: :inquiry, method: :post, local: true, class: "consult-form" do |f|
        - if @inquiry.errors.any?
          .consult-errors role="alert"
            p 入力内容に不備があります。ご確認のうえ再度お試しください。
            ul
              - @inquiry.errors.full_messages.each do |msg|
                li = msg
        .consult-honeypot aria-hidden="true"
          = label_tag :company_website, "会社サイト"
          = text_field_tag :company_website, nil, tabindex: -1, autocomplete: "off"
        .consult-grid
          .consult-field
            = f.label :company, "会社名"
            = f.text_field :company, class: "consult-input", required: true, autocomplete: "organization"
          .consult-field
            = f.label :name, "担当者名"
            = f.text_field :name, class: "consult-input", required: true, autocomplete: "name"
          .consult-field
            = f.label :email, "メールアドレス"
            = f.email_field :email, class: "consult-input", required: true, autocomplete: "email"
          .consult-field
            = f.label :tel, "電話番号"
            = f.telephone_field :tel, class: "consult-input", autocomplete: "tel"
          .consult-field
            = f.label :system_type, "作りたいシステム"
            = f.select :system_type, DevelopmentInquiry::SYSTEM_TYPES, { include_blank: "選択してください" }, class: "consult-input", required: true
          .consult-field
            = f.label :audience, "主な利用者"
            = f.select :audience, DevelopmentInquiry::AUDIENCES, { include_blank: "選択してください" }, class: "consult-input", required: true
          .consult-field.consult-field--full
            = f.label :situation, "今の状態"
            = f.select :situation, DevelopmentInquiry::SITUATIONS, { include_blank: "選択してください" }, class: "consult-input", required: true
          .consult-field.consult-field--full
            = f.label :message, "開発してほしい内容"
            = f.text_area :message, class: "consult-input", rows: 6, required: true, placeholder: "例：営業が顧客ごとの対応状況を同じ画面で見る。顧客一覧、対応履歴、通知が必要"
        = f.submit "相談内容を送信する", class: "btn-primary-lg consult-submit"
      - if @inquiry.errors.any?
        script
          | document.getElementById("consult").scrollIntoView();

