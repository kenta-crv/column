      .section-header
        span.overline FLOW
        h2.section-title 導入の流れ
        p.section-sub ご相談から公開、その後の保守まで同じチームが一貫して担当します。月額費用は開発範囲を確認したうえでご提示します。
      .features-scroll-wrap
        button.features-scroll-btn.features-scroll-prev type="button" aria-label="前へ" onclick="scrollLpCards('#flow .features-grid', -1)"
          svg viewBox="0 0 24 24" fill="none"
            path d="M15 6l-6 6 6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
        .features-grid
          - flows = [{ num: "01", icon: "pen", title: "フォームから相談を送る", desc: "作りたいシステムの概要や利用シーン、現在の課題などを本ページのフォームからお送りください。" }, { num: "02", icon: "target", title: "要件と月額費用をご案内", desc: "開発する機能、月額料金、保守の範囲を書面でご提示します。月額外となる作業もこの段階で明確に切り分けます。" }, { num: "03", icon: "layout", title: "合意のうえ開発スタート", desc: "内容にご納得いただいてから着手します。実際の画面をご確認いただきながら、細部を仕上げていきます。" }, { num: "04", icon: "monitor", title: "貴社システムとして公開", desc: "完成したシステムを、貴社のサービスまたは社内システムとして本番環境へ公開します。" }, { num: "05", icon: "users", title: "現場での運用開始", desc: "お客様や社内メンバーがスムーズに使い始められるよう、公開時に必要な操作説明も行います。" }, { num: "06", icon: "shield", title: "月額内で保守・運用を継続", desc: "公開後の稼働維持や不具合への対応など、安心して使い続けるための保守を月額内で継続します。" }]
          - flows.each do |item|
            article.feature-card
