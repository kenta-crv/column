javascript:
  const prices = {
    starter: { monthly: 3000, annual: 2400 },
    biz: { monthly: 9000, annual: 7200 }
  };
  let isAnnual = true;

  function setToggle(annual, btn) {
    isAnnual = annual;
    document.querySelectorAll('.toggle-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    updatePrices();
  }

  function updatePrices() {
    const s = prices.starter;
    const b = prices.biz;
    if (isAnnual) {
      document.getElementById('starter-price').textContent = s.annual.toLocaleString();
      document.getElementById('starter-orig').style.display = 'block';
      document.getElementById('starter-note').textContent = '年額払いで20%お得';
      document.getElementById('biz-price').textContent = b.annual.toLocaleString();
      document.getElementById('biz-orig').style.display = 'block';
      document.getElementById('biz-note').textContent = '年額払いで20%お得';
    } else {
      document.getElementById('starter-price').textContent = s.monthly.toLocaleString();
      document.getElementById('starter-orig').style.display = 'none';
      document.getElementById('starter-note').textContent = '';
      document.getElementById('biz-price').textContent = b.monthly.toLocaleString();
      document.getElementById('biz-orig').style.display = 'none';
      document.getElementById('biz-note').textContent = '';
    }
  }

  document.querySelectorAll('a[href^="#"]').forEach(a => {
    a.addEventListener('click', e => {
      const id = a.getAttribute('href').slice(1);
      if (!id) return;
      const el = document.getElementById(id);
      if (!el) return;
      e.preventDefault();
      window.scrollTo({ top: el.offsetTop - 72, behavior: 'smooth' });
    });
  });