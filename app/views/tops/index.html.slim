  /-- ENTERPRISE AGENT --
  section.enterprise-agent-section
    .ea-inner
      .ea-badge 自律型AIエージェント
      h3.ea-title
        | プロンプトは最小限に。
        br
        | 「AIが主体的に動く」次の時代へ。
      p.ea-desc
        | Enterpriseプランでは、AIが自律的にピラータイトル・本文、そして関連するクラスタータイトル・本文までを思考し一連の流れを完全自動生成。
        br
        | PCやブラウザを閉じている間も裏側でタスクが進行し、完了状況はメールやSMSでリアルタイムに通知されます。

  /-- PRICING --
  section.pricing-section#pricing
    .pricing-inner
      .section-header
        span.overline シンプルでわかりやすい料金プラン
        h2.section-title あなたのビジネスに最適なプランを。
        p.section-sub
          | 個人利用からチーム・企業利用まで、目的や規模に合わせて選べる料金プランをご用意しています。
          br
          | すべてのプランに、AIによる高品質な記事作成を体験できます。
      .toggle-wrap
        button.toggle-btn.active onclick="setToggle(false,this)" 月額払い
        button.toggle-btn onclick="setToggle(true,this)"
          | 年額払い
          span.toggle-save 20%お得
      .pricing-scroll-wrap
        button.pricing-scroll-btn.pricing-scroll-prev type="button" aria-label="前のプラン" onclick="scrollPricing(-1)"
          svg viewBox="0 0 24 24" fill="none"
            path d="M15 6l-6 6 6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
        .pricing-grid
          - Subscription.lp_plans.each do |plan|
            - card_classes = [("popular" if plan[:popular]), ("featured" if plan[:featured])].compact.join(" ")
            - cta_class = plan[:popular] ? "filled" : (plan[:featured] ? "featured-cta" : "outline")
            .plan-card class=card_classes data-plan-key=plan[:key] data-monthly=plan[:monthly_price] data-yearly=plan[:yearly_price]
              - if plan[:popular]
                .popular-badge 人気 No.1
              - elsif plan[:featured]
                .featured-badge イチオシ
              .plan-name class=(plan[:popular] ? "accent" : (plan[:featured] ? "featured-name" : "")) = plan[:name]
              .plan-desc = plan[:description]
              .plan-price
                - if plan[:monthly_price] && plan[:yearly_price] && plan[:monthly_price] > 0
                  .plan-price-orig id="#{plan[:key]}-orig" style="display:none" = "¥#{plan[:monthly_price].to_s.gsub(/(\d)(?=\d{3})/, '\\1')}/月"
                .plan-price-main
                  span.price-yen ¥
                  span.price-num id="#{plan[:key]}-price" = plan[:monthly_price].to_s.gsub(/(\d)(?=\d{3})/, '\\1')
                  span.price-unit "/ 月"
              .plan-price-note id="#{plan[:key]}-note"
                - if plan[:key] == :trial
                  = plan[:note]
                - else
                  | ¥#{plan[:monthly_price].to_s.gsub(/(\d)(?=\d{3})/, '\\1')}/月（月額払い）
              = link_to plan[:cta_text], "/clients/sign_up", class: "plan-cta #{cta_class}"
              hr.plan-divider
              ul.plan-features
                - plan[:features].each do |feature|
                  li
                    svg viewBox="0 0 16 16" fill="none"
                      path d="M3 8l3 3 7-7" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"
                    = feature
        button.pricing-scroll-btn.pricing-scroll-next type="button" aria-label="次のプラン" onclick="scrollPricing(1)"
          svg viewBox="0 0 24 24" fill="none"
            path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"

      /-- shared features --
      .shared-features
        .shared-title すべてのプランに共通の安心機能
        .shared-grid
          .shared-item
            .shared-icon
              svg viewBox="0 0 24 24" fill="none"
                path d="M12 3l7 4v5c0 4.4-3 8.5-7 9.5C8 20.5 5 16.4 5 12V7l7-4z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"
            .shared-item-title セキュリティ対策
            .shared-item-desc データは暗号化され安全に保護されます
          .shared-item
            .shared-icon
              svg viewBox="0 0 24 24" fill="none"
                circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.5"
                path d="M9 12l2 2 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"
            .shared-item-title 商用利用OK
            .shared-item-desc 作成した記事は自由に商用利用できます
          .shared-item
            .shared-icon
              svg viewBox="0 0 24 24" fill="none"
                path d="M8 7H5a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3M8 7V5a4 4 0 0 1 8 0v2M8 7h8" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"
            .shared-item-title 自動保存
            .shared-item-desc 編集内容は自動で保存されます
          .shared-item
            .shared-icon
              svg viewBox="0 0 24 24" fill="none"
                path d="M4 4v16h16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"
                path d="M4 16l4-4 4 4 6-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"
            .shared-item-title アップデート無償提供
            .shared-item-desc 新機能・改善はすべて無償でご利用可能

  /-- VOICES (TESTIMONIALS) --
  section.voices-section#cases
    .voices-inner
