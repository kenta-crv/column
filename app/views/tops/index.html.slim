.drafify-lp
  /-- NAV  --
  nav.nav
    .nav-inner
      = link_to "/"
        = image_tag "logo2.png", width: "150px"
      .nav-links
        a href="#features" 特徴
        a href="#features" 機能
        a.active href="#pricing" 料金プラン
        a href="#cases" 導入事例
        a href="#faq" よくある質問
      .nav-cta
        = link_to "ログイン", new_client_session_path, class: "btn-login"
