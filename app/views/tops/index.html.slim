  /-- PRICING --
  section.pricing-section#pricing
    .pricing-inner
      .section-header
        span.overline シンプルでわかりやすい料金プラン
        h2.section-title あなたのビジネスに最適なプランを。
        p.section-sub
          | 個人利用からチーム・企業利用まで、目的や規模に合わせて選べる料金プランをご用意しています。
          br
          | すべてのプランに、AIによる高品質な記事作成を体験できます。
      .toggle-wrap
        button.toggle-btn onclick="setToggle(false,this)" 月額払い
        button.toggle-btn.active onclick="setToggle(true,this)"
          | 年額払い
          span.toggle-save 20%お得
      .pricing-grid
        - pricing_plans = { \
            free: { \
              name: "フリー", \
              desc: "まずはAI記事作成を気軽に試したい方へ", \
              monthly_price: Subscription::PLAN_PRICES[:trial], \
              yearly_price: Subscription::PLAN_PRICES[:trial], \
              article_limit: Subscription::PLAN_DELIVERY_LIMITS[:trial], \
              note: "クレジットカード登録不要", \
              cta_text: "無料で始める →", \
              features: [ \
                "月間#{Subscription::PLAN_DELIVERY_LIMITS[:trial]}記事まで作成", \
                "AI記事生成（標準品質）", \
                "テンプレート5種類", \
                "SEOスコア分析（基本）", \
                "コピー＆チェック機能", \
                "メールサポート" \
              ] \
            }, \
            starter: { \
              name: "スターター", \
              desc: "個人ブロガーや小規模サイトの運営におすすめ", \
              monthly_price: Subscription::PLAN_PRICES[:starter], \
              yearly_price: (Subscription::PLAN_PRICES[:starter] * 0.8).to_i, \
              article_limit: Subscription::PLAN_DELIVERY_LIMITS[:starter], \
              note: "年額払いで20%お得", \
              cta_text: "7日間無料トライアル →", \
              features: [ \
                "月間#{Subscription::PLAN_DELIVERY_LIMITS[:starter]}記事まで作成", \
                "AI記事生成（高品質）", \
                "テンプレート20種類", \
                "SEOスコア分析（詳細）", \
                "コピー＆チェック機能", \
                "キーワード調査ツール", \
                "メールサポート" \
              ] \
            }, \
            business: { \
              name: "ビジネス", \
              desc: "複数メディアの運営やチーム利用に最適", \
              monthly_price: Subscription::PLAN_PRICES[:standard], \
              yearly_price: (Subscription::PLAN_PRICES[:standard] * 0.8).to_i, \
              article_limit: Subscription::PLAN_DELIVERY_LIMITS[:standard], \
              note: "年額払いで20%お得", \
              cta_text: "7日間無料トライアル →", \
              popular: true, \
              features: [ \
                "月間#{Subscription::PLAN_DELIVERY_LIMITS[:standard]}記事まで作成", \
                "AI記事生成（最高品質）", \
                "テンプレート無制限", \
                "SEOスコア分析（詳細）", \
                "キーワード調査ツール", \
                "AI自動リライト機能", \
                "チーム共有（最大5名）", \
                "優先サポート" \
              ] \
            }, \
            enterprise: { \
              name: "エンタープライズ", \
              desc: "大規模運用・カスタマイズが必要な企業様へ", \
              monthly_price: Subscription::PLAN_PRICES[:enterprise], \
              yearly_price: (Subscription::PLAN_PRICES[:enterprise] * 0.8).to_i, \
              article_limit: Subscription::PLAN_DELIVERY_LIMITS[:enterprise], \
              note: "年額払いで20%お得", \
              cta_text: "問い合わせる →", \
              features: [ \
                "月間#{Subscription::PLAN_DELIVERY_LIMITS[:enterprise]}記事まで作成", \
                "AI記事生成（最高品質）", \
                "テンプレート無制限", \
                "チーム共有 無制限", \
                "専任カスタマーサクセス", \
                "カスタム機能開発（応相談）", \
                "SLA保証・セキュリティ強化" \
              ] \
            } \
          }

        - pricing_plans.each do |plan_key, plan|
          .plan-card class=(plan[:popular] ? "popular" : "") data-plan-key=plan_key data-monthly=plan[:monthly_price] data-yearly=plan[:yearly_price]
            - if plan[:popular]
              .popular-badge 人気 No.1
            .plan-name class=(plan[:popular] ? "accent" : "") = plan[:name]
            .plan-desc = plan[:desc]
            .plan-price
              - if plan[:monthly_price] && plan[:yearly_price] && plan[:monthly_price] > 0
                .plan-price-orig id="#{plan_key}-orig" = "¥#{plan[:monthly_price].to_s.gsub(/(\d)(?=\d{3})/, '\\1')}/月"
              .plan-price-main
                span.price-yen ¥
                span.price-num id="#{plan_key}-price" = plan[:yearly_price].to_s.gsub(/(\d)(?=\d{3})/, '\\1')
                span.price-unit
                  | / 月
              .plan-price-note id="#{plan_key}-note" = plan[:note]
            a.plan-cta class=(plan[:popular] ? "filled" : "outline") href="#" = plan[:cta_text]
            hr.plan-divider
            ul.plan-features
              - plan[:features].each do |feature|
                li
                  svg viewBox="0 0 16 16" fill="none"
                    path d="M3 8l3 3 7-7" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"
                  = feature

