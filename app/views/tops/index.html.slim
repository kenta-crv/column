script
  | function setToggle(isYearly, btn) {
  |   document.querySelectorAll('.toggle-btn').forEach(b => b.classList.remove('active'));
  |   btn.classList.add('active');
  |   document.querySelectorAll('.plan-card').forEach(card => {
  |     const key     = card.dataset.planKey;
  |     const monthly = parseInt(card.dataset.monthly, 10);
  |     const yearly  = parseInt(card.dataset.yearly,  10);
  |     if (!key || isNaN(monthly)) return;
  |     const price   = isYearly ? yearly : monthly;
  |     const priceEl = card.querySelector('#' + key + '-price');
  |     const origEl  = card.querySelector('#' + key + '-orig');
  |     const noteEl  = card.querySelector('#' + key + '-note');
  |     if (priceEl) priceEl.textContent = price.toLocaleString('ja-JP');
  |     if (origEl) {
  |       origEl.style.display = (isYearly && monthly > yearly) ? '' : 'none';
  |     }
  |     if (noteEl) {
  |       if (isYearly) {
  |         noteEl.textContent = (key === 'trial') ? 'クレジットカード登録不要' : '年額払いで20%お得';
  |       } else {
  |         noteEl.textContent = (key === 'trial') ? 'クレジットカード登録不要' : '¥' + monthly.toLocaleString('ja-JP') + '/月（月額払い）';
  |       }
  |     }
  |   });
  | }
  | function scrollPricing(direction) {
  |   const grid = document.querySelector('.pricing-grid');
  |   if (!grid) return;
  |   const card = grid.querySelector('.plan-card');
  |   const step = card ? card.offsetWidth + 20 : 280;
  |   grid.scrollBy({ left: direction * step, behavior: 'smooth' });
  | }
  | function scrollLpCards(selector, direction) {
  |   const grid = document.querySelector(selector);
  |   if (!grid) return;
  |   const card = grid.querySelector('.problem-card-item, .feature-card, .concept-card');
  |   const gap = parseFloat(getComputedStyle(grid).gap) || 20;
  |   const step = card ? card.offsetWidth + gap : 280;
  |   grid.scrollBy({ left: direction * step, behavior: 'smooth' });
  | }
  | function scrollVoices(direction) {
  |   const viewport = document.getElementById('voices-viewport');
  |   if (!viewport) return;
  |   const grid = document.getElementById('voices-grid');
  |   const card = grid?.querySelector('.voice-card');
  |   const gap = parseFloat(getComputedStyle(grid || viewport).columnGap || getComputedStyle(grid || viewport).gap) || 20;
  |   const step = card ? card.offsetWidth + gap : 360;
  |   viewport.scrollBy({ left: direction * step, behavior: 'smooth' });
  | }
