- set_meta_tags title: t("drafity.lp.meta_title")
- set_meta_tags description: t("drafity.lp.meta_description")

.drafify-lp
  /-- NAV  --
  nav.nav
    .nav-inner
      = link_to locale_root_href
        = image_tag "logo2.png", width: "150px"
      .nav-links
        a href="#features" = t("drafity.lp.nav_features")
        a href="#features" = t("drafity.lp.nav_functions")
        a.active href="#pricing" = t("drafity.lp.nav_pricing")
        a href="#cases" = t("drafity.lp.nav_cases")
        a href="#faq" = t("drafity.lp.nav_faq")
        = link_to t("drafity.lp.nav_seo_checker"), (params[:locale].present? ? localized_seo_checker_path(locale: params[:locale]) : seo_checker_path)
        = link_to t("drafity.lp.nav_columns"), ai_article_columns_index_path
      .nav-cta
        = render "shared/lang_switch"
        = link_to t("drafity.lp.login"), new_client_session_path, class: "btn-login"
        = link_to t("drafity.lp.cta_start"), "/clients/sign_up", class: "btn-primary"
 
  /-- HERO --
  section.hero
    .hero-inner
      .hero-copy
        .hero-eyebrow
          span.eyebrow-badge = t("drafity.lp.hero_badge")
          span.eyebrow-text = t("drafity.lp.hero_eyebrow")
        h1.hero-title
          = t("drafity.lp.hero_title_1")
          br.pc-only
          span.num = t("drafity.lp.hero_title_2")
          = t("drafity.lp.hero_title_3")
        p.hero-desc = t("drafity.lp.hero_desc")

      .hero-visual
        = image_tag "hero-bg.webp", alt: t("drafity.lp.hero_image_alt"), class: "hero-img"

      .hero-cards
        .hero-checks
          - hero_checks = [t("drafity.lp.hero_check_1"), t("drafity.lp.hero_check_2"), t("drafity.lp.hero_check_3")]
          - hero_checks.each do |check|
            span.check-pill
              svg viewBox="0 0 14 14" fill="none"
                path d="M2.5 7l3 3 6-6" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"
              = check

      .hero-actions
        = link_to t("drafity.lp.hero_cta_trial"), "/clients/sign_up", class: "btn-primary-lg"
        a.btn-ghost.btn-purple href="#features" = t("drafity.lp.hero_cta_secondary")

  /-- TRUST --
  /.trust-bar
    .trust-inner
      p.trust-label 多くの企業・個人に選ばれています
      .trust-logos
        - trust_logos = ["CyberAgent.", "Money Forward", "UZUZ", "ferret One", "Lancers", "excite."]
        - trust_logos.each do |logo|
          span.trust-logo = logo


  section.whats-section
   .whats-inner
    .section-header
      span.overline = t("drafity.lp.whats_overline")
      h2.section-title
        = t("drafity.lp.whats_title")

    .whats-intro-block
      .whats-intro-left
        p.whats-lead-text
          = t("drafity.lp.whats_lead_1")
          br.pc-only
          = t("drafity.lp.whats_lead_2")
        
        .whats-features-row
          - lp_whats_features.each do |wf|
            .whats-feature-pill
              .wfp-icon class=wf[:class]
                svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"
                  - if wf[:class] == "icon-lightning"
                    polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"
                  - elsif wf[:class] == "icon-shield"
                    path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"
                  - elsif wf[:class] == "icon-growth"
                    line x1="18" y1="20" x2="18" y2="10"
                    line x1="12" y1="20" x2="12" y2="4"
                    line x1="6" y1="20" x2="6" y2="14"
              .wfp-body
                h4.wfp-title = wf[:title]
                p.wfp-desc = wf[:desc]

      .whats-intro-right
        .whats-mockup-container
          .whats-laptop-img
            = image_tag "whats.png"

              
  section.problem-section
   .problem-inner
    .section-header
      span.overline = t("drafity.lp.problem_overline")
      h2.section-title
        = t("drafity.lp.problem_title_1")
        span.text-highlight-blue = t("drafity.lp.problem_title_2")
        = t("drafity.lp.problem_title_3")
      .section-dots
        span
        span
        span

    .problem-scroll-wrap
      button.problem-scroll-btn.problem-scroll-prev type="button" aria-label=t("drafity.lp.prev") onclick="scrollLpCards('.problem-grid', -1)"
        svg viewBox="0 0 24 24" fill="none"
          path d="M15 6l-6 6 6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
      .problem-grid
        - lp_problems.each do |p|
          .problem-card-item
            .pci-meta
              .pci-visual-icon class=p[:icon_class]
                svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                  - if p[:icon_type] == "clock"
                    circle cx="12" cy="12" r="10"
                    polyline points="12 6 12 12 16 14"
                  - elsif p[:icon_type] == "search"
                    circle cx="11" cy="11" r="8"
                    line x1="21" y1="21" x2="16.65" y2="16.65"
                  - elsif p[:icon_type] == "chart"
                    line x1="18" y1="20" x2="18" y2="10"
                    line x1="12" y1="20" x2="12" y2="4"
                    line x1="6" y1="20" x2="6" y2="14"
                  - elsif p[:icon_type] == "analytics"
                    rect x="3" y="3" width="18" height="18" rx="2" ry="2"
                    path d="M7 11l3-3 4 4 3-3"
                  - elsif p[:icon_type] == "calc"
                    rect x="5" y="2" width="14" height="20" rx="2" ry="2"
                    line x1="8" y1="6" x2="16" y2="6"
                    line x1="16" y1="10" x2="16" y2="18"
                  - elsif p[:icon_type] == "bell"
                    path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"
                    path d="M13.73 21a2 2 0 0 1-3.46 0"
            .pci-content
              .pci-check-line
                span.pci-check-box
                p.pci-check-text == p[:text]
              p.pci-description = p[:desc]
      button.problem-scroll-btn.problem-scroll-next type="button" aria-label=t("drafity.lp.next") onclick="scrollLpCards('.problem-grid', 1)"
        svg viewBox="0 0 24 24" fill="none"
          path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"

    .solution-arrow
      svg viewBox="0 0 24 24" fill="currentColor"
        path d="M12 21l-12-18h24z"

    /-- Solution Banner Box --
    .solution-banner-box
      .sb-content-left
        .sb-headline-row
          span.sb-lead-text = t("drafity.lp.solution_lead")
          span.sb-badge-tag = t("drafity.lp.solution_badge")
        .sb-brand-row
          .sb-logo-mark
            svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
              path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"
              polyline points="14 2 14 8 20 8"
              line x1="16" y1="13" x2="8" y2="13"
              line x1="16" y1="17" x2="8" y2="17"
              polyline points="10 9 9 9 8 9"
          h3.sb-brand-name Drafity
          span.sb-suffix-text = t("drafity.lp.solution_all")
          span.sb-gradient-action = t("drafity.lp.solution_solve")
          span.sb-suffix-text = t("drafity.lp.solution_suffix")
      .sb-mockup-right
        .sb-dashboard-wrapper
          /img.sb-dashboard-img src=image_path('dashboard-preview.png') alt="Drafity Dashboard"
        .sb-deco-icon.deco-sparkle
          svg viewBox="0 0 24 24" fill="currentColor"
            path d="M12 0l3 9 9 3-9 3-3 9-3-9-9-3 9-3z"
        .sb-deco-icon.deco-chat
          svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
            path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"
        .sb-deco-icon.deco-chart
          svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"
            line x1="18" y1="20" x2="18" y2="10"
            line x1="12" y1="20" x2="12" y2="4"
            line x1="6" y1="20" x2="6" y2="14"


  section.concept-section
    /-- 背景の巨大な青・紫グラデーション帯
    .concept-ambient-background
    .concept-inner
      .concept-md
        .section-header
          span.overline = t("drafity.lp.concept_overline")
        h3.concept-sub-title
          = t("drafity.lp.concept_title_1")
          br.sp-only
          = t("drafity.lp.concept_title_q")
          span.text-gradient = t("drafity.lp.concept_title_2")
          = t("drafity.lp.concept_title_3")
        
        .concept-scroll-wrap
          button.concept-scroll-btn.concept-scroll-prev type="button" aria-label=t("drafity.lp.prev") onclick="scrollLpCards('.concept-grid', -1)"
            svg viewBox="0 0 24 24" fill="none"
              path d="M15 6l-6 6 6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
          .concept-grid
            - lp_concepts.each do |c|
              .concept-card
                .cc-header
                  .cc-num-badge = c[:num]
                  h4.cc-title = c[:title]
                .cc-body
                  p.cc-desc = c[:desc]
                .cc-illustration
                  = image_tag c[:img], alt: t("drafity.lp.concept_img_alt", title: c[:title]), class: "cc-img"
          button.concept-scroll-btn.concept-scroll-next type="button" aria-label=t("drafity.lp.next") onclick="scrollLpCards('.concept-grid', 1)"
            svg viewBox="0 0 24 24" fill="none"
              path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"


  section.features-strip#features
    .features-inner
      .section-header
        span.overline = t("drafity.lp.features_overline")
        h2.section-title
          = t("drafity.lp.features_title_1")
          span.text-brand Drafity
          = t("drafity.lp.features_title_2")
        p.section-sub = t("drafity.lp.features_sub")

      .features-scroll-wrap
        button.features-scroll-btn.features-scroll-prev type="button" aria-label=t("drafity.lp.prev") onclick="scrollLpCards('.features-grid', -1)"
          svg viewBox="0 0 24 24" fill="none"
            path d="M15 6l-6 6 6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
        .features-grid
          - lp_feature_cards.each do |fc|
            .feature-card
              .fc-top
                .fc-head-row
                  .fc-num = fc[:num]
                  .fc-icon
                    svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                      - if fc[:num] == "01"
                        circle cx="11" cy="11" r="8"
                        line x1="21" y1="21" x2="16.65" y2="16.65"
                      - elsif fc[:num] == "02"
                        path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"
                        polyline points="14 2 14 8 20 8"
                      - elsif fc[:num] == "03"
                        path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"
                      - elsif fc[:num] == "04"
                        rect x="3" y="3" width="18" height="18" rx="2" ry="2"
                        circle cx="8.5" cy="8.5" r="1.5"
                        polyline points="21 15 16 10 5 21"
                      - elsif fc[:num] == "05"
                        path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"
                        path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"
                      - else
                        path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"
                        polyline points="17 8 12 3 7 8"
                        line x1="12" y1="3" x2="12" y2="15"
                  h3.fc-title = fc[:title]
                p.fc-desc = fc[:desc]
              .fc-mockup
                - if fc[:num] == "01"
                  .mock-window
                    .mw-header = fc[:mock_header]
                    .mw-table
                      .mt-row.mt-head
                        span = fc[:kw_head][0]
                        span = fc[:kw_head][1]
                      - fc[:kw_rows].each do |row|
                        .mt-row
                          span = row[:kw]
                          span = row[:vol]
                          span.badge class=row[:b_class] = row[:b_text]
                - elsif fc[:num] == "02"
                  .mock-window
                    .mw-header = fc[:mock_header]
                    .mw-list
                      - fc[:headings].each do |h|
                        .ml-item
                          span.h2-tag H2
                          span.ml-text = h
                - elsif fc[:num] == "03"
                  .mock-window
                    .mw-toolbar
                      span B
                      span I
                      span U
                    .mw-editor-content
                      p = fc[:editor_p1]
                      p = fc[:editor_p2]
                - elsif fc[:num] == "04"
                  .mock-images
                    .mi-main
                      .mi-placeholder.ai-bg
                        span.ai-text AI
                    .mi-side
                      .mi-placeholder.ai-bg-small
                      .mi-placeholder.ai-bg-small
                      .mi-placeholder.ai-bg-small
                - elsif fc[:num] == "05"
                  .mock-window
                    .mw-header = fc[:mock_header]
                    .mw-check-list
                      - fc[:suggestions].each do |s|
                        .mc-item
                          svg viewBox="0 0 24 24" fill="none" stroke="#6366F1" stroke-width="3"
                            polyline points="20 6 9 17 4 12"
                          span = s
                - else
                  .mock-window.mw-center
                    .mw-text = fc[:wp_text]
                    .mw-progress
                      .mp-bar
                      span 100%
        button.features-scroll-btn.features-scroll-next type="button" aria-label=t("drafity.lp.next") onclick="scrollLpCards('.features-grid', 1)"
          svg viewBox="0 0 24 24" fill="none"
            path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"

      .features-summary-banner
        .fsb-left
          p.fsb-lead
            span.text-brand Drafity
            =< t("drafity.lp.features_summary")
        .fsb-right
          - lp_fsb_points.each do |pt|
            .fsb-point-item
              .fsb-point-icon
                svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"
                  - if pt[:icon_type] == "clock"
                    circle cx="12" cy="12" r="10"
                    polyline points="12 6 12 12 16 14"
                  - elsif pt[:icon_type] == "trend"
                    polyline points="23 6 13.5 15.5 8.5 10.5 1 18"
                    polyline points="17 6 23 6 23 12"
                  - elsif pt[:icon_type] == "shield"
                    path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"
                    polyline points="9 12 11 14 15 10"
                  - else
                    polyline points="23 6 13.5 15.5 8.5 10.5 1 18"
              .fsb-point-text = pt[:text]



  section.dashboard-section#dashboard
    .dashboard-inner
      .section-header
        span.overline = t("drafity.lp.dashboard_overline")
        h2.section-title
          = t("drafity.lp.dashboard_title_1")
          span.text-blue = t("drafity.lp.dashboard_title_2")
          = t("drafity.lp.dashboard_title_3")
        p.section-sub = t("drafity.lp.dashboard_sub")

      .dashboard-grid
        .dashboard-left-features
          - lp_dashboard_features.each do |df|
            .df-item
              .df-icon-wrap class=df[:class]
                svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                  - if df[:type] == "pie"
                    path d="M21.21 15.89A10 10 0 1 1 8 2.83"
                    path d="M22 12A10 10 0 0 0 12 2v10z"
                  - elsif df[:type] == "folder"
                    path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"
                  - elsif df[:type] == "filter"
                    polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"
                  - elsif df[:type] == "clock"
                    circle cx="12" cy="12" r="10"
                    polyline points="12 6 12 12 16 14"
              .df-content
                h3.df-label = df[:label]
                p.df-desc = df[:desc]

        .dashboard-right-mockup
          .mockup-container
            = image_tag "img_dashboard.png", alt: t("drafity.lp.dashboard_img_alt"), class: "dashboard-img"

      .dashboard-summary-banner
        .dsb-icon-wrap
          svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
            polygon points="12 2 2 7 12 12 22 7 12 2 12 2"
            polyline points="2 17 12 22 22 17"
            polyline points="2 12 12 17 22 12"
        p.dsb-text
          = t("drafity.lp.dashboard_summary_1")
          span = t("drafity.lp.dashboard_summary_2")

  /-- ENTERPRISE AGENT --
  section.enterprise-agent-section
    .ea-inner
      .ea-badge = t("drafity.lp.ea_badge")
      h3.ea-title
        = t("drafity.lp.ea_title_1")
        br
        = t("drafity.lp.ea_title_2")
      p.ea-desc = t("drafity.lp.ea_desc")

  /-- PRICING --
  section.pricing-section#pricing
    .pricing-inner
      .section-header
        span.overline = t("drafity.lp.pricing_overline")
        h2.section-title = t("drafity.lp.pricing_title")
        p.section-sub
          = t("drafity.lp.pricing_sub_1")
          br
          = t("drafity.lp.pricing_sub_2")
      .toggle-wrap
        button.toggle-btn.active onclick="setToggle(false,this)" = t("drafity.lp.pricing_monthly")
        button.toggle-btn onclick="setToggle(true,this)"
          = t("drafity.lp.pricing_yearly")
          span.toggle-save = t("drafity.lp.pricing_save")
      .pricing-scroll-wrap
        button.pricing-scroll-btn.pricing-scroll-prev type="button" aria-label=t("drafity.lp.pricing_prev") onclick="scrollPricing(-1)"
          svg viewBox="0 0 24 24" fill="none"
            path d="M15 6l-6 6 6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
        .pricing-grid
          - Subscription.lp_plans.each do |plan|
            - card_classes = [("popular" if plan[:popular]), ("featured" if plan[:featured])].compact.join(" ")
            - cta_class = plan[:popular] ? "filled" : (plan[:featured] ? "featured-cta" : "outline")
            .plan-card class=card_classes data-plan-key=plan[:key] data-monthly=plan[:monthly_price] data-yearly=plan[:yearly_price]
              - if plan[:popular]
                .popular-badge = t("drafity.lp.popular_badge")
              - elsif plan[:featured]
                .featured-badge = t("drafity.lp.featured_badge")
              .plan-name class=(plan[:popular] ? "accent" : (plan[:featured] ? "featured-name" : "")) = plan[:name]
              .plan-desc = plan[:description]
              .plan-price
                - if plan[:monthly_price] && plan[:yearly_price] && plan[:monthly_price] > 0
                  .plan-price-orig id="#{plan[:key]}-orig" style="display:none" = "¥#{plan[:monthly_price].to_s.gsub(/(\d)(?=\d{3})/, '\\1')}#{t('drafity.lp.price_unit')}"
                .plan-price-main
                  span.price-yen ¥
                  span.price-num id="#{plan[:key]}-price" = plan[:monthly_price].to_s.gsub(/(\d)(?=\d{3})/, '\\1')
                  span.price-unit = t("drafity.lp.price_unit")
              .plan-price-note id="#{plan[:key]}-note"
                - if plan[:key] == :trial
                  = plan[:note]
                - else
                  = t("drafity.lp.price_note_monthly", price: plan[:monthly_price].to_s.gsub(/(\d)(?=\d{3})/, '\1'))
              hr.plan-divider
              ul.plan-features
                - plan[:features].each do |feature|
                  li
                    svg viewBox="0 0 16 16" fill="none"
                      path d="M3 8l3 3 7-7" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"
                    = feature
              = link_to plan[:cta_text], "/clients/sign_up", class: "plan-cta #{cta_class}"
        button.pricing-scroll-btn.pricing-scroll-next type="button" aria-label=t("drafity.lp.pricing_next") onclick="scrollPricing(1)"
          svg viewBox="0 0 24 24" fill="none"
            path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"


  section.voices-section#cases
    .voices-inner
      .section-header
        span.overline USER REVIEW
        h2.section-title
          = t("drafity.lp.voices_title_1")
          span.text-accent = t("drafity.lp.voices_title_2")
          = t("drafity.lp.voices_title_3")
        p.section-sub = t("drafity.lp.voices_sub")

      .voices-slider-container
        button.slider-arrow.arrow-prev type="button" aria-label=t("drafity.lp.prev") onclick="scrollVoices(-1)"
          svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"
            polyline points="15 18 9 12 15 6"
        button.slider-arrow.arrow-next type="button" aria-label=t("drafity.lp.next") onclick="scrollVoices(1)"
          svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"
            polyline points="9 18 15 12 9 6"

        .voices-slider-viewport#voices-viewport
          .voices-grid#voices-grid
            - lp_voices.each do |v|
              .voice-card
                .vc-user-profile
                  .vu-avatar-wrap
                    .vu-avatar class=v[:avatar_class]
                  .vu-info
                    span.vu-badge class=v[:badge_class] = v[:badge_text]
                    h4.vu-name = v[:name]
                .vc-rating-row
                  .vc-stars = v[:stars]
                  span.vc-rating-num = v[:rating]
                .vc-quote-box
                  p.vc-quote-text = v[:quote]
                p.vc-body-text = v[:body]
                .vc-metrics-row
                  - v[:metrics].each do |m|
                    .vm-item
                      .vm-icon-wrap
                        svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
                          - if m[:type] == "clock"
                            circle cx="12" cy="12" r="10"
                            polyline points="12 6 12 12 16 14"
