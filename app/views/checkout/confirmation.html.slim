- plan_key = @plan_type.to_s.downcase
- plan_name = Subscription.display_name_for(plan_key)
- amount = plan_key == "trial" ? 0 : (Subscription::PLAN_PRICES[plan_key.to_sym] || 0)

.drafify-lp.checkout-confirmation-page data-turbo="false"
  .checkout-confirmation
    .checkout-confirmation__card
      .checkout-confirmation__hero
        .checkout-confirmation__icon-ring
          .checkout-confirmation__icon
            svg viewBox="0 0 24 24" fill="none" aria-hidden="true"
              path d="M12 3l7 4v5c0 4.2-2.9 8-7 9-4.1-1-7-4.8-7-9V7l7-4z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"
              path d="M9.5 12.2l1.8 1.8 3.7-3.9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
        h1.checkout-confirmation__title お支払い内容の確認
        p.checkout-confirmation__lead
          | 選択内容をご確認のうえ、決済へお進みください。

      - if plan_key == "trial"
        .checkout-confirmation__notice
          strong 無料トライアル
          | の期間は費用は発生しません。
          span.checkout-confirmation__notice-sub
            | 新規アカウントは#{Subscription::TRIAL_DAYS}日間の無料トライアルが利用できます。

      .checkout-confirmation__details
        .checkout-confirmation__detail
          .checkout-confirmation__detail-icon
            svg viewBox="0 0 24 24" fill="none" aria-hidden="true"
              path d="M4 6h16M4 12h16M4 18h10" stroke="currentColor" stroke-width="2" stroke-linecap="round"
          .checkout-confirmation__detail-body
            span.checkout-confirmation__detail-label 選択プラン
            strong.checkout-confirmation__detail-value = plan_name

        .checkout-confirmation__detail
          .checkout-confirmation__detail-icon
            svg viewBox="0 0 24 24" fill="none" aria-hidden="true"
              path d="M12 2v20M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
          .checkout-confirmation__detail-body
            span.checkout-confirmation__detail-label お支払い金額（税込）
            strong.checkout-confirmation__detail-value
              = plan_key == "trial" ? "¥0" : "¥#{number_with_delimiter(amount)}"

      = form_with url: checkout_create_path, method: :post, local: true, class: "checkout-confirmation__form" do |f|
        = hidden_field_tag :plan_type, @plan_type
        = f.submit (plan_key == "trial" ? "無料トライアルを開始" : "Stripeで決済へ進む"), class: "checkout-confirmation__btn"

      = link_to plans_path, class: "checkout-confirmation__back" do
        | ← プラン選択に戻る
