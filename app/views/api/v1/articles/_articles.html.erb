<div style="font-family: sans-serif; padding: 20px 0; color: #333; width: 100%; box-sizing: border-box;">
  <div style="display: flex; flex-wrap: wrap; gap: 24px; justify-content: flex-start; padding: 0; margin: 20px 0 0 0; list-style: none;">
    <% columns.each do |column| %>
      <article style="background: #fff; border: 1px solid #e0e0e0; border-radius: 8px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.06); margin-bottom: 20px; width: calc((100% - 48px) / 3); box-sizing: border-box; display: flex; flex-direction: column;">
        
        <div style="position: relative;">
          <% if column.file.present? %>
            <img src="http://localhost:3001<%= column.file.url %>" alt="<%= column.title %>" style="width: 100%; height: auto; display: block; border-bottom: 1px solid #e0e0e0;">
          <% else %>
            <div style="background: #eee; aspect-ratio: 16/9; display: flex; align-items: center; justify-content: center; color: #999; font-size: 0.9rem; border-radius: 8px 8px 0 0;">No Image</div>
          <% end %>
        </div>

        <div style="padding: 20px; flex-grow: 1; display: flex; flex-direction: column;">
          <h2 style="font-size: 1.25rem; margin: 0 0 12px 0; font-weight: bold; line-height: 1.4;">
            <a href="#article-<%= column.id %>" style="color: #007bff; text-decoration: none;"><%= column.title %></a>
          </h2>
          
          <% if column.description.present? %>
            <% 
              # 💡 データベース内で本文と混ざっているHTMLタグや改行コードを完全に除去
              clean_text = column.description.to_s.gsub(/<[^>]*>/, "").gsub(/\s+/, " ").strip
              # 💡 先頭の120文字だけを強制抽出して、本文の侵入を物理的に遮断
              short_desc = clean_text[0, 120]
              short_desc += "..." if clean_text.length > 120
            %>
            <p style="font-size: 0.9rem; color: #666; line-height: 1.6; margin-bottom: 12px;">
              <%= short_desc %>
            </p>
          <% end %>
          

          
          <% if column.keyword.present? %>
            <div style="margin-top: auto; padding-top: 10px; font-size: 0.85rem; color: #777;">
              <span style="font-weight: bold;">キーワード:</span> <%= column.keyword %>
            </div>
          <% end %>
          
          <div style="margin-top: 10px; font-size: 0.8rem; color: #999; display: flex; gap: 10px;">
            <span style="background: #e9ecef; padding: 2px 6px; border-radius: 4px;"><%= column.genre %></span>
            <% if column.sub_genre.present? %>
              <span style="background: #e9ecef; padding: 2px 6px; border-radius: 4px;"><%= column.sub_genre %></span>
            <% end %>
            <span><%= column.updated_at.strftime('%Y年%m月%d日') %></span>
          </div>
        </div>

      </article>
    <% end %>
  </div>
</div>