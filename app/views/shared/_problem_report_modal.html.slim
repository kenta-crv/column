- report_client = (client_signed_in? ? current_client : nil)
- report_problem = Problem.new(company: report_client&.company, email: report_client&.email)

#problem-report-modal.modal-overlay style="display: none;" role="dialog" aria-modal="true" aria-labelledby="problem-report-modal-title"
  .modal-content.problem-report-modal__content
    .modal-header
      h3#problem-report-modal-title = t("drafity.dashboard.problem.title")
      button.modal-close type="button" onclick="closeProblemReportModal()" aria-label=t("drafity.dashboard.problem.close") ✕
    .modal-body
      p.problem-report-modal__lead
        = t("drafity.dashboard.problem.lead")
      = form_with model: report_problem, url: problems_path, local: true, html: { id: "problem-report-form", class: "problem-report-modal__form", multipart: true } do |f|
        .form-group
          label for="problem_company"
            = t("drafity.dashboard.problem.company")
            span.problem-report-modal__required *
          = f.text_field :company, id: "problem_company", class: "form-control", placeholder: t("drafity.dashboard.problem.ph_company"), required: true
        .form-group
          label for="problem_email"
            = t("drafity.dashboard.problem.email")
            span.problem-report-modal__required *
          = f.email_field :email, id: "problem_email", class: "form-control", placeholder: "test@example.com", required: true
        .form-group
          label for="problem_photo"
            = t("drafity.dashboard.problem.image")
            span.problem-report-modal__optional = t("drafity.dashboard.common.optional")
          = f.file_field :photo, id: "problem_photo", class: "form-control", accept: "image/*"
          small.form-text = t("drafity.dashboard.problem.image_hint")
        .form-group
          label for="problem_body"
            = t("drafity.dashboard.problem.body")
            span.problem-report-modal__optional = t("drafity.dashboard.common.optional")
          = f.text_area :body, id: "problem_body", class: "form-control", rows: 5, placeholder: t("drafity.dashboard.problem.ph_body")
        .problem-report-modal__actions
          button.btn.btn-secondary type="button" onclick="closeProblemReportModal()"
            = t("drafity.dashboard.common.cancel")
          = f.submit t("drafity.dashboard.problem.submit"), class: "btn btn-primary problem-report-modal__submit"
