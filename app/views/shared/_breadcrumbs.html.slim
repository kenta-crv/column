- unless @_bc_pos_css
  - @_bc_pos_css = true
  style#breadcrumb-position-fix
    | nav.breadcrumbs,.breadcrumbs{position:absolute!important;top:12px!important;left:16px!important;right:auto!important;bottom:auto!important;z-index:50!important;display:inline-block!important;width:auto!important;max-width:calc(100% - 32px)!important;height:auto!important;margin:0!important;padding:0!important;font-size:14px!important;line-height:1.5!important;background:transparent!important;background-color:transparent!important;border:0!important;border-bottom:0!important;box-shadow:none!important;pointer-events:auto!important;color:#111!important;text-shadow:0 1px 2px rgba(255,255,255,.95),0 0 6px rgba(255,255,255,.85)}
    | .breadcrumbs a{color:#111!important;text-decoration:underline!important;text-underline-offset:2px!important;pointer-events:auto!important;background:transparent!important}
    | .breadcrumbs__current{background:transparent!important}
    | body{position:relative}

nav.breadcrumbs aria-label="パンくず"
  - breadcrumbs.each_with_index do |crumb, i|
    - is_last = (i == breadcrumbs.size - 1)
    - if !is_last && crumb[:path].present?
      = link_to crumb[:label].to_s, crumb[:path].to_s
    - else
      span.breadcrumbs__current = crumb[:label]
    - unless is_last
      |  /
