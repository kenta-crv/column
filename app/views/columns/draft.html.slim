- set_meta_tags noindex: true
.section-knowhow
  .container
    h1.section-title ドラフト・未完了記事一覧

    - if @columns.empty?
      .knowhow-empty-wrapper
        p 対象の記事はありません
    - else
      = form_with(url: bulk_update_drafts_columns_path, method: :post, local: true, data: { turbolinks: false }) do |form|
        = hidden_field_tag :redirect_context, "draft"
        
        .knowhow-action-bar
          = form.button name: "action_type", value: "approve_bulk", class: "btn-knowhow-bulk-gpt", data: { confirm: "選択された記事を承認して本文生成を開始しますか？" } do
            span ⚡
            span 選択をChat GPTに依頼
          = form.button name: "action_type", value: "delete_bulk", class: "btn-knowhow-bulk-delete", data: { confirm: "選択された記事を一括削除しますか？" } do
            span 選択を削除

        .knowhow-table-wrap
          table.knowhow-management-table
            thead
              tr
                th.text-center width="50"
                  = check_box_tag "select_all", "1", false, class: "knowhow-custom-checkbox", onclick: "toggleAll(this)"
                th width="60" id
                th width="80" parent
                th タイトル
                th ジャンル
                th 状態
                th 更新日
                th 操作
            tbody
              - @columns.each do |column|
                tr
                  td.text-center
                    = check_box_tag "column_ids[]", column.id, false, class: "knowhow-custom-checkbox column-checkbox"
                  td.knowhow-id-text = column.id
                  td.knowhow-id-text = column.parent_id.presence || "—"
                  td
                    strong.knowhow-article-title = column.title
                  td
                    span.knowhow-badge-genre = column.genre.presence || "—"
                  td
                    - if column.status == "draft"
                      span.knowhow-status-badge.knowhow-status-badge--pending 未承認
                    - elsif !column.generated_body?
                      span.knowhow-status-badge.knowhow-status-badge--missing 本文なし
                    - else
                      span.knowhow-status-badge.knowhow-status-badge--processing 生成中
                  td.knowhow-date-text = column.updated_at.in_time_zone.strftime("%Y/%m/%d")
                  td 
                    .knowhow-row-actions
                      = link_to approve_column_path(column), method: :patch, data: { turbolinks: false, confirm: "本文生成を開始しますか？（生成スタイル: #{generation_mode_label(column.generation_mode)}）" }, class: "knowhow-action-btn knowhow-action-btn--gpt", title: "ChatGPT依頼" do
                        span ⚡ GPT
                      = link_to edit_column_path(column), class: 'knowhow-action-btn knowhow-action-btn--edit', data: { turbo: false }, title: "編集" do
                        span 編集
                      = link_to column_path(column), method: :delete, data: { confirm: "削除しますか？" }, class: "knowhow-action-btn knowhow-action-btn--delete", title: "削除" do
                        span 削除

        - if @columns.respond_to?(:total_pages) && @columns.total_pages > 1
          .knowhow-pagination
            = paginate @columns

    javascript:
      function toggleAll(source) {
        const checkboxes = document.querySelectorAll('.column-checkbox');
        checkboxes.forEach(cb => cb.checked = source.checked);
      }
