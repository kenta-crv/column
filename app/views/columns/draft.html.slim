- set_meta_tags noindex: true
.section-knowhow
  .container
    h1.section-title = t("drafity.columns.draft.title")

    - if @columns.empty?
      .knowhow-empty-wrapper
        p = t("drafity.columns.draft.empty")
    - else
      = form_with(url: bulk_update_drafts_columns_path, method: :post, local: true, data: { turbolinks: false }) do |form|
        = hidden_field_tag :redirect_context, "draft"

        .knowhow-action-bar
          = form.button name: "action_type", value: "approve_bulk", class: "btn-knowhow-bulk-gpt", data: { confirm: t("drafity.columns.draft.approve_bulk_confirm") } do
            span ⚡
            span = t("drafity.columns.draft.approve_bulk")
          = form.button name: "action_type", value: "delete_bulk", class: "btn-knowhow-bulk-delete", data: { confirm: t("drafity.columns.draft.delete_bulk_confirm") } do
            span = t("drafity.columns.draft.delete_bulk")

        .knowhow-table-wrap
          table.knowhow-management-table
            thead
              tr
                th.text-center width="50"
                  = check_box_tag "select_all", "1", false, class: "knowhow-custom-checkbox", onclick: "toggleAll(this)"
                th width="60" id
                th width="80" parent
                th = t("drafity.columns.draft.th_title")
                th = t("drafity.columns.draft.th_genre")
                th = t("drafity.columns.draft.th_status")
                th = t("drafity.columns.draft.th_updated")
                th = t("drafity.columns.draft.th_actions")
            tbody
              - @columns.each do |column|
                tr
                  td.text-center
                    = check_box_tag "column_ids[]", column.id, false, class: "knowhow-custom-checkbox column-checkbox"
                  td.knowhow-id-text = column.id
                  td.knowhow-id-text = column.parent_id.presence || "—"
                  td
                    strong.knowhow-article-title = column.title
                  td
                    span.knowhow-badge-genre = column.genre.presence || "—"
                  td
                    - if column.status == "draft"
                      span.knowhow-status-badge.knowhow-status-badge--pending = t("drafity.columns.draft.status_pending")
                    - elsif !column.generated_body?
                      span.knowhow-status-badge.knowhow-status-badge--missing = t("drafity.columns.draft.status_no_body")
                    - else
                      span.knowhow-status-badge.knowhow-status-badge--processing = t("drafity.columns.draft.status_generating")
                  td.knowhow-date-text = column.updated_at.in_time_zone.strftime("%Y/%m/%d")
                  td
                    .knowhow-row-actions
                      = link_to approve_column_path(column), method: :patch, data: { turbolinks: false, confirm: t("drafity.columns.draft.action_gpt_confirm", mode: generation_mode_label(column.generation_mode)) }, class: "knowhow-action-btn knowhow-action-btn--gpt", title: t("drafity.columns.draft.action_gpt_title") do
                        span = "⚡ #{t("drafity.columns.draft.action_gpt")}"
                      = link_to edit_column_path(column), class: 'knowhow-action-btn knowhow-action-btn--edit', data: { turbo: false }, title: t("drafity.columns.draft.action_edit") do
                        span = t("drafity.columns.draft.action_edit")
                      = link_to column_path(column), method: :delete, data: { confirm: t("drafity.columns.draft.action_delete_confirm") }, class: "knowhow-action-btn knowhow-action-btn--delete", title: t("drafity.columns.draft.action_delete") do
                        span = t("drafity.columns.draft.action_delete")

        - if @columns.respond_to?(:total_pages) && @columns.total_pages > 1
          .knowhow-pagination
            = paginate @columns

    javascript:
      function toggleAll(source) {
        const checkboxes = document.querySelectorAll('.column-checkbox');
        checkboxes.forEach(cb => cb.checked = source.checked);
      }
