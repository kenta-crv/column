- set_meta_tags noindex: true
.tops-wrapper
  - if @column.article_type == "pillar" && can_manage_column?(@column)
    .pillar-children-edit-banner style="max-width: 960px; margin: 0 auto 20px; padding: 16px 20px; background: #f5f3ff; border: 1px solid #ddd6fe; border-radius: 8px; display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap;"
      div
        strong 子記事の作成・管理
        - quota = child_article_quota_for(@column)
        - if quota
          span style="margin-left: 8px; color: #5b21b6; font-size: 0.9rem;"
            | （#{quota[:used]}/#{quota[:limit]} 件、あと #{quota[:remaining]} 件作成可能）
      = link_to "子記事管理画面へ", pillar_manage_path(@column), class: "btn btn-primary btn-sm"
  = render 'form'
