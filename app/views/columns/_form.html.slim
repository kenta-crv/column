.section-knowhow
  .container
    h1.section-title
      | 新規記事作成

    = form_with model: @column, local: true, html: { multipart: true } do |f|
      .form-group
        = f.label :title, "タイトル"
        = f.text_field :title, class: "form-control"

      .form-group
        = f.label :code, "URL用英字コード（SEO用）"
        = f.text_field :code, class: "form-control", placeholder: "example-article-slug"

      .form-group
        = f.label :file, "画像"
        = f.file_field :file, accept: "image/*", class: "form-control"

      .form-group
        = f.label :description, "説明（概要）"
        = f.text_area :description, rows: 4, class: "form-control"

      .form-group
        = f.label :body, "本文"
        = f.text_area :body, rows: 12, class: "form-control"

      .form-group
        = f.label :genre, "ジャンル（大分類）"
        / GenreRegistry::GENRES のトップレベルの項目（ja）をそのまま大分類として表示します
        = f.select :genre,
          @column_form_genre_options,
          { include_blank: "選択してください" },
          { class: "form-control", id: "genre-select" }

      .form-group
        = f.label :sub_genre, "中分類（サブカテゴリ）"
        = f.select :sub_genre,
          [],
          { include_blank: "選択してください" },
          { class: "form-control", id: "sub-genre-select", disabled: true, data: { saved_value: @column&.sub_genre, master_data: @column_form_sub_categories_json } }

      .form-group
        = f.label :article_type, "タイプ"
        = f.select :article_type,
          [["親記事", "pillar"], ["子記事", "cluster"]],
          { include_blank: "選択してください", selected: @column.new_record? ? nil : @column.article_type },
          { class: "form-control" }

      .form-group
        = f.label :parent_id, "parent_id"
        = f.text_field :parent_id, class: "form-control"

      .form-group
        = f.label :prompt, "AI生成指示（任意・最優先）"
        = f.text_area :prompt, rows: 6, class: "form-control", placeholder: "この記事では○○について詳しく解説し、△△の読者を想定して〜のような構成で書いてほしい"

      .form-actions.mt-4
        = f.submit "保存する", class: "btn btn-primary"

javascript:
  (function() {
    const initGenreSelect = () => {
      const genreSelect = document.getElementById('genre-select');
      const subGenreSelect = document.getElementById('sub-genre-select');
      
      if (!genreSelect || !subGenreSelect) return;

      // HTMLのデータ属性からRails側で生成した最新の構造データを取得してパース
      const subCategories = JSON.parse(subGenreSelect.dataset.masterData || '{}');

      const updateSubGenre = (selectedGenre, initialValue = null) => {
        subGenreSelect.innerHTML = '';
        
        // 選択された大分類に紐づく中分類（sub_categories）が存在する場合のみ処理
        if (selectedGenre && subCategories[selectedGenre] && subCategories[selectedGenre].length > 0) {
          const defaultOption = document.createElement('option');
          defaultOption.value = "";
          defaultOption.textContent = "選択してください";
          subGenreSelect.appendChild(defaultOption);

          subCategories[selectedGenre].forEach(sub => {
            const option = document.createElement('option');
            option.value = sub.id;
            option.textContent = sub.name;
            
            if (initialValue && String(sub.id) === String(initialValue)) {
              option.selected = true;
            }
            subGenreSelect.appendChild(option);
          });
          subGenreSelect.disabled = false;
        } else {
          // 中分類（sub_categories）が元々定義されていないジャンルの場合
          const emptyOption = document.createElement('option');
          emptyOption.value = "";
          emptyOption.textContent = "中分類はありません";
          subGenreSelect.appendChild(emptyOption);
          subGenreSelect.disabled = true;
        }
      };

      // イベント設定
      genreSelect.onchange = (e) => updateSubGenre(e.target.value);
      
      // 初期表示時の実行（Edit画面やバリデーションエラー時の値保持対策）
      const savedSubGenre = subGenreSelect.dataset.savedValue || ""; 
      if (genreSelect.value) {
        updateSubGenre(genreSelect.value, savedSubGenre);
      }
    };

    // Turbo環境対応
    document.removeEventListener('turbo:load', initGenreSelect);
    document.addEventListener('turbo:load', initGenreSelect);
    initGenreSelect();
  })();