.section-knowhow
  .container
    h1.section-title
      = @column.persisted? ? t("drafity.columns.form.edit_title") : t("drafity.columns.form.new_title")

    = form_with model: @column, local: true, html: { multipart: true } do |f|
      .form-group
        = f.label :title, t("drafity.columns.form.title")
        = f.text_field :title, class: "form-control"

      .form-group
        = f.label :code, t("drafity.columns.form.code")
        = f.text_field :code, class: "form-control", placeholder: "example-article-slug"

      .form-group
        = f.label :file, t("drafity.columns.form.image")
        = f.file_field :file, accept: "image/*", class: "form-control"

      .form-group
        = f.label :description, t("drafity.columns.form.description")
        = f.text_area :description, rows: 4, class: "form-control"

      .form-group
        = f.label :body, t("drafity.columns.form.body")
        = f.text_area :body, rows: 12, class: "form-control"

      .form-group
        = f.label :genre, t("drafity.columns.form.genre")
        = f.select :genre,
          @column_form_genre_options,
          { include_blank: t("drafity.columns.form.select_please") },
          { class: "form-control", id: "genre-select" }

      .form-group
        = f.label :sub_genre, t("drafity.columns.form.sub_genre")
        = f.select :sub_genre,
          [],
          { include_blank: t("drafity.columns.form.select_please") },
          { class: "form-control", id: "sub-genre-select", disabled: true, data: { saved_value: @column&.sub_genre, master_data: @column_form_sub_categories_json, placeholder_select: t("drafity.columns.form.select_please"), placeholder_empty: t("drafity.columns.form.no_sub_genre") } }

      .form-group
        = f.label :article_type, t("drafity.columns.form.article_type")
        = f.select :article_type,
          [[t("drafity.columns.form.type_pillar"), "pillar"], [t("drafity.columns.form.type_cluster"), "cluster"]],
          { include_blank: t("drafity.columns.form.select_please"), selected: @column.new_record? ? nil : @column.article_type },
          { class: "form-control" }

      .form-group
        = f.label :generation_mode, t("drafity.columns.form.generation_mode")
        - include_internal_modes = acting_as_admin? && !Column.english_language?(@column.language.presence || default_article_language)
        - mode_options = generation_mode_options_for_select(include_internal: include_internal_modes)
        - current_mode = Column.normalize_generation_mode_for(@column.generation_mode, language: @column.language)
        - if include_internal_modes && !Column::PUBLIC_GENERATION_MODES.include?(current_mode) && mode_options.none? { |_, v| v == current_mode }
          - mode_options = mode_options + [[generation_mode_label(current_mode), current_mode]]
        = f.select :generation_mode,
          mode_options,
          { selected: current_mode },
          { class: "form-control", id: "column_generation_mode" }
        p.form-text.text-muted style="margin-top: 6px; font-size: 12px;"
          - if acting_as_admin?
            = t("drafity.columns.form.mode_hint_admin")
          - else
            = t("drafity.columns.form.mode_hint")

      - if acting_as_admin?
        .form-group#own-service-group data-internal-modes="note,qiita,zenn"
          = f.label :own_service_key, t("drafity.columns.form.own_service")
          = f.select :own_service_key,
            [["Meetia", "meetia"], ["Recrivo", "recrivo"], ["Okurite", "okurite"], ["Drafity", "drafity"]],
            { include_blank: t("drafity.columns.form.select_please"), selected: @column.own_service_key.presence || "drafity" },
            { class: "form-control", id: "column_own_service_key" }
          p.form-text.text-muted style="margin-top: 6px; font-size: 12px;"
            = t("drafity.columns.form.own_service_hint")

        .form-group#own-service-url-group
          = f.label :own_service_url, t("drafity.columns.form.own_service_url")
          = f.url_field :own_service_url,
            class: "form-control",
            id: "column_own_service_url",
            placeholder: t("drafity.columns.form.own_service_url_placeholder")
          p.form-text.text-muted style="margin-top: 6px; font-size: 12px;"
            = t("drafity.columns.form.own_service_url_hint")

      - parent_for_language = @column.parent.presence || (@column.parent_id.present? ? Column.find_by(id: @column.parent_id) : nil)
      .form-group
        = f.label :language, t("drafity.columns.form.language")
        - if parent_for_language
          = f.hidden_field :language, value: Column.normalize_language(parent_for_language.language)
          = f.select :language,
            article_language_options_for_select,
            { selected: Column.normalize_language(parent_for_language.language) },
            { class: "form-control", disabled: true }
          p.form-text.text-muted style="margin-top: 6px; font-size: 12px;"
            = t("drafity.columns.form.language_inherited")
        - else
          = f.select :language,
            article_language_options_for_select,
            { selected: Column.normalize_language(@column.language.presence || default_article_language) },
            { class: "form-control", id: "column_language" }
          p.form-text.text-muted style="margin-top: 6px; font-size: 12px;"
            = t("drafity.columns.form.language_hint")

      .form-group
        = f.label :parent_id, t("drafity.columns.form.parent_id")
        = f.text_field :parent_id, class: "form-control"

      .form-group
        = f.label :prompt, t("drafity.columns.form.prompt")
        = f.text_area :prompt, rows: 6, class: "form-control", placeholder: t("drafity.columns.form.prompt_placeholder")

      .form-actions.mt-4
        = f.submit t("drafity.columns.form.save"), class: "btn btn-primary"

javascript:
  (function() {
    const initGenreSelect = () => {
      const genreSelect = document.getElementById('genre-select');
      const subGenreSelect = document.getElementById('sub-genre-select');
      
      if (!genreSelect || !subGenreSelect) return;

      // HTMLのデータ属性からRails側で生成した最新の構造データを取得してパース
      const subCategories = JSON.parse(subGenreSelect.dataset.masterData || '{}');

      const updateSubGenre = (selectedGenre, initialValue = null) => {
        subGenreSelect.innerHTML = '';
        
        // 選択された大分類に紐づく中分類（sub_categories）が存在する場合のみ処理
        if (selectedGenre && subCategories[selectedGenre] && subCategories[selectedGenre].length > 0) {
          const defaultOption = document.createElement('option');
          defaultOption.value = "";
          defaultOption.textContent = subGenreSelect.dataset.placeholderSelect || "";
          subGenreSelect.appendChild(defaultOption);

          subCategories[selectedGenre].forEach(sub => {
            const option = document.createElement('option');
            option.value = sub.id;
            option.textContent = sub.name;
            
            if (initialValue && String(sub.id) === String(initialValue)) {
              option.selected = true;
            }
            subGenreSelect.appendChild(option);
          });
          subGenreSelect.disabled = false;
        } else {
          // 中分類（sub_categories）が元々定義されていないジャンルの場合
          const emptyOption = document.createElement('option');
          emptyOption.value = "";
          emptyOption.textContent = subGenreSelect.dataset.placeholderEmpty || "";
          subGenreSelect.appendChild(emptyOption);
          subGenreSelect.disabled = true;
        }
      };

      // イベント設定
      genreSelect.onchange = (e) => updateSubGenre(e.target.value);
      
      // 初期表示時の実行（Edit画面やバリデーションエラー時の値保持対策）
      const savedSubGenre = subGenreSelect.dataset.savedValue || ""; 
      if (genreSelect.value) {
        updateSubGenre(genreSelect.value, savedSubGenre);
      }
    };

    const initLanguageMode = () => {
      const languageSelect = document.getElementById('column_language');
      const modeSelect = document.getElementById('column_generation_mode');
      if (!languageSelect || !modeSelect) return;

      const internalModes = ['note', 'qiita', 'zenn'];
      const sync = () => {
        const isEn = languageSelect.value === 'en';
        internalModes.forEach((mode) => {
          const option = modeSelect.querySelector(`option[value="${mode}"]`);
          if (option) option.hidden = isEn;
        });
        if (isEn && internalModes.includes(modeSelect.value)) {
          modeSelect.value = 'default';
        }
      };

      languageSelect.addEventListener('change', sync);
      sync();
    };

    const initOwnServiceFields = () => {
      const modeSelect = document.getElementById('column_generation_mode');
      const ownServiceGroup = document.getElementById('own-service-group');
      const ownServiceUrlGroup = document.getElementById('own-service-url-group');
      const ownServiceSelect = document.getElementById('column_own_service_key');
      const ownServiceUrlInput = document.getElementById('column_own_service_url');
      if (!modeSelect || !ownServiceGroup || !ownServiceUrlGroup || !ownServiceSelect || !ownServiceUrlInput) return;

      const internalModes = ['note', 'qiita', 'zenn'];
      const urlByService = {
        meetia: 'https://meetia.pro',
        recrivo: 'https://recrivo.pro',
        okurite: 'https://okurite.pro',
        drafity: 'https://drafity.pro'
      };

      const syncVisibility = () => {
        const visible = internalModes.includes(modeSelect.value);
        ownServiceGroup.style.display = visible ? '' : 'none';
        ownServiceUrlGroup.style.display = visible ? '' : 'none';
      };

      const syncDefaultUrl = () => {
        if (ownServiceUrlInput.value.trim().length > 0) return;
        const mapped = urlByService[ownServiceSelect.value];
        if (mapped) ownServiceUrlInput.value = mapped;
      };

      modeSelect.addEventListener('change', syncVisibility);
      ownServiceSelect.addEventListener('change', syncDefaultUrl);
      syncVisibility();
      syncDefaultUrl();
    };

    // Turbolinks環境対応
    document.removeEventListener('turbolinks:load', initGenreSelect);
    document.addEventListener('turbolinks:load', initGenreSelect);
    document.removeEventListener('DOMContentLoaded', initGenreSelect);
    document.addEventListener('DOMContentLoaded', initGenreSelect);
    initGenreSelect();
    initLanguageMode();
    initOwnServiceFields();
  })();