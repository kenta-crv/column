- current_genre_key = params[:genre].presence
- service_name = current_genre_key ? GenreRegistry::GENRES.dig(current_genre_key.to_sym, :service_name) : nil

- set_meta_tags title: "【#{service_name}】記事一覧"
- set_meta_tags description: "#{service_name}の記事をご覧いただけます。"


- if admin_signed_in?
  .row.center style="margin-bottom: 20px;"
    .col-sm-4
      = link_to "ドラフト一覧を見る", draft_columns_path, class: "btn btn-secondary", data: { turbo: false }
    
    .col-sm-8.d-flex.justify-content-center style="gap: 10px;"
      = link_to "すべて表示", columns_path(genre: params[:genre]), 
                class: "btn #{params[:article_type].blank? ? 'btn-dark' : 'btn-outline-dark'}", 
                data: { turbo: false }
      = link_to "親記事(Pillar)", columns_path(article_type: 'pillar', genre: params[:genre]), 
                class: "btn #{params[:article_type] == 'pillar' ? 'btn-warning' : 'btn-outline-warning'}", 
                data: { turbo: false }
      = link_to "子記事(Child)", columns_path(article_type: 'child', genre: params[:genre]), 
                class: "btn #{params[:article_type] == 'child' ? 'btn-primary' : 'btn-outline-primary'}", 
                data: { turbo: false }

.section-knowhow.columns-index-page
  .container
    h1.section-title style="margin-top: 20px;"
      - if params[:article_type] == 'pillar'
        | 親記事（ピラー）一覧
      - elsif params[:article_type] == 'child'
        | 子記事（クラスター）一覧
      - else
        | 新着記事

    - if params[:article_type] == 'pillar'
      .genre-filter-wrapper style="margin-bottom: 20px;"
        form.filter-form action=columns_path method="get"
          = hidden_field_tag :article_type, 'pillar'
          = hidden_field_tag :genre, params[:genre] if params[:genre].present?
          label style="font-weight: bold; margin-right: 10px;" ジャンル絞り込み:
          select name="selected_genre" onchange="this.form.submit()" class="form-select d-inline-block" style="width: auto; max-width: 200px;"
            option value="" 全表示
            - @all_genres&.each do |g|
              option value=g selected=(params[:selected_genre] == g) = g.upcase
          noscript
            input type="submit" value="適用" class="btn btn-sm btn-secondary ms-2"

    - all_active_genres = ((@genre_pillar_counts&.keys || []) + (@genre_child_counts&.keys || [])).uniq.compact
    - if admin_signed_in?
      - if all_active_genres.present?
        .genre-summary-container
          .summary-title 【ジャンル別記事総数】
          .summary-grid
            - all_active_genres.each do |genre|
              .summary-item
                strong = genre.upcase
                span.summary-counts
                  = link_to columns_path(article_type: 'pillar', selected_genre: genre), class: "summary-count-link summary-count-link--pillar", data: { turbo: false } do
                    | Pillar: #{@genre_pillar_counts&.[](genre) || 0}
                  span.summary-count-separator /
                  = link_to columns_path(article_type: 'child', selected_genre: genre), class: "summary-count-link summary-count-link--cluster", data: { turbo: false } do
                    | Cluster: #{@genre_child_counts&.[](genre) || 0}

    - if params[:article_type] == 'pillar' && @grouped_columns.present?
      - @grouped_columns.each do |genre, columns|
        .genre-group style="margin-top: 30px;"
          .genre-header
            h2.genre-name = genre.upcase
            .genre-stats
              = link_to columns_path(article_type: 'pillar', selected_genre: genre), class: "columns-index-stat-badge columns-index-stat-badge--pillar", data: { turbo: false } do
                | Pillar: #{@genre_pillar_counts&.[](genre) || 0}
              = link_to columns_path(article_type: 'child', selected_genre: genre), class: "columns-index-stat-badge columns-index-stat-badge--cluster", data: { turbo: false } do
                | Cluster: #{@genre_child_counts&.[](genre) || 0}
          
          .columns-list
            - columns.each do |column|
              .row.pillar-article-item
                .col-12.col-md-3.thumb-container
                  - if column.file.present?
                    .thumb-wrapper style="position: relative; display: inline-block; width: 100%;"
                      = image_tag column.file.to_s, class: 'column-thumb', alt: column.title, style: "width: 100%; height: auto; border-radius: 8px;"
                      - if admin_signed_in?
                        = link_to '× 画像削除', remove_image_column_path(column), method: :patch, data: { confirm: 'この画像のみを削除しますか？', turbo: false }, class: 'btn btn-xs btn-danger', style: 'position: absolute; top: 5px; right: 5px; font-size: 0.7rem; padding: 2px 5px; opacity: 0.9; z-index: 10;'
                  - else
                    .no-image style="background:#eee; aspect-ratio:16/9; border-radius:8px; display:flex; align-items:center; justify-content:center; color:#999;" No Image
                
                .col-12.col-md-9.info-container
                  h3.column-title
                    - link_target = column.code.presence || column.id
                    = link_to column.title, column_path(link_target), data: { turbo: false }
                  
                  .column-meta
                    span.columns-index-meta-badge.columns-index-meta-badge--pillar
                      | Pillar (#{ @child_counts&.[](column.id) || 0 } 子記事)
                    span.columns-index-meta-date.update-date
                      | #{column.updated_at.in_time_zone.strftime("%Y/%m/%d %H:%M")}
                    - if admin_signed_in?
                      span.columns-index-meta-badge.columns-index-meta-badge--id ID: #{column.id}

                  - if admin_signed_in?
                    .admin-actions
                      = link_to '編集', edit_column_path(column), class: 'btn btn-sm btn-outline-secondary', data: { turbo: false }
                      = link_to '削除', column_path(column), method: :delete, data: { confirm: '本当に削除しますか？', turbo: false }, class: 'btn btn-sm btn-outline-danger'

    - else
      .columns-grid
        - if @columns.present?
          - @columns.each do |column|
            .column-card
              .column-image style="position: relative;"
                - if column.file.present?
                  = image_tag column.file.to_s, width: "100%", class: 'column-thumb', alt: column.title, style: "border-radius: 8px 8px 0 0;"
                  - if admin_signed_in?
                    = link_to '× 画像削除', remove_image_column_path(column), method: :patch, data: { confirm: 'この画像のみを削除しますか？', turbo: false }, class: 'btn btn-xs btn-danger', style: 'position: absolute; top: 5px; right: 5px; font-size: 0.7rem; padding: 2px 5px; opacity: 0.9; z-index: 10;'
                - else
                  .no-image style="background:#eee; aspect-ratio:16/9; border-radius:8px 8px 0 0; display:flex; align-items:center; justify-content:center; color:#999;" No Image
              .column-content
                h2.column-title
                  - link_target = column.code.presence || column.id
                  = link_to column.title, column_path(link_target), data: { turbo: false }
                .column-description
                  - if column.description.present?
                    = truncate(strip_tags(column.description), length: 120)
                    span.ms-1 style="color:#999; font-size:0.8rem;" （#{column.updated_at.in_time_zone.strftime("%Y/%m/%d")}）
                
                - if admin_signed_in?
                  .column-admin-links
                    span.columns-index-meta-badge.columns-index-meta-badge--genre = column.genre
                    - if column.article_type == "pillar"
                      span.columns-index-meta-badge.columns-index-meta-badge--pillar Pillar (#{ @child_counts&.[](column.id) || 0 })
                    - else
                      span.columns-index-meta-badge.columns-index-meta-badge--cluster Cluster
                    span.columns-index-meta-badge.columns-index-meta-badge--id ID: #{column.id}
                    = link_to '編集', edit_column_path(column), class: 'btn btn-sm btn-edit', data: { turbo: false }
                    = link_to '削除', column_path(column), method: :delete, data: { confirm: '本当に削除しますか？', turbo: false }, class: 'btn btn-sm btn-delete'
        - else
          .col-12.text-center.py-5 style="color: #666;"
            p 該当する記事が見つかりませんでした。

    / ページネーションコントロールの追加
    .pagination-wrapper style="margin-top: 40px; display: flex; justify-content: center;"
      = paginate @paginated_columns