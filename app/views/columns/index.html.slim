- current_genre_key = @current_genre_key.presence || params[:genre].presence
/ ai_sales_agent → meetia のような別名でもレジストリ本体から service_name を取る
- registry_genre_key = current_genre_key.present? ? GenreRegistry.canonical_key(current_genre_key) : nil
- service_name = registry_genre_key.present? ? GenreRegistry.genres.dig(registry_genre_key.to_sym, :service_name) : nil
- page_title = params[:article_type] == 'pillar' ? '親記事（ピラー）一覧' : (params[:article_type] == 'child' ? '子記事（クラスター）一覧' : '公開済み記事')
- empty_message = params[:article_type] == 'pillar' ? '親記事がありません。ダッシュボードから親記事を作成してください。' : (params[:article_type] == 'child' ? 'クラスター記事はありません。' : '公開済みの記事はありません。')

- set_meta_tags title: service_name.present? ? "【#{service_name}】記事一覧" : page_title
- index_description = begin
    key = registry_genre_key.presence || current_genre_key
    GenreRegistry.columns_index_description(key).presence
  end
- index_description ||= service_name.present? ? "#{service_name}のAI商談・営業自動化に関する解説記事一覧。導入手順、活用事例、運用のポイントをまとめています。" : "#{page_title}。導入・運用・事例のポイントをまとめています。"
- set_meta_tags description: index_description

- if @columns_manage_view
  .image-generation-page.columns-manage-page
    .dashboard-page-header
      h1 = page_title
      p.dashboard-page-subtitle
        - if params[:article_type] == 'pillar'
          | 親記事を選び、子記事タイトルの作成・管理を行います。
        - elsif params[:article_type] == 'child'
          | 本文が生成済みのクラスター記事一覧です。
        - else
          | 公開済み（本文あり）の記事一覧です。

    - if @current_genre_key.present?
      .columns-manage-tabs
        = link_to "公開済み", public_columns_index_path(genre: @current_genre_key),
                  class: "btn btn-sm #{params[:article_type].blank? ? 'btn-dark' : 'btn-outline-dark'}",
                  data: { turbo: false }
        = link_to "親記事", public_columns_index_path(genre: @current_genre_key, article_type: 'pillar'),
                  class: "btn btn-sm #{params[:article_type] == 'pillar' ? 'btn-warning' : 'btn-outline-warning'}",
                  data: { turbo: false }
        = link_to "クラスター", public_columns_index_path(genre: @current_genre_key, article_type: 'child'),
                  class: "btn btn-sm #{params[:article_type] == 'child' ? 'btn-primary' : 'btn-outline-primary'}",
                  data: { turbo: false }
    - else
      .columns-manage-tabs
        = link_to "公開済み", columns_path,
                  class: "btn btn-sm #{params[:article_type].blank? ? 'btn-dark' : 'btn-outline-dark'}",
                  data: { turbo: false }
        = link_to "親記事", columns_path(article_type: 'pillar'),
                  class: "btn btn-sm #{params[:article_type] == 'pillar' ? 'btn-warning' : 'btn-outline-warning'}",
                  data: { turbo: false }
        = link_to "クラスター", columns_path(article_type: 'child'),
                  class: "btn btn-sm #{params[:article_type] == 'child' ? 'btn-primary' : 'btn-outline-primary'}",
                  data: { turbo: false }

    .image-generation-list-panel
      .image-generation-list-header
        h3 = page_title
        span.image-generation-list-count = "#{@paginated_columns&.total_count || 0}件"

      - if @columns.present?
        .table-wrap
          table.rich-dashboard-table
            thead
              tr
                th タイトル
                th ジャンル
                - if params[:article_type] == "pillar"
                  th 子記事
                - else
                  th タイプ
                th 更新日時
            tbody
              - @columns.each do |column|
                tr
                  td
                    = link_to column.title, public_column_show_path(column), class: "article-link", data: { turbo: false }
                  td = column.genre.presence || "—"
                  - if params[:article_type] == "pillar"
                    td = "#{@child_counts&.[](column.id) || 0} 件"
                  - else
                    td
                      - if column.article_type == "pillar"
                        | 親記事
                      - else
                        | クラスター
                  td.date-text = column.updated_at.in_time_zone.strftime("%Y/%m/%d %H:%M")

        .table-footer-pagination
          .pagination-nav
            = paginate @paginated_columns
      - else
        p.image-generation-empty = empty_message
        - if @current_genre_key.blank?
          p.image-generation-empty
            = link_to "サービス・ジャンル管理へ", dashboard_service_genres_path

    .dashboard-back-link
      = link_to "← Dashboardに戻る", dashboard_root_path

- else
  .section-knowhow.columns-index-page
    .container
      h1.section-title style="margin-top: 20px;"
        = page_title

      - if params[:article_type] == 'pillar' && @current_genre_key.present?
        .genre-filter-wrapper style="margin-bottom: 20px;"
          form.filter-form action=columns_index_path(genre: @current_genre_key) method="get"
            = hidden_field_tag :article_type, 'pillar'
            label style="font-weight: bold; margin-right: 10px;" ジャンル絞り込み:
            select name="selected_genre" onchange="this.form.submit()" class="form-select d-inline-block" style="width: auto; max-width: 200px;"
              option value="" 全表示
              - @all_genres&.each do |g|
                option value=g selected=(params[:selected_genre] == g) = g.upcase

      - if params[:article_type] == 'pillar' && @grouped_columns.present?
        - @grouped_columns.each do |genre, columns|
          .genre-group style="margin-top: 30px;"
            h2.genre-name = genre.upcase
            .columns-list
              - columns.each do |column|
                .row.pillar-article-item
                  .col-12.col-md-9.info-container
                    h3.column-title
                      = link_to column.title, public_column_show_path(column), data: { turbo: false }

      - elsif @columns.present?
        .columns-grid
          - @columns.each do |column|
            .column-card
              .column-content
                h2.column-title
                  = link_to column.title, public_column_show_path(column), data: { turbo: false }
      - else
        p.image-generation-empty = empty_message

      .pagination-wrapper
        - if @columns.present?
          = paginate @paginated_columns
