- set_meta_tags title: "#{@column&.genre}のColumn記事一覧"
- set_meta_tags description: "#{@column&.genre}のColumn記事をご覧いただけます。"

- if admin_signed_in?
  .row.center style="margin-bottom: 20px;"
    .col-sm-4
      = link_to "ドラフト一覧を見る", draft_columns_path, class: "btn btn-secondary", data: { turbo: false }
    
    .col-sm-8 style="display: flex; gap: 10px; justify-content: center;"
      = link_to "すべて表示", columns_path(genre: params[:genre]), 
                class: "btn #{params[:article_type].blank? ? 'btn-dark' : 'btn-outline-dark'}", 
                data: { turbo: false }
      = link_to "親記事(Pillar)", columns_path(article_type: 'pillar', genre: params[:genre]), 
                class: "btn #{params[:article_type] == 'pillar' ? 'btn-warning' : 'btn-outline-warning'}", 
                data: { turbo: false }
      = link_to "子記事(Child)", columns_path(article_type: 'child', genre: params[:genre]), 
                class: "btn #{params[:article_type] == 'child' ? 'btn-primary' : 'btn-outline-primary'}", 
                data: { turbo: false }

.section-knowhow
  .container
    h1.section-title
      - if params[:article_type] == 'pillar'
        | 親記事（ピラー）一覧
      - elsif params[:article_type] == 'child'
        | 子記事（クラスター）一覧
      - else
        | 新着記事

    - if params[:article_type] == 'pillar'
      .genre-filter style="margin-bottom: 30px; text-align: center; background: #f8f9fa; padding: 20px; border-radius: 8px;"
        form action=columns_path method="get" style="display: inline-flex; align-items: center; gap: 10px;"
          = hidden_field_tag :article_type, 'pillar'
          = hidden_field_tag :genre, params[:genre] if params[:genre].present?
          label style="font-weight: bold;" ジャンル絞り込み:
          select name="selected_genre" onchange="this.form.submit()" class="form-select" style="width: auto; display: inline-block;"
            option value="" 全表示
            - @all_genres&.each do |g|
              option value=g selected=(params[:selected_genre] == g) = g.upcase
          noscript
            input type="submit" value="適用" class="btn btn-sm btn-secondary"

    - if params[:article_type] == 'pillar' && @grouped_columns.present?
      - @grouped_columns.each do |genre, columns|
        .genre-group style="margin-bottom: 40px;"
          h2.genre-title style="border-bottom: 2px solid #333; padding-bottom: 10px; margin-bottom: 20px; font-weight: bold;"
            = genre.upcase
          
          .columns-list
            - columns.each do |column|
              / rowクラスでラップし、paddingとborderを直接付与
              .row style="margin: 0; padding: 15px 0; border-bottom: 1px solid #eee; background: #fff; align-items: center;"
                / スマホで12列(100%)、PCで2列分
                .col-12.col-md-2 style="margin-bottom: 15px; margin-bottom: 0px;"
                  - if column.file.present?
                    = image_tag column.file.to_s, style: "width: 100%; height: auto; object-fit: cover;", class: 'column-thumb', alt: column.title
                
                / スマホで12列(100%)、PCで10列分
                .col-12.col-md-10
                  h3.column-title style="margin: 0 0 8px 0; font-size: 1.25rem;"
                    - link_target = column.code.presence || column.id
                    = link_to column.title, column_path(link_target), data: { turbo: false }
                  
                  .column-meta style="font-size: 0.9rem; color: #666; display: flex; flex-wrap: wrap; align-items: center; gap: 15px;"
                    span.badge.bg-warning style="color: #000;"
                      | Pillar (#{ @child_counts[column.id] || 0 } 子記事)
                    span
                      | 更新日: #{column.updated_at.in_time_zone.strftime("%Y/%m/%d %H:%M")}
                    - if admin_signed_in?
                      span.badge.bg-outline-secondary style="color: #999; border: 1px solid #ddd;" ID: #{column.id}

                  - if admin_signed_in?
                    .column-admin-actions style="margin-top: 15px; display: flex; gap: 8px;"
                      = link_to '編集', edit_column_path(column), class: 'btn btn-sm btn-outline-secondary', data: { turbo: false }
                      = link_to '削除', column_path(column), method: :delete, data: { confirm: '本当に削除しますか？', turbo: false }, class: 'btn btn-sm btn-outline-danger'

    - else
      .columns-grid
        - @columns.presence&.each do |column|
          .column-card
            .column-image
              - if column.file.present?
                = image_tag column.file.to_s, width: "100%", class: 'column-thumb', alt: column.title
            .column-content
              h2.column-title
                - link_target = column.code.presence || column.id
                = link_to column.title, column_path(link_target), data: { turbo: false }
              .column-description
                - if column.description.present?
                  = truncate(strip_tags(column.description), length: 120)
                  | （更新日: #{column.updated_at.in_time_zone.strftime("%Y/%m/%d %H:%M")}）
              
              - if admin_signed_in?
                .column-admin-links style="margin-top: 10px; display: flex; flex-wrap: wrap; gap: 5px; align-items: center;"
                  span.badge.bg-info = column.genre
                  - if column.article_type == "pillar"
                    span.badge.bg-warning Pillar (#{ @child_counts[column.id] || 0 } 子記事)
                  - else
                    span.badge.bg-primary Child
                  span.btn.btn-outline-secondary.btn-sm style="pointer-events: none;" ID: #{column.id}
                  = link_to '編集', edit_column_path(column), class: 'btn btn-sm btn-edit', data: { turbo: false }
                  = link_to '削除', column_path(column), method: :delete, data: { confirm: '本当に削除しますか？', turbo: false }, class: 'btn btn-sm btn-delete'