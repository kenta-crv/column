- current_genre_key = @current_genre_key.presence || params[:genre].presence
/ meetia → ai_sales_agent のような旧キーでもレジストリ本体から service_name を取る
- registry_genre_key = current_genre_key.present? ? GenreRegistry.canonical_key(current_genre_key) : nil
- service_name = registry_genre_key.present? ? GenreRegistry.label_for(registry_genre_key, locale: I18n.locale) : nil
- page_title = ({ "pillar" => t("drafity.columns.index.title_pillar"), "child" => t("drafity.columns.index.title_child") }[params[:article_type]] || t("drafity.columns.index.title_all"))
- empty_message = ({ "pillar" => t("drafity.columns.index.empty_pillar"), "child" => t("drafity.columns.index.empty_child") }[params[:article_type]] || t("drafity.columns.index.empty_all"))

- set_meta_tags title: (service_name.present? ? t("drafity.columns.index.meta_with_service", service: service_name) : page_title)
- index_desc_key = registry_genre_key.presence || current_genre_key
- index_description = (index_desc_key.present? && GenreRegistry.respond_to?(:columns_index_description) ? GenreRegistry.columns_index_description(index_desc_key, locale: I18n.locale).presence : nil)
- index_description ||= service_name.present? ? t("drafity.columns.index.description_with_service", service: service_name) : t("drafity.columns.index.description_generic", title: page_title)
- set_meta_tags description: index_description

- if @columns_manage_view
  .image-generation-page.columns-manage-page
    .dashboard-page-header
      h1 = page_title
      p.dashboard-page-subtitle
        - if params[:article_type] == 'pillar'
          = t("drafity.columns.index.lead_pillar")
        - elsif params[:article_type] == 'child'
          = t("drafity.columns.index.lead_child")
        - else
          = t("drafity.columns.index.lead_all")

    - if @current_genre_key.present?
      .columns-manage-tabs
        = link_to t("drafity.columns.index.tab_published"), public_columns_index_path(genre: @current_genre_key),
                  class: "btn btn-sm #{params[:article_type].blank? ? 'btn-dark' : 'btn-outline-dark'}",
                  data: { turbo: false }
        = link_to t("drafity.columns.index.tab_pillar"), public_columns_index_path(genre: @current_genre_key, article_type: 'pillar'),
                  class: "btn btn-sm #{params[:article_type] == 'pillar' ? 'btn-warning' : 'btn-outline-warning'}",
                  data: { turbo: false }
        = link_to t("drafity.columns.index.tab_cluster"), public_columns_index_path(genre: @current_genre_key, article_type: 'child'),
                  class: "btn btn-sm #{params[:article_type] == 'child' ? 'btn-primary' : 'btn-outline-primary'}",
                  data: { turbo: false }
    - else
      .columns-manage-tabs
        = link_to t("drafity.columns.index.tab_published"), columns_path,
                  class: "btn btn-sm #{params[:article_type].blank? ? 'btn-dark' : 'btn-outline-dark'}",
                  data: { turbo: false }
        = link_to t("drafity.columns.index.tab_pillar"), columns_path(article_type: 'pillar'),
                  class: "btn btn-sm #{params[:article_type] == 'pillar' ? 'btn-warning' : 'btn-outline-warning'}",
                  data: { turbo: false }
        = link_to t("drafity.columns.index.tab_cluster"), columns_path(article_type: 'child'),
                  class: "btn btn-sm #{params[:article_type] == 'child' ? 'btn-primary' : 'btn-outline-primary'}",
                  data: { turbo: false }

    .image-generation-list-panel
      .image-generation-list-header
        h3 = page_title
        span.image-generation-list-count = t("drafity.columns.index.count", count: (@paginated_columns&.total_count || 0))

      - if @columns.present?
        .table-wrap
          table.rich-dashboard-table
            thead
              tr
                th = t("drafity.columns.index.th_title")
                th = t("drafity.columns.index.th_genre")
                - if params[:article_type] == "pillar"
                  th = t("drafity.columns.index.th_children")
                - else
                  th = t("drafity.columns.index.th_type")
                th = t("drafity.columns.index.th_updated")
            tbody
              - @columns.each do |column|
                tr
                  td
                    = link_to column.title, public_column_show_path(column), class: "article-link", data: { turbo: false }
                  td = column.genre.presence || "—"
                  - if params[:article_type] == "pillar"
                    td = t("drafity.columns.index.child_count", count: (@child_counts&.[](column.id) || 0))
                  - else
                    td
                      - if column.article_type == "pillar"
                        = t("drafity.columns.index.type_pillar")
                      - else
                        = t("drafity.columns.index.type_cluster")
                  td.date-text = column.updated_at.in_time_zone.strftime("%Y/%m/%d %H:%M")

        .table-footer-pagination
          .pagination-nav
            = paginate @paginated_columns
      - else
        p.image-generation-empty = empty_message
        - if @current_genre_key.blank?
          p.image-generation-empty
            = link_to t("drafity.columns.index.to_genres"), dashboard_service_genres_path

    .dashboard-back-link
      = link_to t("drafity.columns.index.back_dashboard"), dashboard_root_path

- else
  .section-knowhow.columns-index-page
    .container
      h1.section-title style="margin-top: 20px;"
        = page_title

      - if params[:article_type] == 'pillar' && @current_genre_key.present?
        .genre-filter-wrapper style="margin-bottom: 20px;"
          form.filter-form action=public_columns_index_path(genre: @current_genre_key) method="get"
            = hidden_field_tag :article_type, 'pillar'
            label style="font-weight: bold; margin-right: 10px;" = t("drafity.columns.index.filter_genre")
            select name="selected_genre" onchange="this.form.submit()" class="form-select d-inline-block" style="width: auto; max-width: 200px;"
              option value="" = t("drafity.columns.index.filter_all")
              - @all_genres&.each do |g|
                option value=g selected=(params[:selected_genre] == g) = g.upcase

      - if params[:article_type] == 'pillar' && @grouped_columns.present?
        - @grouped_columns.each do |genre, columns|
          .genre-group style="margin-top: 30px;"
            h2.genre-name = genre.upcase
            .columns-list
              - columns.each do |column|
                .row.pillar-article-item
                  .col-12.col-md-9.info-container
                    h3.column-title
                      = link_to column.title, public_column_show_path(column), data: { turbo: false }

      - elsif @columns.present?
        .columns-grid
          - @columns.each do |column|
            .column-card
              .column-image
                - if (image_src = column_image_src(column)).present?
                  = image_tag image_src, width: "100%", class: "column-thumb", alt: column.title, loading: "lazy", decoding: "async"
                - else
                  .no-image style="background:#eee; aspect-ratio:16/9; border-radius:8px 8px 0 0; display:flex; align-items:center; justify-content:center; color:#999;" No Image
              .column-content
                h2.column-title
                  = link_to column.title, public_column_show_path(column), data: { turbo: false }
                - if column.description.present?
                  .column-description
                    = truncate(strip_tags(column.description), length: 120)
                    span.ms-1 style="color:#999; font-size:0.8rem;"
                      | （#{column.updated_at.in_time_zone.strftime("%Y/%m/%d")}）
      - else
        p.image-generation-empty = empty_message

      .pagination-wrapper
        - if @columns.present?
          = paginate @paginated_columns
