doctype html
html lang=current_locale
  head
    - page_title = admin_page_title
    title = [page_title, "Drafity Admin"].compact.join(" | ")
    = csrf_meta_tags
    = csp_meta_tag
    meta name="turbo-cache-control" content="no-cache"
    = stylesheet_link_tag "application", media: "all"
    = javascript_include_tag "application"
    meta name="viewport" content="width=device-width, initial-scale=1"

  body.admin-body
    - if admin_signed_in?
      - usage_used = nil
      - usage_limit = nil
      - usage_current_label = "∞"
      - usage_total_label = t("drafity.dashboard.layout.usage_unlimited")
      - usage_progress_width = "100%"
    - elsif client_signed_in?
      - usage_summary = current_client.usage_summary
      - usage_used = usage_summary[:pillar][:used].to_i + usage_summary[:child][:used].to_i
      - usage_limit = usage_summary[:pillar][:limit].to_i + usage_summary[:child][:limit].to_i
      - usage_current_label = usage_used.to_s
      - usage_total_label = t("drafity.dashboard.layout.usage_articles", count: usage_limit)
      - usage_ratio = usage_limit.positive? ? ((usage_used.to_f / usage_limit) * 100).round : 0
      - usage_progress_width = "#{usage_ratio.clamp(0, 100)}%"
    - else
      - usage_used = 0
      - usage_limit = 0
      - usage_current_label = "0"
      - usage_total_label = t("drafity.dashboard.layout.usage_zero")
      - usage_progress_width = "0%"

    .admin-sidebar-overlay#sidebarOverlay
    header.admin-mobile-header
      button.admin-sidebar-toggle#sidebarToggle type="button" aria-label=t("drafity.dashboard.layout.open_menu") aria-expanded="false" aria-controls="adminSidebar"
        svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
          line x1="3" y1="6" x2="21" y2="6"
          line x1="3" y1="12" x2="21" y2="12"
          line x1="3" y1="18" x2="21" y2="18"
      = link_to dashboard_root_path, class: "admin-mobile-logo" do
        = image_tag "logo.png", alt: "Drafity Logo", height: "28"

    .admin-shell
      aside.admin-sidebar#adminSidebar
        .sidebar-top
          .logo
            = link_to dashboard_root_path, class: "logo-link" do
              = image_tag "logo.png", alt: "Drafity Logo", width: "200", style: "filter: drop-shadow(0 0 8px rgba(59, 130, 246, 0.6));"

          = link_to new_column_path, class: "btn-create-article" do
            svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
              line x1="12" y1="5" x2="12" y2="19"
              line x1="5" y1="12" x2="19" y2="12"
            = t("drafity.dashboard.layout.create_pillar")

          nav.sidebar-nav
            /= link_to dashboard_root_path, class: (controller_name == "columns" && action_name == "dashboard_index" ? "active" : nil) do
              svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"
                polyline points="9 22 9 12 15 12 15 22"
              = t("drafity.dashboard.layout.nav.dashboard")

            /= link_to dashboard_columns_path, class: (controller_name == "columns" && action_name == "index" ? "active" : nil) do
              svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"
                polyline points="14 2 14 8 20 8"
                line x1="16" y1="13" x2="8" y2="13"
                line x1="16" y1="17" x2="8" y2="17"
                polyline points="10 9 9 9 8 9"
              = t("drafity.dashboard.layout.nav.generation")

            = link_to draft_columns_path, class: (controller_path == "columns" && action_name == "draft" ? "active" : nil) do
              svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"
                path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"
              = t("drafity.dashboard.layout.nav.drafts")

            = link_to dashboard_columns_path(scope: "pending_review"), class: (controller_path == "dashboard/columns" && action_name == "index" && params[:scope] == "pending_review" ? "active" : nil) do
              svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                circle cx="12" cy="12" r="10"
                polyline points="12 6 12 12 16 14"
              = t("drafity.dashboard.layout.nav.pending_review")
              span.sidebar-nav-badge.js-sidebar-badge data-badge="pending_review" hidden="hidden"

            = link_to columns_path(article_type: "pillar"), class: (controller_path == "columns" && action_name == "index" && params[:article_type] == "pillar" ? "active" : nil) do
              svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                path d="M12 22a7 7 0 1 0 0-14 7 7 0 0 0 0 14z"
                path d="M12 8V2"
                path d="M5 12H2"
                path d="M22 12h-3"
                path d="M16.5 7.5L19 5"
                path d="M7.5 7.5L5 5"
              = t("drafity.dashboard.layout.nav.cluster_titles")

            /= link_to columns_path(article_type: "pillar") do
              svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"
              = t("drafity.dashboard.layout.nav.cluster_bulk")

            = link_to columns_path, class: (controller_path == "columns" && action_name == "index" && params[:article_type].blank? ? "active" : nil) do
              svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"
                polyline points="22 4 12 14.01 9 11.01"
              = t("drafity.dashboard.layout.nav.published")

            = link_to image_generation_dashboard_columns_path, class: (controller_path == "dashboard/columns" && action_name == "image_generation" ? "active" : nil) do
              svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                rect x="3" y="3" width="18" height="18" rx="2" ry="2"
                circle cx="8.5" cy="8.5" r="1.5"
                polyline points="21 15 16 10 5 21"
              = t("drafity.dashboard.layout.nav.image_generation")
              span.sidebar-nav-badge.js-sidebar-badge data-badge="missing_image" hidden="hidden"

            = link_to dashboard_service_genres_path, class: (controller_name == "service_genres" ? "active" : nil) do
              svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"
              = t("drafity.dashboard.layout.nav.service_genres")

            - if admin_signed_in? || (client_signed_in? && current_client.ai_autonomous_enabled?)
              = link_to dashboard_autonomous_runs_path, class: (controller_name == "autonomous_runs" ? "active" : nil) do
                svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                  polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"
                = t("drafity.dashboard.layout.nav.autonomous")

            - if admin_signed_in?
              - admin_settings_active = (controller_path == "dashboard/columns" && action_name.in?(%w[management setting]))
              .sidebar-nav-group class=(admin_settings_active ? "is-active" : nil)
                button.sidebar-nav-group-toggle type="button" aria-haspopup="true" aria-expanded=(admin_settings_active ? "true" : "false")
                  span.sidebar-nav-group-toggle-label
                    svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                      circle cx="12" cy="12" r="3"
                      path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l-.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"
                    = t("drafity.dashboard.layout.nav.settings")
                  svg.sidebar-nav-group-caret xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                    polyline points="6 9 12 15 18 9"
                .sidebar-submenu
                  = link_to dashboard_management_path, class: (controller_path == "dashboard/columns" && action_name == "management" ? "active" : nil) do
                    svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                      circle cx="12" cy="12" r="3"
                      path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l-.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"
                    = t("drafity.dashboard.layout.nav.management")

                  = link_to dashboard_setting_path, class: (controller_path == "dashboard/columns" && action_name == "setting" ? "active" : nil) do
                    svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                      circle cx="12" cy="12" r="10"
                      line x1="2" y1="12" x2="22" y2="12"
                      path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"
                    = t("drafity.dashboard.layout.nav.account")

                  = link_to destroy_admin_session_path, method: :delete do
                    svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                      path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"
                      polyline points="16 17 21 12 16 7"
                      line x1="21" y1="12" x2="9" y2="12"
                    = t("drafity.dashboard.layout.logout_admin")
            - elsif client_signed_in?
              - settings_active = (controller_path == "dashboard/clients" && action_name == "my_api_settings") || (controller_path == "dashboard/columns" && action_name == "setting") || (controller_path == "dashboard/api_guide") || controller_name.in?(%w[plans subscriptions])
              .sidebar-nav-group class=(settings_active ? "is-active" : nil)
                button.sidebar-nav-group-toggle type="button" aria-haspopup="true" aria-expanded=(settings_active ? "true" : "false")
                  span.sidebar-nav-group-toggle-label
                    svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                      circle cx="12" cy="12" r="3"
                      path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"
                    = t("drafity.dashboard.layout.nav.settings")
                  svg.sidebar-nav-group-caret xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                    polyline points="6 9 12 15 18 9"
                .sidebar-submenu
                  = link_to plans_path, class: (controller_name == "plans" ? "active" : nil) do
                    svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                      rect x="1" y="4" width="22" height="16" rx="2" ry="2"
                      line x1="1" y1="10" x2="23" y2="10"
                    = t("drafity.dashboard.layout.nav.plans")

                  = link_to dashboard_api_settings_path, class: (controller_path == "dashboard/clients" && action_name == "my_api_settings" ? "active" : nil) do
                    svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                      circle cx="12" cy="12" r="3"
                      path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l-.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"
                    = t("drafity.dashboard.layout.nav.api_settings")

                  = link_to dashboard_api_guide_path, class: (controller_path == "dashboard/api_guide" ? "active" : nil) do
                    svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                      path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"
                      path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"
                    = t("drafity.dashboard.layout.nav.api_guide")

                  = link_to dashboard_setting_path, class: (controller_path == "dashboard/columns" && action_name == "setting" ? "active" : nil) do
                    svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                      circle cx="12" cy="12" r="3"
                      path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l-.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"
                    = t("drafity.dashboard.layout.nav.account")

                  = link_to "#", onclick: "event.preventDefault(); openProblemReportModal();" do
                    svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                      path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"
                      line x1="12" y1="9" x2="12" y2="13"
                      line x1="12" y1="17" x2="12.01" y2="17"
                    = t("drafity.dashboard.layout.nav.problem_report")

            - if client_signed_in?
              = link_to destroy_client_session_path, method: :delete, class: "logout-link" do
                svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                  path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"
                  polyline points="16 17 21 12 16 7"
                  line x1="21" y1="12" x2="9" y2="12"
                = t("drafity.dashboard.layout.logout")

        .sidebar-bottom
          .usage-container
            .usage-header = t("drafity.dashboard.layout.usage_header")
            .usage-stats
              span.usage-current = usage_current_label
              span.usage-total = usage_total_label
            .usage-progress-bar
              .usage-progress-fill style=("width: #{usage_progress_width};")

      main.admin-main
        - flash.each do |type, message|
          - next if message.blank?
          .admin-flash-message class="admin-flash-message--#{type == 'notice' ? 'success' : 'danger'}" role="alert"
            = message
        - if client_signed_in?
          = render "shared/plan_upgrade_banner"
        = yield

    - if client_signed_in?
      = render "shared/problem_report_modal"

  javascript:
    (function() {
      window.openProblemReportModal = function() {
        const modal = document.getElementById('problem-report-modal');
        if (!modal) return;
        modal.style.display = 'flex';
        document.body.classList.add('modal-open');
        const firstInput = modal.querySelector('input:not([type="hidden"]), textarea');
        if (firstInput) setTimeout(function() { firstInput.focus(); }, 50);
      };

      window.closeProblemReportModal = function() {
        const modal = document.getElementById('problem-report-modal');
        if (!modal) return;
        modal.style.display = 'none';
        document.body.classList.remove('modal-open');
      };

      const initSidebar = () => {
        const toggleEl = document.getElementById('sidebarToggle');
        const sidebar  = document.getElementById('adminSidebar');
        const overlay  = document.getElementById('sidebarOverlay');
        if (!toggleEl || !sidebar || !overlay) return;

        const freshToggle = toggleEl.cloneNode(true);
        toggleEl.replaceWith(freshToggle);

        const closeSidebar = () => {
          sidebar.classList.remove('is-open');
          overlay.classList.remove('is-visible');
          document.body.classList.remove('sidebar-open');
          freshToggle.setAttribute('aria-expanded', 'false');
        };

        const openSidebar = () => {
          sidebar.classList.add('is-open');
          overlay.classList.add('is-visible');
          document.body.classList.add('sidebar-open');
          freshToggle.setAttribute('aria-expanded', 'true');
        };

        freshToggle.addEventListener('click', () => {
          sidebar.classList.contains('is-open') ? closeSidebar() : openSidebar();
        });

        overlay.addEventListener('click', closeSidebar);

        sidebar.querySelectorAll('a').forEach((link) => {
          link.addEventListener('click', () => {
            if (window.matchMedia('(max-width: 768px)').matches) closeSidebar();
          });
        });

        document.addEventListener('keydown', (e) => {
          if (e.key !== 'Escape') return;
          const problemModal = document.getElementById('problem-report-modal');
          if (problemModal && problemModal.style.display === 'flex') {
            closeProblemReportModal();
            return;
          }
          closeSidebar();
        });

        window.addEventListener('resize', () => {
          if (window.innerWidth > 768) closeSidebar();
        });
      };

      const initProblemReportModal = () => {
        const modal = document.getElementById('problem-report-modal');
        if (!modal || modal.dataset.bound === '1') return;
        modal.dataset.bound = '1';

        modal.addEventListener('click', (e) => {
          if (e.target === modal) closeProblemReportModal();
        });
      };

      const initSidebarBadges = () => {
        const badges = document.querySelectorAll('.js-sidebar-badge');
        if (!badges.length) return;
        if (document.body.dataset.sidebarBadgesLoading === '1') return;
        document.body.dataset.sidebarBadgesLoading = '1';

        fetch('/dashboard/columns/sidebar_badges', {
          headers: { 'Accept': 'application/json' },
          credentials: 'same-origin'
        }).then((response) => {
          if (!response.ok) return null;
          return response.json();
        }).then((data) => {
          if (!data) return;
          badges.forEach((el) => {
            const count = Number(data[el.dataset.badge] || 0);
            if (count > 0) {
              el.textContent = String(count);
              el.removeAttribute('hidden');
            } else {
              el.textContent = '';
              el.setAttribute('hidden', 'hidden');
            }
          });
        }).catch(() => {}).finally(() => {
          document.body.dataset.sidebarBadgesLoading = '0';
