doctype html
html
  head
    title Drafity Admin
    = csrf_meta_tags
    = csp_meta_tag
    = stylesheet_link_tag "application", media: "all"
    = javascript_include_tag "application", defer: true
    meta name="viewport" content="width=device-width, initial-scale=1"

  body.admin-body
    .admin-sidebar-overlay#sidebarOverlay
    header.admin-mobile-header
      button.admin-sidebar-toggle#sidebarToggle type="button" aria-label="メニューを開く" aria-expanded="false" aria-controls="adminSidebar"
        svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
          line x1="3" y1="6" x2="21" y2="6"
          line x1="3" y1="12" x2="21" y2="12"
          line x1="3" y1="18" x2="21" y2="18"
      = link_to root_path, class: "admin-mobile-logo" do
        = image_tag "logo.png", alt: "Drafity Logo", height: "28"

    .admin-shell
      aside.admin-sidebar#adminSidebar
        .sidebar-top
          .logo
            = link_to root_path, class: "logo-link" do
              = image_tag "logo.png", alt: "Drafity Logo", width: "200", style: "filter: drop-shadow(0 0 8px rgba(59, 130, 246, 0.6));"

          = link_to new_column_path, class: "btn-create-article" do
            svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
              line x1="12" y1="5" x2="12" y2="19"
              line x1="5" y1="12" x2="19" y2="12"
            | 親記事の作成開始

          nav.sidebar-nav
            /= link_to dashboard_root_path, class: (controller_name == "columns" && action_name == "dashboard_index" ? "active" : nil) do
              svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"
                polyline points="9 22 9 12 15 12 15 22"
              | ダッシュボード

            /= link_to dashboard_columns_path, class: (controller_name == "columns" && action_name == "index" ? "active" : nil) do
              svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"
                polyline points="14 2 14 8 20 8"
                line x1="16" y1="13" x2="8" y2="13"
                line x1="16" y1="17" x2="8" y2="17"
                polyline points="10 9 9 9 8 9"
              | 生成管理

            = link_to draft_columns_path do
              svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"
                path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"
              | ドラフト一覧

            = link_to "/columns?article_type=pillar" do
              svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                path d="M12 22a7 7 0 1 0 0-14 7 7 0 0 0 0 14z"
                path d="M12 8V2"
                path d="M5 12H2"
                path d="M22 12h-3"
                path d="M16.5 7.5L19 5"
                path d="M7.5 7.5L5 5"
              | クラスタータイトル生成

            /= link_to columns_path(article_type: "pillar") do
              svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"
              | クラスター記事一括生成

            = link_to columns_path do
              svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"
                polyline points="22 4 12 14.01 9 11.01"
              | 公開済み記事

            = link_to image_generation_dashboard_columns_path, class: (controller_name == "columns" && action_name == "image_generation" ? "active" : nil) do
              svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                rect x="3" y="3" width="18" height="18" rx="2" ry="2"
                circle cx="8.5" cy="8.5" r="1.5"
                polyline points="21 15 16 10 5 21"
              | 画像一括生成

            = link_to dashboard_service_genres_path, class: (controller_name == "service_genres" ? "active" : nil) do
              svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"
              | サービス・ジャンル管理

            - if admin_signed_in?
              = link_to dashboard_management_path, class: (controller_name == "dashboards" && action_name == "management" ? "active" : nil) do
                svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                  circle cx="12" cy="12" r="3"
                  path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"
                | クライアント管理
            - elsif client_signed_in?
              = link_to dashboard_api_settings_path, class: (controller_name == "clients" && action_name == "my_api_settings" ? "active" : nil) do
                svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                  circle cx="12" cy="12" r="3"
                  path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"
                | API設定

            - if admin_signed_in?
              = link_to destroy_admin_session_path, method: :delete, class: "logout-link" do
                svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                  path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"
                  polyline points="16 17 21 12 16 7"
                  line x1="21" y1="12" x2="9" y2="12"
                | ログアウト (管理者)
            - elsif client_signed_in?
              = link_to destroy_client_session_path, method: :delete, class: "logout-link" do
                svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                  path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"
                  polyline points="16 17 21 12 16 7"
                  line x1="21" y1="12" x2="9" y2="12"
                | ログアウト

        .sidebar-bottom
          .user-profile style="display: flex; align-items: center; justify-content: space-between; width: 100%; position: relative;"
            .user-info-group style="display: flex; align-items: center; gap: 12px;"
              img src="https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=150" alt="Avatar" class="avatar"
              .user-info
                span.user-name Yuki Tanaka
                span.user-plan Pro Plan
            .user-menu-wrapper style="position: static;"
              button.btn-user-menu#userMenuBtn type="button" style="background: none; border: none; color: #94a3b8; cursor: pointer; padding: 4px 8px; font-size: 16px;" •••
              .user-menu-dropdown#userMenuDropdown style="display: none; position: absolute; bottom: 100%; left: 0; right: 0; margin-bottom: 8px; background-color: #1e293b; border: 1px solid #334155; border-radius: 6px; box-shadow: 0 10px 15px -3px rgba(0,0,0,0.3); z-index: 50; padding: 6px 0;"
                - if client_signed_in?
                  = link_to dashboard_setting_path, style: "display: flex; align-items: center; gap: 8px; padding: 10px 16px; font-size: 13px; color: #f8fafc; text-decoration: none; transition: background-color 0.2s;", onmouseover: "this.style.backgroundColor='#334155'", onmouseout: "this.style.backgroundColor='transparent'" do
                    svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                      circle cx="12" cy="12" r="3"
                      path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"
                    | アカウント設定

          .usage-container
            .usage-header 今月の使用状況
            .usage-stats
              span.usage-current 162
              span.usage-total = "/ 300 記事"
            .usage-progress-bar
              .usage-progress-fill style="width: 54%;"

      main.admin-main
        = yield

  javascript:
    (function() {
      const initSidebar = () => {
        const toggleEl = document.getElementById('sidebarToggle');
        const sidebar  = document.getElementById('adminSidebar');
        const overlay  = document.getElementById('sidebarOverlay');
        if (!toggleEl || !sidebar || !overlay) return;

        const freshToggle = toggleEl.cloneNode(true);
        toggleEl.replaceWith(freshToggle);

        const closeSidebar = () => {
          sidebar.classList.remove('is-open');
          overlay.classList.remove('is-visible');
          document.body.classList.remove('sidebar-open');
          freshToggle.setAttribute('aria-expanded', 'false');
        };

        const openSidebar = () => {
          sidebar.classList.add('is-open');
          overlay.classList.add('is-visible');
          document.body.classList.add('sidebar-open');
          freshToggle.setAttribute('aria-expanded', 'true');
        };

        freshToggle.addEventListener('click', () => {
          sidebar.classList.contains('is-open') ? closeSidebar() : openSidebar();
        });

        overlay.addEventListener('click', closeSidebar);

        sidebar.querySelectorAll('a').forEach((link) => {
          link.addEventListener('click', () => {
            if (window.matchMedia('(max-width: 768px)').matches) closeSidebar();
          });
        });

        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') closeSidebar();
        });

        window.addEventListener('resize', () => {
          if (window.innerWidth > 768) closeSidebar();
        });
      };

      const initUserMenu = () => {
        const btn      = document.getElementById('userMenuBtn');
        const dropdown = document.getElementById('userMenuDropdown');
        if (!btn || !dropdown) return;

        const freshBtn = btn.cloneNode(true);
        btn.replaceWith(freshBtn);

        freshBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          dropdown.style.display = dropdown.style.display === 'block' ? 'none' : 'block';
        });
        document.addEventListener('click', (e) => {
          if (!dropdown.contains(e.target) && e.target !== freshBtn) {
            dropdown.style.display = 'none';
          }
        });
      };

      const initAll = () => {
        initSidebar();
        initUserMenu();
      };

      document.addEventListener('turbo:load', initAll);
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initAll);
      } else {
        initAll();
      }
    })();