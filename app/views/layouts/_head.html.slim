meta charset="UTF-8"
meta name="viewport" content="width=device-width, initial-scale=1.0"
meta name="turbo-cache-control" content="no-cache"
= csrf_meta_tags
= csp_meta_tag

link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@300;400;700&display=swap" rel="stylesheet"
= stylesheet_link_tag "application", media: "all", "data-turbo-track": "reload"

/ ページ遷移時の多重読み込みとイベント蓄積を完全に防止するため、HEAD内でdefer属性を付与して管理
= javascript_include_tag "application", "data-turbo-track": "reload"

= display_meta_tags
= favicon_link_tag "favicon.ico"

- if respond_to?(:href_for_locale) && !public_column_article_page?
  link rel="alternate" hreflang="ja" href="#{request.base_url}#{href_for_locale(:ja)}"
  link rel="alternate" hreflang="en" href="#{request.base_url}#{href_for_locale(:en)}"
  link rel="alternate" hreflang="x-default" href="#{request.base_url}#{href_for_locale(:ja)}"

- if defined?(breadcrumbs) && breadcrumbs.respond_to?(:any?) && breadcrumbs.any?
  script type="application/ld+json"
    = raw(breadcrumb_list_json_ld)

- if content_for?(:article_json_ld)
  script type="application/ld+json"
    = yield(:article_json_ld)

- if controller_name == "tops" && action_name == "index"
  script type="application/ld+json"
    = raw(organization_json_ld)
  script type="application/ld+json"
    = raw(website_json_ld)
  - faq_ld = faq_page_json_ld(lp_faqs)
  - if faq_ld.present?
    script type="application/ld+json"
      = raw(faq_ld)

