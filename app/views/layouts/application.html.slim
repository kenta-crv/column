doctype html
html lang=I18n.locale
  head
    = render "layouts/head"

    / --- canonical（各ドメイン用） ---
    - canonical_url = request.url
    - canonical_url = "#{request.base_url}/" if request.path == "/tops"
    - canonical_url = "#{request.base_url}/en" if request.path == "/en/tops"
    link rel="canonical" href=canonical_url

  body
    - if defined?(breadcrumbs) && breadcrumbs.any?
      = render "shared/breadcrumbs"

    - if params[:sent] == '1'
      .flash-message.alert.alert-success role="alert"
        | 送信完了しました

      - if controller_name == "tops" && action_name == "development"
        script async=true
          |
            ytag({
              "type": "yss_conversion",
              "config": {
                "yahoo_conversion_id": "1001407956",
                "yahoo_conversion_label": "yrUNCIea1r0dEIu2l7NE",
                "yahoo_conversion_value": "0"
              }
            });

      script
        |
          gtag('event', 'conversion', {
              'send_to': 'AW-10998015402/P0wGCMmaqZQcEKrLofwo',
              'value': 1.0,
              'currency': 'JPY'
          });

    - flash.each do |type, message|
      - tag_class = (type == 'notice' ? 'success' : 'danger')
      div class="flash-message alert alert-#{tag_class}" role="alert"
        = message

    = yield