.container-fluid.py-4
  .api-settings-page
    .api-settings-header
      h1.api-settings-title
        | API設定
      
      p.api-settings-subtitle
        = "クライアント: #{@client.email}"

    .api-settings-card
      .api-settings-card__body
        = form_with model: @client, url: (admin_signed_in? ? update_api_settings_dashboard_client_path(@client) : dashboard_api_settings_path), local: true, method: :patch do |f|
          .form-section
            h3.form-section-title
              | 基本設定
            
            .form-group
              = f.label :api_key, "APIキー"
              = f.text_field :api_key, class: "form-control", readonly: true
              small.form-text
                | APIキーは自動生成されます。再発行が必要な場合は管理者にお問い合わせください。

            .form-group
              = f.label :webhook_url, "Webhook URL"
              = f.text_field :webhook_url, class: "form-control", placeholder: "https://client-site.com/webhook/articles"
              small.form-text
                | 記事更新時の通知先URL（オプション）

          .form-section
            h3.form-section-title
              | ジャンル

            .form-group
              - if @client_service_genres.present?
                ul.allowed-genres-list
                  - @client_service_genres.each do |genre|
                    li
                      = genre.ja
                      code.genre-key = genre.key
              - else
                p.form-text ジャンルが未登録です。
              small.form-text
                = link_to "サービス・ジャンル管理", dashboard_service_genres_path
                | で追加・編集します。APIで公開されるジャンルもここで登録したものになります。

          .form-section
            h3.form-section-title
              | 埋め込み設定
            
            .form-group
              = f.label :embed_settings, "埋め込み設定（JSON）"
              - display_value = @client.embed_settings.is_a?(Hash) ? JSON.pretty_generate(@client.embed_settings) : @client.embed_settings.to_s
              = f.text_area :embed_settings, class: "form-control", rows: 5, value: display_value
              small.form-text
                | カスタム埋め込み設定（オプション）

          .form-actions
            = f.submit "設定を保存", class: "btn btn-primary"
            = link_to "キャンセル", (admin_signed_in? ? dashboard_management_path : dashboard_root_path), class: "btn btn-secondary"

    .api-instructions
      h3.api-instructions-title
        | クライアントへの埋め込み手順
      
      .api-instructions-step
        .step-number 1
        .step-content
          h4 以下のコードを対象のページに貼り付けてください
          
          .custom-code-block
            .code-block-header
              span.code-lang HTML
              button.code-copy-btn.js-copy-btn type="button" data-target="embed-code"
                | コピー
            .code-block-body
              pre
                code#embed-code
                  = "<main class=\"content-area\">\n  <div id=\"articles\"></div>\n</main>\n\n<script src=\"https://drafity.pro/embed.js\" data-api-key=\"#{@client.api_key}\"></script>"
      
      .api-instructions-step
        .step-number 2
        .step-content
          h4 指定した場所に記事が自動的に読み込まれます

javascript:
  document.addEventListener('DOMContentLoaded', () => {
    const copyBtn = document.querySelector('.js-copy-btn');
    if (!copyBtn) return;

    copyBtn.addEventListener('click', () => {
      const targetId = copyBtn.getAttribute('data-target');
      const codeElement = document.getElementById(targetId);
      
      if (codeElement) {
        const textToCopy = codeElement.textContent;
        
        navigator.clipboard.writeText(textToCopy).then(() => {
          copyBtn.textContent = 'コピー完了';
          copyBtn.classList.add('copied');
          
          setTimeout(() => {
            copyBtn.textContent = 'コピー';
            copyBtn.classList.remove('copied');
          }, 2000);
        }).catch(err => {
          console.error('コピーに失敗しました: ', err);
        });
      }
    });
  });