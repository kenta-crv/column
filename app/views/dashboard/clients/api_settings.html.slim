.container-fluid.py-4
  .api-settings-page
    .api-settings-header
      h1.api-settings-title
        = t("drafity.dashboard.api.title")
      
      p.api-settings-subtitle
        = t("drafity.dashboard.api.client_label", email: @client.email)
        span.api-settings-header-sep &middot;
        = link_to t("drafity.dashboard.api.guide_link"), dashboard_api_guide_path, class: "api-settings-header-link"

    .api-settings-card
      .api-settings-card__body
        = form_with model: @client, url: (acting_as_admin? ? update_api_settings_dashboard_client_path(@client) : dashboard_api_settings_path), local: true, method: :patch do |f|
          .form-section
            h3.form-section-title
              = t("drafity.dashboard.api.basic")
            
            .form-group
              = f.label :api_key, t("drafity.dashboard.api.key")
              .api-key-field
                = f.text_field :api_key, class: "form-control", readonly: true
                = link_to t("drafity.dashboard.api.regenerate"), (acting_as_admin? ? regenerate_api_key_dashboard_client_path(@client) : dashboard_api_settings_regenerate_api_key_path), data: { turbo_method: :post, turbo_confirm: t("drafity.dashboard.api.confirm_regenerate"), confirm: t("drafity.dashboard.api.confirm_regenerate") }, class: "btn-gradient"
              small.form-text
                = t("drafity.dashboard.api.key_hint")

            .form-group
              = f.label :webhook_url, "Webhook URL"
              = f.text_field :webhook_url, class: "form-control", placeholder: "https://client-site.com/webhook/articles"
              small.form-text
                = t("drafity.dashboard.api.webhook")

          .form-section
            h3.form-section-title
              = t("drafity.dashboard.api.genres")

            .form-group
              - if @client_service_genres.present?
                ul.allowed-genres-list
                  - @client_service_genres.each do |genre|
                    li
                      = genre.display_name
                      code.genre-key = genre.key
              - else
                p.form-text = t("drafity.dashboard.api.no_genres")
              small.form-text
                = link_to t("drafity.dashboard.api.genres_manage_link"), dashboard_service_genres_path
                = t("drafity.dashboard.api.genres_manage_suffix")

          .form-section
            h3.form-section-title
              = t("drafity.dashboard.api.embed")
            
            .form-group
              = f.label :embed_settings, t("drafity.dashboard.api.embed_json")
              - display_value = @client.embed_settings.is_a?(Hash) ? JSON.pretty_generate(@client.embed_settings) : @client.embed_settings.to_s
              = f.text_area :embed_settings, class: "form-control", rows: 5, value: display_value
              small.form-text
                = t("drafity.dashboard.api.embed_custom")

          .form-actions
            = f.submit t("drafity.dashboard.api.save"), class: "btn-gradient"
            = link_to t("drafity.dashboard.common.cancel"), (acting_as_admin? ? dashboard_management_path : dashboard_root_path), class: "btn-secondary"

    .api-instructions
      h3.api-instructions-title
        = t("drafity.dashboard.api.embed_howto")
      
      .api-instructions-step
        .step-number 1
        .step-content
          h4 = t("drafity.dashboard.api.embed_step1")
          
          .custom-code-block
            .code-block-header
              span.code-lang HTML
              button.code-copy-btn.js-copy-btn type="button" data-target="embed-code"
                = t("drafity.dashboard.common.copy")
            .code-block-body
              pre
                code#embed-code
                  = "<main class=\"content-area\">\n  <div id=\"articles\"></div>\n</main>\n\n<script src=\"https://drafity.pro/embed.js\" data-api-key=\"#{@client.api_key}\"></script>"
      
      .api-instructions-step
        .step-number 2
        .step-content
          h4 = t("drafity.dashboard.api.embed_step2")

- js_i18n = { copied: t("drafity.dashboard.common.copied"), copy: t("drafity.dashboard.common.copy") }.to_json.html_safe
javascript:
  (function() {
    const I18nDash = #{js_i18n};
    const bindCopyButton = () => {
      const copyBtn = document.querySelector('.js-copy-btn');
      if (!copyBtn || copyBtn.dataset.initialized === 'true') return;
      copyBtn.dataset.initialized = 'true';

      copyBtn.addEventListener('click', () => {
        const targetId = copyBtn.getAttribute('data-target');
        const codeElement = document.getElementById(targetId);
        if (!codeElement) return;

        navigator.clipboard.writeText(codeElement.textContent).then(() => {
          copyBtn.textContent = I18nDash.copied;
          copyBtn.classList.add('copied');
          setTimeout(() => {
            copyBtn.textContent = I18nDash.copy;
            copyBtn.classList.remove('copied');
          }, 2000);
        }).catch((err) => {
          console.error('Copy failed: ', err);
        });
      });
    };

    document.addEventListener('turbolinks:load', bindCopyButton);
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', bindCopyButton);
    } else {
      bindCopyButton();
    }
  })();
