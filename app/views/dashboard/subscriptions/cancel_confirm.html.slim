.container-fluid.py-4
  .api-settings-page
    .api-settings-header
      h1.api-settings-title サブスクリプション解約
      p.api-settings-subtitle 解約手続きの確認

    .api-settings-card
      .api-settings-card__body style="text-align: center; padding: 40px 24px;"
        h3 style="color: #dc2626; font-size: 1.25rem; font-weight: 700; margin-bottom: 16px;"
          | 本当にサブスクリプションを解約しますか？

        p style="color: #475569; line-height: 1.7; margin-bottom: 24px;"
          | 解約手続きを完了すると、自動更新が停止されます。
          br
          strong style="color: #0f172a;"
            | 最終利用可能日：#{@available_until.strftime("%Y年%m月%d日")}
          br
          span style="font-size: 14px;" この日付まで、すべての有料機能を引き続きご利用いただけます。

        p style="margin-bottom: 28px;"
          span style="font-size: 12px; color: #64748b;" 現在のプラン
          br
          strong style="font-size: 16px;" = @target_client.subscription_plan&.capitalize || "None"

        .d-flex style="justify-content: center; gap: 12px; flex-wrap: wrap;"
          = link_to "戻る", dashboard_subscription_path(subscription_path_params), class: "btn btn-secondary btn-sm"
          = button_to "解約を確定する", cancel_dashboard_subscription_path(subscription_path_params), method: :post, class: "btn btn-sm", style: "background: #fef2f2; color: #dc2626; border: 1px solid #fecaca;"
