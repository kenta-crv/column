.container-fluid.py-4
  .api-settings-page
    .api-settings-header
      h1.api-settings-title
        = t("drafity.dashboard.api_guide.title")
      p.api-settings-subtitle
        = t("drafity.dashboard.api_guide.subtitle_before")
        = link_to t("drafity.dashboard.api_guide.settings_link"), (acting_as_admin? ? dashboard_management_path : dashboard_api_settings_path)
        = t("drafity.dashboard.api_guide.subtitle_after")

    .api-settings-card
      .api-settings-card__body
        .form-section
          h3.form-section-title
            = t("drafity.dashboard.api_guide.methods_title")
          table.api-guide-table
            thead
              tr
                th = t("drafity.dashboard.api_guide.col_method")
                th = t("drafity.dashboard.api_guide.col_when")
                th = t("drafity.dashboard.api_guide.col_skill")
            tbody
              tr
                td
                  strong = t("drafity.dashboard.api_guide.embed_name")
                td = t("drafity.dashboard.api_guide.embed_when")
                td = t("drafity.dashboard.api_guide.embed_skill")
              tr
                td
                  strong JSON API
                td = t("drafity.dashboard.api_guide.json_when")
                td = t("drafity.dashboard.api_guide.json_skill")
              tr
                td
                  strong = t("drafity.dashboard.api_guide.webhook_name")
                td = t("drafity.dashboard.api_guide.webhook_when")
                td = t("drafity.dashboard.api_guide.webhook_skill")

        .form-section
          h3.form-section-title
            = t("drafity.dashboard.api_guide.embed_section")

          p.api-guide-lead
            = t("drafity.dashboard.api_guide.embed_lead")

          .custom-code-block
            .code-block-header
              span.code-lang HTML
              button.code-copy-btn.js-copy-btn type="button" data-target="embed-code-guide"
                = t("drafity.dashboard.common.copy")
            .code-block-body
              pre
                code#embed-code-guide
                  - api_key_sample = @client ? @client.api_key : "YOUR_API_KEY"
                  = "<main class=\"content-area\">\n  <div id=\"articles\"></div>\n</main>\n\n<script src=\"https://drafity.pro/embed.js\" data-api-key=\"#{api_key_sample}\"></script>"

          ul.api-guide-list
            li
              = t("drafity.dashboard.api_guide.embed_li1_before")
              code data-container-id="my-articles"
              = t("drafity.dashboard.api_guide.embed_li1_mid")
              code id
              = t("drafity.dashboard.api_guide.embed_li1_after")
            li = t("drafity.dashboard.api_guide.embed_li2")
            li
              = t("drafity.dashboard.api_guide.embed_li3_before")
              code .embedded-article
              |
              code .article-title
              |
              code .article-body
              |
              code .article-meta
              = t("drafity.dashboard.api_guide.embed_li3_after")

        .form-section
          h3.form-section-title
            = t("drafity.dashboard.api_guide.json_section")

          p.api-guide-lead
            = t("drafity.dashboard.api_guide.json_lead_before")
            code X-API-Key
            = t("drafity.dashboard.api_guide.json_lead_mid")
            code api_key
            = t("drafity.dashboard.api_guide.json_lead_after")

          h4.api-guide-subtitle = t("drafity.dashboard.api_guide.list_title")
          .custom-code-block
            .code-block-header
              span.code-lang bash
            .code-block-body
              pre
                code
                  = "curl -X GET https://drafity.pro/api/v1/articles \\\n  -H \"X-API-Key: YOUR_API_KEY\""

          table.api-guide-table
            thead
              tr
                th = t("drafity.dashboard.api_guide.col_param")
                th = t("drafity.dashboard.labels.description")
            tbody
              tr
                td
                  code genre
                td = t("drafity.dashboard.api_guide.param_genre")
              tr
                td
                  code article_type
                td = t("drafity.dashboard.api_guide.param_type")
              tr
                td
                  code updated_since
                td = t("drafity.dashboard.api_guide.param_updated")
              tr
                td
                  code page
                td = t("drafity.dashboard.api_guide.param_page")
              tr
                td
                  code per_page
                td = t("drafity.dashboard.api_guide.param_per")

          h4.api-guide-subtitle = t("drafity.dashboard.api_guide.single_title")
          .custom-code-block
            .code-block-header
              span.code-lang bash
            .code-block-body
              pre
                code
                  = "curl -X GET https://drafity.pro/api/v1/articles/:code \\\n  -H \"X-API-Key: YOUR_API_KEY\""
          p.api-guide-note = t("drafity.dashboard.api_guide.single_note")

        .form-section
          h3.form-section-title
            = t("drafity.dashboard.api_guide.webhook_section")

          p.api-guide-lead
            = t("drafity.dashboard.api_guide.webhook_lead")

          table.api-guide-table
            thead
              tr
                th = t("drafity.dashboard.api_guide.col_event")
                th = t("drafity.dashboard.api_guide.col_when_event")
            tbody
              tr
                td
                  code created
                td = t("drafity.dashboard.api_guide.ev_created")
              tr
                td
                  code updated
                td = t("drafity.dashboard.api_guide.ev_updated")
              tr
                td
                  code deleted
                td = t("drafity.dashboard.api_guide.ev_deleted")

          p.api-guide-note
            = t("drafity.dashboard.api_guide.webhook_note_before")
            code updated_since
            = t("drafity.dashboard.api_guide.webhook_note_after")

        .form-section
          h3.form-section-title
            = t("drafity.dashboard.api_guide.help_title")

          table.api-guide-table
            thead
              tr
                th = t("drafity.dashboard.api_guide.col_error")
                th = t("drafity.dashboard.api_guide.col_meaning")
            tbody
              tr
                td
                  code 401 Unauthorized
                td = t("drafity.dashboard.api_guide.err_401")
              tr
                td
                  code 403 Forbidden
                td = t("drafity.dashboard.api_guide.err_403")
              tr
                td
                  code 404 Not Found
                td = t("drafity.dashboard.api_guide.err_404")
              tr
                td
                  code 429 Too Many Requests
                td
                  = t("drafity.dashboard.api_guide.err_429_before")
                  code Retry-After
                  = t("drafity.dashboard.api_guide.err_429_after")

          p.api-guide-note
            = t("drafity.dashboard.api_guide.footer_note")

- js_i18n = { copied: t("drafity.dashboard.common.copied"), copy: t("drafity.dashboard.common.copy") }.to_json.html_safe
javascript:
  (function() {
    const I18nDash = #{js_i18n};
    const bindCopyButtons = () => {
      document.querySelectorAll('.js-copy-btn').forEach((btn) => {
        if (btn.dataset.initialized === 'true') return;
        btn.dataset.initialized = 'true';
        btn.addEventListener('click', () => {
          const targetId = btn.getAttribute('data-target');
          const codeElement = document.getElementById(targetId);
          if (!codeElement) return;

          navigator.clipboard.writeText(codeElement.textContent).then(() => {
            btn.textContent = I18nDash.copied;
            btn.classList.add('copied');
            setTimeout(() => {
              btn.textContent = I18nDash.copy;
              btn.classList.remove('copied');
            }, 2000);
          }).catch((err) => {
            console.error('Copy failed: ', err);
          });
        });
      });
    };

    document.addEventListener('turbolinks:load', bindCopyButtons);
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', bindCopyButtons);
    } else {
      bindCopyButtons();
    }
  })();
