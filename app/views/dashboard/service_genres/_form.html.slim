- @sub_category_config ||= sub_category_ui_config
- sub_config = @sub_category_config
= form_with scope: :service_genre, url: service_genre.persisted? ? dashboard_service_genre_path(service_genre) : dashboard_service_genres_path, method: service_genre.persisted? ? :patch : :post, local: true do |f|
  - if service_genre.errors.any?
    .form-section
      .service-genre-errors
        p = t("drafity.dashboard.genres.errors_header")
        ul
          - service_genre.errors.full_messages.each do |message|
            li = message

  .form-section
    .form-section__header
      h3.form-section-title = t("drafity.dashboard.genres.basic")
      - unless service_genre.persisted?
        button#genre-ai-suggest-btn.btn.btn-title-suggest.btn-ai-suggest type="button"
          svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
            path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"
          = t("drafity.dashboard.genres.ai_suggest")

    - if acting_as_admin?
      .form-group
        = f.label :client_id, t("drafity.dashboard.labels.client")
        - selected_client_id = service_genre.client_id.presence || ""
        = f.select :client_id, options_for_select([[t("drafity.dashboard.genres.system_shared"), ""]] + Client.order(:email).pluck(:email, :id), selected_client_id), {}, class: "form-control"
        small.form-text = t("drafity.dashboard.genres.client_hint")

    .form-group
      = f.label :key, t("drafity.dashboard.genres.key_label")
      = f.text_field :key, class: "form-control", placeholder: t("drafity.dashboard.genres.ph_key"), readonly: service_genre.persisted?
      small.form-text = t("drafity.dashboard.genres.key_hint")

    .form-group
      = f.label :ja, t("drafity.dashboard.labels.display_name")
      = f.text_field :ja, class: "form-control", placeholder: t("drafity.dashboard.genres.ph_ja")

    .form-group
      = f.label :service_name, t("drafity.dashboard.labels.service_name")
      = f.text_field :service_name, class: "form-control", placeholder: t("drafity.dashboard.genres.ph_service")

    .form-group
      = f.label :strong_points, t("drafity.dashboard.genres.strong_points")
      = f.text_area :strong_points, class: "form-control", rows: 4
      small.form-text = t("drafity.dashboard.genres.strong_hint")

  details.form-section.form-section--collapsible
    summary.form-section-title = t("drafity.dashboard.genres.integration")
    p.sub-categories-intro
      = t("drafity.dashboard.genres.integration_hint")

    .form-group
      = f.label :hosts_text, t("drafity.dashboard.genres.hosts")
      = f.text_area :hosts_text, class: "form-control", rows: 2, value: params.dig(:service_genre, :hosts_text).presence || Array(service_genre.hosts).join("\n"), placeholder: t("drafity.dashboard.genres.ph_hosts")

    .form-group
      = f.label :keywords_text, t("drafity.dashboard.genres.keywords")
      = f.text_area :keywords_text, class: "form-control", rows: 3, value: params.dig(:service_genre, :keywords_text).presence || Array(service_genre.keywords).join("\n"), placeholder: t("drafity.dashboard.genres.ph_optional")
      small.form-text = t("drafity.dashboard.genres.keywords_hint")

  - cta = (params.dig(:service_genre, :column_cta).presence || service_genre.column_cta_for_form).with_indifferent_access
  - by_sub = (cta[:by_sub_genre] || {}).with_indifferent_access
  .form-section
    .form-section__header
      h3.form-section-title = t("drafity.dashboard.genres.cta_section")
    p.sub-categories-intro
      = t("drafity.dashboard.genres.cta_hint")
    .form-group
      = hidden_field_tag "service_genre[column_cta][enabled]", "0", id: nil
      label.checkbox-inline
        = check_box_tag "service_genre[column_cta][enabled]", "1", service_genre.column_cta_enabled?, id: "service_genre_column_cta_enabled"
        = " " + t("drafity.dashboard.genres.cta_show")
    .form-group
      = label_tag "service_genre_column_cta_theme", t("drafity.dashboard.genres.theme")
      = select_tag "service_genre[column_cta][theme]", options_for_select(ColumnServiceCta.theme_options, cta[:theme].presence || "default"), class: "form-control", id: "service_genre_column_cta_theme"
    .form-group
      = label_tag "service_genre_column_cta_badge", t("drafity.dashboard.genres.badge")
      = text_field_tag "service_genre[column_cta][badge]", cta[:badge], class: "form-control", id: "service_genre_column_cta_badge", placeholder: t("drafity.dashboard.genres.ph_badge")
    .form-group
      = label_tag "service_genre_column_cta_title", t("drafity.dashboard.genres.heading")
      = text_field_tag "service_genre[column_cta][title]", cta[:title], class: "form-control", id: "service_genre_column_cta_title", placeholder: t("drafity.dashboard.genres.ph_cta_title")
    .form-group
      = label_tag "service_genre_column_cta_lead", t("drafity.dashboard.genres.lead")
      = text_area_tag "service_genre[column_cta][lead]", cta[:lead], class: "form-control", id: "service_genre_column_cta_lead", rows: 3
    .form-group
      = label_tag "service_genre_column_cta_cta_label", t("drafity.dashboard.genres.button_label")
      = text_field_tag "service_genre[column_cta][cta_label]", cta[:cta_label], class: "form-control", id: "service_genre_column_cta_cta_label", placeholder: t("drafity.dashboard.genres.ph_cta_button")
    - cta_en = (cta[:en] || {}).with_indifferent_access
    p.sub-categories-intro
      = t("drafity.dashboard.genres.cta_en_hint")
    .form-group
      = label_tag "service_genre_column_cta_en_title", t("drafity.dashboard.genres.heading_en")
      = text_field_tag "service_genre[column_cta][en][title]", cta_en[:title], class: "form-control", id: "service_genre_column_cta_en_title", placeholder: t("drafity.dashboard.genres.ph_cta_title_en")
    .form-group
      = label_tag "service_genre_column_cta_en_lead", t("drafity.dashboard.genres.lead_en")
      = text_area_tag "service_genre[column_cta][en][lead]", cta_en[:lead], class: "form-control", id: "service_genre_column_cta_en_lead", rows: 3
    .form-group
      = label_tag "service_genre_column_cta_en_cta_label", t("drafity.dashboard.genres.button_label_en")
      = text_field_tag "service_genre[column_cta][en][cta_label]", cta_en[:cta_label], class: "form-control", id: "service_genre_column_cta_en_cta_label", placeholder: t("drafity.dashboard.genres.ph_cta_button_en")
    .form-group
      = label_tag "service_genre_column_cta_en_badge", t("drafity.dashboard.genres.badge_en")
      = text_field_tag "service_genre[column_cta][en][badge]", cta_en[:badge], class: "form-control", id: "service_genre_column_cta_en_badge"
    .form-group
      = label_tag "service_genre_column_cta_path", t("drafity.dashboard.genres.path")
      = text_field_tag "service_genre[column_cta][path]", cta[:path], class: "form-control", id: "service_genre_column_cta_path", placeholder: t("drafity.dashboard.genres.ph_path")
      small.form-text = t("drafity.dashboard.genres.path_hint")
    .form-group
      = label_tag "service_genre_column_cta_url", t("drafity.dashboard.genres.external_url")
      = text_field_tag "service_genre[column_cta][url]", cta[:url], class: "form-control", id: "service_genre_column_cta_url", placeholder: t("drafity.dashboard.genres.ph_url")
      small.form-text = t("drafity.dashboard.genres.external_hint")

    - sub_keys = service_genre.sub_categories_for_form.map { |item| item[:key] }.reject(&:blank?)
    - sub_keys |= by_sub.keys.map(&:to_s)
    - if sub_keys.any?
      details.form-section.form-section--collapsible style="margin-top: 12px;"
        summary.form-section-title = t("drafity.dashboard.genres.sub_override")
        p.sub-categories-intro
          = t("drafity.dashboard.genres.sub_override_hint")
        - sub_keys.uniq.each do |sub_key|
          - sub_cta = (by_sub[sub_key] || {}).with_indifferent_access
          - sub_name = service_genre.sub_categories_for_form.find { |item| item[:key].to_s == sub_key.to_s }&.dig(:name)
          .form-group style="padding: 12px; border: 1px solid #e2e8f0; border-radius: 10px; margin-bottom: 12px;"
            strong = "#{sub_key}#{sub_name.present? ? " (#{sub_name})" : ""}"
            = label_tag nil, t("drafity.dashboard.genres.theme"), style: "display:block;margin-top:8px;"
            = select_tag "service_genre[column_cta][by_sub_genre][#{sub_key}][theme]", options_for_select([[t("drafity.dashboard.genres.theme_same"), ""]] + ColumnServiceCta.theme_options, sub_cta[:theme]), class: "form-control"
            = label_tag nil, t("drafity.dashboard.genres.badge"), style: "display:block;margin-top:8px;"
            = text_field_tag "service_genre[column_cta][by_sub_genre][#{sub_key}][badge]", sub_cta[:badge], class: "form-control"
            = label_tag nil, t("drafity.dashboard.genres.heading"), style: "display:block;margin-top:8px;"
            = text_field_tag "service_genre[column_cta][by_sub_genre][#{sub_key}][title]", sub_cta[:title], class: "form-control"
            = label_tag nil, t("drafity.dashboard.genres.lead"), style: "display:block;margin-top:8px;"
            = text_area_tag "service_genre[column_cta][by_sub_genre][#{sub_key}][lead]", sub_cta[:lead], class: "form-control", rows: 2
            = label_tag nil, t("drafity.dashboard.genres.button_label"), style: "display:block;margin-top:8px;"
            = text_field_tag "service_genre[column_cta][by_sub_genre][#{sub_key}][cta_label]", sub_cta[:cta_label], class: "form-control"
            = label_tag nil, t("drafity.dashboard.genres.path_short"), style: "display:block;margin-top:8px;"
            = text_field_tag "service_genre[column_cta][by_sub_genre][#{sub_key}][path]", sub_cta[:path], class: "form-control"
            = label_tag nil, t("drafity.dashboard.genres.url_short"), style: "display:block;margin-top:8px;"
            = text_field_tag "service_genre[column_cta][by_sub_genre][#{sub_key}][url]", sub_cta[:url], class: "form-control"

  - if sub_config[:allowed]
    .form-section
      h3.form-section-title = t("drafity.dashboard.genres.subcategories")
      p.sub-categories-intro
        = t("drafity.dashboard.genres.sub_hint")
        - unless sub_config[:unlimited]
          = t("drafity.dashboard.genres.sub_plan_max", max: sub_config[:max])

      .sub-categories-toolbar
        button#suggest-sub-categories.btn.btn-title-suggest.btn-ai-suggest type="button" style="color:#ffffff;background:linear-gradient(135deg,#4f46e5 0%,#7c3aed 100%);border:none;font-weight:600;box-shadow:0 4px 12px rgba(124,58,237,0.2);"
          svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
            path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"
          = t("drafity.dashboard.genres.sub_ai")
        label.sub-categories-toolbar__count
          span = t("drafity.dashboard.genres.suggest_count")
          input#sub-category-suggestion-count type="number" value=sub_config[:default] min="1" max=(sub_config[:unlimited] ? 10 : sub_config[:max])
        small.form-text.sub-categories-toolbar__hint
          = t("drafity.dashboard.genres.sub_ai_hint")

      #sub-category-suggest-status.sub-category-suggest-status hidden=true

      #sub-categories-list.sub-categories-list
        - service_genre_sub_category_items(service_genre).each do |item|
          = render "sub_category_fields", item: item

      button#add-sub-category.btn.btn-secondary type="button" = t("drafity.dashboard.genres.add_sub")

      template#sub-category-template
        = render "sub_category_fields", item: {}
  - elsif client_signed_in? && !acting_as_admin?
    .form-section
      p.sub-categories-intro
        = t("drafity.dashboard.genres.sub_unavailable")

  .form-actions
    = f.submit submit_label, class: "btn btn-primary"
    = link_to t("drafity.dashboard.common.back_to_list"), dashboard_service_genres_path, class: "btn btn-secondary"

- unless service_genre.persisted?
  - if sub_config[:allowed]
    = render "genre_draft_modal", sub_config: sub_config
  - else
    = render "genre_draft_plan_notice_modal"

ruby:
  js_i18n = {
    needService: t("drafity.dashboard.genres.js_need_service"),
    suggesting: t("drafity.dashboard.genres.js_suggesting"),
    suggestFailed: t("drafity.dashboard.genres.js_suggest_failed"),
    network: t("drafity.dashboard.genres.js_network"),
    newSub: t("drafity.dashboard.genres.js_new_sub"),
    needAny: t("drafity.dashboard.genres.js_need_any"),
    needDisplay: t("drafity.dashboard.genres.js_need_display"),
    subGenerating: t("drafity.dashboard.genres.js_sub_generating"),
    parseError: t("drafity.dashboard.genres.js_parse_error"),
    subFailed: t("drafity.dashboard.genres.js_sub_failed"),
    subDone: t("drafity.dashboard.genres.js_sub_done", count: "%{count}"),
    timeout: t("drafity.dashboard.genres.js_timeout"),
    retryNetwork: t("drafity.dashboard.genres.js_retry_network")
  }.to_json.html_safe
javascript:
  (function() {
    const I18nDash = #{js_i18n};
    const i18nFmt = (template, vars) => String(template).replace(/%\{(\w+)\}/g, (_, k) => (vars && vars[k] != null ? vars[k] : ''));

    const suggestUrl = "#{suggest_sub_categories_dashboard_service_genres_path}";
    const quickSetupUrl = "#{quick_setup_dashboard_service_genres_path}";
    const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content;
    const subCategoriesAllowed = #{@sub_category_config[:allowed] ? 'true' : 'false'};

    const readFormValue = (name) => {
      const field = document.querySelector(`[name="service_genre[${name}]"]`);
      return field ? field.value.trim() : '';
    };

    const setFormValue = (name, value) => {
      const field = document.querySelector(`[name="service_genre[${name}]"]`);
      if (!field) return;
      field.value = value || '';
    };

    const applyDraftToForm = (draft) => {
      setFormValue('key', draft.key);
      setFormValue('ja', draft.ja);
      setFormValue('service_name', draft.service_name);
      setFormValue('strong_points', draft.strong_points);
      if (draft.keywords?.length) {
        setFormValue('keywords_text', draft.keywords.join('\n'));
      }

      if (subCategoriesAllowed && draft.sub_categories?.length) {
        const list = document.getElementById('sub-categories-list');
        const template = document.getElementById('sub-category-template');
        if (list && template) {
          list.innerHTML = '';
          draft.sub_categories.forEach((item, index) => {
            const node = template.content.cloneNode(true);
            list.appendChild(node);
            const row = list.lastElementChild;
            if (!row) return;
            const set = (selector, value) => {
              const field = row.querySelector(selector);
              if (field) field.value = value || '';
            };
            set('input[name*="[key]"]', item.key);
            set('input[name$="[name]"]', item.name);
            set('input[name*="[target]"]', item.target);
            set('textarea[name*="[description]"]', item.description);
            set('textarea[name*="[features_text]"]', item.features_text);
            set('textarea[name*="[keywords_text]"]', item.keywords_text);
            set('input[name*="[price_hint]"]', item.price_hint);
            set('input[name*="[area]"]', item.area);
            set('textarea[name*="[strengths]"]', item.strengths);
            set('textarea[name*="[industry_weakness]"]', item.industry_weakness);
            row.classList.toggle('is-open', index === 0);
          });
        }
      }
    };

    const initGenreDraftModal = () => {
      const btn = document.getElementById('genre-draft-generate-btn');
      const status = document.getElementById('genre-draft-status');
      if (!btn || btn.dataset.initialized === 'true') return;

      btn.dataset.initialized = 'true';
      btn.addEventListener('click', async () => {
        const serviceName = document.getElementById('genre-draft-service-name')?.value.trim();
        const strongPoints = document.getElementById('genre-draft-strong-points')?.value.trim();

        if (!serviceName && !strongPoints) {
          if (status) {
            status.hidden = false;
            status.textContent = I18nDash.needService;
            status.className = 'genre-quick-setup-status genre-quick-setup-status--error';
          }
          return;
        }

        btn.disabled = true;
        if (status) {
          status.hidden = false;
          status.textContent = I18nDash.suggesting;
          status.className = 'genre-quick-setup-status genre-quick-setup-status--loading';
        }

        try {
          const response = await fetch(quickSetupUrl, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'X-CSRF-Token': csrfToken,
              'Accept': 'application/json'
            },
            body: JSON.stringify({ service_name: serviceName, strong_points: strongPoints })
          });
          const result = await response.json();
          if (!response.ok || !result.success) {
            if (status) {
              status.textContent = result.error || I18nDash.suggestFailed;
              status.className = 'genre-quick-setup-status genre-quick-setup-status--error';
            }
            return;
          }

          applyDraftToForm(result.draft);
          closeGenreDraftModal();
        } catch (error) {
          if (status) {
            status.textContent = I18nDash.network;
            status.className = 'genre-quick-setup-status genre-quick-setup-status--error';
          }
        } finally {
          btn.disabled = false;
        }
      });
    };

    const showModal = (modal) => {
      if (!modal) return;
      document.body.appendChild(modal);
      modal.style.display = 'flex';
      document.body.classList.add('modal-open');
    };

    const hideModal = (modal) => {
      if (!modal) return;
      modal.style.display = 'none';
      const otherOpen = ['genre-draft-modal', 'genre-draft-plan-notice-modal']
        .map((id) => document.getElementById(id))
        .some((el) => el && el !== modal && el.style.display === 'flex');
      if (!otherOpen) document.body.classList.remove('modal-open');
    };

    const bindOverlayDismiss = (modal, closeFn) => {
      if (!modal || modal.dataset.overlayBound === 'true') return;
      modal.dataset.overlayBound = 'true';
      modal.addEventListener('click', (event) => {
        if (event.target === modal) closeFn();
      });
    };

    window.openGenreDraftModal = () => {
      initGenreDraftModal();
      const status = document.getElementById('genre-draft-status');
      if (status) status.hidden = true;
      const modal = document.getElementById('genre-draft-modal');
      bindOverlayDismiss(modal, window.closeGenreDraftModal);
      showModal(modal);
    };

    window.closeGenreDraftModal = () => {
      hideModal(document.getElementById('genre-draft-modal'));
    };

    window.openGenreDraftPlanNoticeModal = () => {
      const modal = document.getElementById('genre-draft-plan-notice-modal');
      bindOverlayDismiss(modal, window.closeGenreDraftPlanNoticeModal);
      showModal(modal);
    };

    window.closeGenreDraftPlanNoticeModal = () => {
      hideModal(document.getElementById('genre-draft-plan-notice-modal'));
    };

    window.handleGenreAiSuggestClick = () => {
      if (subCategoriesAllowed) {
        window.openGenreDraftModal();
      } else {
        window.openGenreDraftPlanNoticeModal();
      }
    };

    const bindGenreAiSuggestButton = () => {
      const btn = document.getElementById('genre-ai-suggest-btn');
      if (!btn || btn.dataset.initialized === 'true') return;
      btn.dataset.initialized = 'true';
      btn.addEventListener('click', (event) => {
        event.preventDefault();
        event.stopPropagation();
        window.handleGenreAiSuggestClick();
      });
    };

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        closeGenreDraftModal();
        closeGenreDraftPlanNoticeModal();
      }
    });

    const initSubCategories = () => {
      const list = document.getElementById('sub-categories-list');
      const addBtn = document.getElementById('add-sub-category');
      const template = document.getElementById('sub-category-template');
      const suggestBtn = document.getElementById('suggest-sub-categories');
      const suggestStatus = document.getElementById('sub-category-suggest-status');
      if (!list || !addBtn || !template) return;

      if (list.dataset.initialized === 'true') return;
      list.dataset.initialized = 'true';

      const syncHeaderState = (item, open) => {
        const header = item.querySelector('.sub-category-item__header');
        if (!header) return;
        header.setAttribute('aria-expanded', open ? 'true' : 'false');
      };

      const setOpen = (item, open) => {
        item.classList.toggle('is-open', open);
        syncHeaderState(item, open);
      };

      const updateTitles = () => {
        list.querySelectorAll('.sub-category-item').forEach((item) => {
          const nameInput = item.querySelector('input[name$="[name]"]');
          const title = item.querySelector('.sub-category-item__title');
          if (!title || !nameInput) return;
          title.textContent = nameInput.value.trim() || I18nDash.newSub;
        });
      };

      const setFieldValue = (item, selector, value) => {
        const field = item.querySelector(selector);
        if (!field) return;
        field.value = value || '';
      };

      const appendSubCategoryItem = (data, open = true) => {
        const node = template.content.cloneNode(true);
        list.appendChild(node);
        const item = list.lastElementChild;
        if (!item) return;

        setFieldValue(item, 'input[name*="[key]"]', data.key);
        setFieldValue(item, 'input[name$="[name]"]', data.name);
        setFieldValue(item, 'input[name*="[target]"]', data.target);
        setFieldValue(item, 'textarea[name*="[description]"]', data.description);
        setFieldValue(item, 'textarea[name*="[features_text]"]', data.features_text);
        setFieldValue(item, 'textarea[name*="[keywords_text]"]', data.keywords_text);
        setFieldValue(item, 'input[name*="[price_hint]"]', data.price_hint);
        setFieldValue(item, 'input[name*="[area]"]', data.area);
        setFieldValue(item, 'textarea[name*="[strengths]"]', data.strengths);
        setFieldValue(item, 'textarea[name*="[industry_weakness]"]', data.industry_weakness);

        setOpen(item, open);
      };

      const showSuggestStatus = (message, type = 'info') => {
        if (!suggestStatus) return;
        suggestStatus.hidden = false;
        suggestStatus.textContent = message;
        suggestStatus.className = `sub-category-suggest-status sub-category-suggest-status--${type}`;
      };

      addBtn.addEventListener('click', () => {
        appendSubCategoryItem({}, true);
        updateTitles();
      });

      if (suggestBtn) {
        let suggestInFlight = false;
        const SUGGEST_TIMEOUT_MS = 60000;

        const resetSuggestButton = () => {
          suggestInFlight = false;
          suggestBtn.disabled = false;
          if (suggestStatus && suggestStatus.classList.contains('sub-category-suggest-status--loading')) {
            suggestStatus.hidden = true;
            suggestStatus.textContent = '';
          }
        };

        suggestBtn.addEventListener('click', async (event) => {
          event.preventDefault();
          event.stopPropagation();
          if (suggestInFlight) return;

          const key = readFormValue('key');
          const ja = readFormValue('ja');
          const serviceName = readFormValue('service_name');
          const strongPoints = readFormValue('strong_points');
          const keywords = readFormValue('keywords_text');
          const suggestionCount = document.getElementById('sub-category-suggestion-count')?.value || '1';

          if (!key && !serviceName && !ja) {
            showSuggestStatus(I18nDash.needAny, 'error');
            return;
          }

          if (!strongPoints && !ja && !serviceName) {
            showSuggestStatus(I18nDash.needDisplay, 'error');
            return;
          }

          suggestInFlight = true;
          suggestBtn.disabled = true;
          showSuggestStatus(I18nDash.subGenerating, 'loading');

          const controller = new AbortController();
          const timeoutId = window.setTimeout(() => controller.abort(), SUGGEST_TIMEOUT_MS);

          try {
            const response = await fetch(suggestUrl, {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                'X-CSRF-Token': csrfToken,
                'Accept': 'application/json'
              },
              body: JSON.stringify({
                key,
                ja,
                service_name: serviceName,
                strong_points: strongPoints,
                keywords,
                suggestion_count: suggestionCount
              }),
              signal: controller.signal
            });

            const result = await response.json().catch(() => null);
            if (!result) {
              showSuggestStatus(I18nDash.parseError, 'error');
              return;
            }
            if (!response.ok || !result.success) {
              showSuggestStatus(result.error || I18nDash.subFailed, 'error');
              return;
            }

            list.innerHTML = '';
            result.sub_categories.forEach((item, index) => {
              appendSubCategoryItem(item, index === 0);
            });
            updateTitles();
            showSuggestStatus(i18nFmt(I18nDash.subDone, { count: result.sub_categories.length }), 'success');
          } catch (error) {
            if (error && error.name === 'AbortError') {
              showSuggestStatus(I18nDash.timeout, 'error');
            } else {
              showSuggestStatus(I18nDash.retryNetwork, 'error');
            }
          } finally {
            window.clearTimeout(timeoutId);
            resetSuggestButton();
          }
        });

        document.addEventListener('turbolinks:before-cache', resetSuggestButton);
      }

      list.addEventListener('click', (event) => {
        const removeBtn = event.target.closest('.sub-category-remove');
        if (removeBtn) {
          event.stopPropagation();
          removeBtn.closest('.sub-category-item')?.remove();
          return;
        }

        const header = event.target.closest('.sub-category-item__header');
        if (!header) return;

        const item = header.closest('.sub-category-item');
        if (!item) return;
        setOpen(item, !item.classList.contains('is-open'));
      });

      list.addEventListener('keydown', (event) => {
        if (event.key !== 'Enter' && event.key !== ' ') return;
        const header = event.target.closest('.sub-category-item__header');
        if (!header) return;
        event.preventDefault();
        const item = header.closest('.sub-category-item');
        if (!item) return;
        setOpen(item, !item.classList.contains('is-open'));
      });

      list.addEventListener('input', (event) => {
        if (event.target.matches('input[name$="[name]"]')) {
          updateTitles();
        }
      });

      updateTitles();
    };

    const boot = () => {
      initGenreDraftModal();
      initSubCategories();
      bindGenreAiSuggestButton();
    };

    document.addEventListener('turbolinks:load', boot);
    document.addEventListener('DOMContentLoaded', boot);
    boot();
  })();
