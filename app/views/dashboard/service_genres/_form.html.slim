= form_with scope: :service_genre, url: service_genre.persisted? ? dashboard_service_genre_path(service_genre) : dashboard_service_genres_path, method: service_genre.persisted? ? :patch : :post, local: true do |f|
  - @sub_category_config ||= sub_category_ui_config
  - sub_config = @sub_category_config
  - if service_genre.errors.any?
    .form-section
      .service-genre-errors
        p 入力内容を確認してください
        ul
          - service_genre.errors.full_messages.each do |message|
            li = message

  .form-section
    .form-section__header
      h3.form-section-title 基本情報
      - unless service_genre.persisted?
        button.btn.btn-title-suggest.btn-ai-suggest type="button" onclick="handleGenreAiSuggestClick()"
          svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
            path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"
          | AI提案

    - if admin_signed_in?
      .form-group
        = f.label :client_id, "クライアント"
        - selected_client_id = service_genre.client_id.presence || ""
        = f.select :client_id, options_for_select([["システム共通", ""]] + Client.order(:email).map { |c| [c.email, c.id] }, selected_client_id), {}, class: "form-control"
        small.form-text 未選択の場合は Admin 全体で利用するジャンルです。Client を選ぶと API 許可ジャンルにも自動追加されます。

    .form-group
      = f.label :key, "キー（英小文字・URL用）"
      = f.text_field :key, class: "form-control", placeholder: "例: my_service", readonly: service_genre.persisted?
      small.form-text 記事の genre 値として使用されます。作成後は変更できません。

    .form-group
      = f.label :ja, "表示名（日本語）"
      = f.text_field :ja, class: "form-control", placeholder: "例: 経営コンサル"

    .form-group
      = f.label :service_name, "サービス名"
      = f.text_field :service_name, class: "form-control", placeholder: "例: 株式会社リプラス"

    .form-group
      = f.label :strong_points, "強み・訴求ポイント"
      = f.text_area :strong_points, class: "form-control", rows: 4
      small.form-text 親記事・子記事生成時に AI へ渡される訴求情報です。

  details.form-section.form-section--collapsible
    summary.form-section-title 連携設定（任意）
    p.sub-categories-intro
      | 記事生成のみの場合は空欄のままで問題ありません。保存時にアクセス中のドメインが自動で登録されます。

    .form-group
      = f.label :hosts_text, "ホスト（ドメイン）"
      = f.text_area :hosts_text, class: "form-control", rows: 2, value: params.dig(:service_genre, :hosts_text).presence || Array(service_genre.hosts).join("\n"), placeholder: "空欄可（自動登録）"

    .form-group
      = f.label :keywords_text, "キーワード"
      = f.text_area :keywords_text, class: "form-control", rows: 3, value: params.dig(:service_genre, :keywords_text).presence || Array(service_genre.keywords).join("\n"), placeholder: "空欄可"
      small.form-text AIタイトル提案・記事生成の参考に使われます。

  - if sub_config[:allowed]
    .form-section
      h3.form-section-title 中分類
      p.sub-categories-intro
        | 記事作成時の中分類プルダウンと、親記事・子記事の生成内容の参考情報として使われます。
        - unless sub_config[:unlimited]
          | お使いのプランでは最大#{sub_config[:max]}件まで登録できます。

      .sub-categories-toolbar
        button#suggest-sub-categories.btn.btn-title-suggest type="button"
          | AIで中分類を提案
        label.sub-categories-toolbar__count
          span 提案数
          input#sub-category-suggestion-count type="number" value=sub_config[:default] min="1" max=(sub_config[:unlimited] ? 10 : sub_config[:max])
        small.form-text.sub-categories-toolbar__hint
          | キー・表示名・訴求ポイントから中分類を自動生成します。実行すると既存の中分類は置き換わります。

      #sub-category-suggest-status.sub-category-suggest-status hidden=true

      #sub-categories-list.sub-categories-list
        - service_genre_sub_category_items(service_genre).each do |item|
          = render "sub_category_fields", item: item

      button#add-sub-category.btn.btn-secondary type="button" + 中分類を追加

      template#sub-category-template
        = render "sub_category_fields", item: {}
  - elsif client_signed_in? && !admin_signed_in?
    .form-section
      p.sub-categories-intro
        | お使いのプランでは中分類は利用できません。大ジャンルの訴求ポイントが記事生成に使われます。中分類が必要な場合はスタンダードプラン以上をご検討ください。

  .form-actions
    = f.submit submit_label, class: "btn btn-primary"
    = link_to "一覧に戻る", dashboard_service_genres_path, class: "btn btn-secondary"

  - unless service_genre.persisted?
    - if sub_config[:allowed]
      = render "genre_draft_modal", sub_config: sub_config
    - else
      = render "genre_draft_plan_notice_modal"

javascript:
  (function() {
    const suggestUrl = "#{suggest_sub_categories_dashboard_service_genres_path}";
    const quickSetupUrl = "#{quick_setup_dashboard_service_genres_path}";
    const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content;
    const subCategoriesAllowed = #{@sub_category_config[:allowed] ? 'true' : 'false'};

    const readFormValue = (name) => {
      const field = document.querySelector(`[name="service_genre[${name}]"]`);
      return field ? field.value.trim() : '';
    };

    const setFormValue = (name, value) => {
      const field = document.querySelector(`[name="service_genre[${name}]"]`);
      if (!field) return;
      field.value = value || '';
    };

    const applyDraftToForm = (draft) => {
      setFormValue('key', draft.key);
      setFormValue('ja', draft.ja);
      setFormValue('service_name', draft.service_name);
      setFormValue('strong_points', draft.strong_points);
      if (draft.keywords?.length) {
        setFormValue('keywords_text', draft.keywords.join('\n'));
      }

      if (subCategoriesAllowed && draft.sub_categories?.length) {
        const list = document.getElementById('sub-categories-list');
        const template = document.getElementById('sub-category-template');
        if (list && template) {
          list.innerHTML = '';
          draft.sub_categories.forEach((item, index) => {
            const node = template.content.cloneNode(true);
            list.appendChild(node);
            const row = list.lastElementChild;
            if (!row) return;
            const set = (selector, value) => {
              const field = row.querySelector(selector);
              if (field) field.value = value || '';
            };
            set('input[name*="[key]"]', item.key);
            set('input[name*="[name]"]', item.name);
            set('input[name*="[target]"]', item.target);
            set('textarea[name*="[description]"]', item.description);
            set('textarea[name*="[features_text]"]', item.features_text);
            set('textarea[name*="[keywords_text]"]', item.keywords_text);
            set('input[name*="[price_hint]"]', item.price_hint);
            set('input[name*="[area]"]', item.area);
            set('textarea[name*="[strengths]"]', item.strengths);
            set('textarea[name*="[industry_weakness]"]', item.industry_weakness);
            row.classList.toggle('is-open', index === 0);
          });
        }
      }
    };

    const initGenreDraftModal = () => {
      const btn = document.getElementById('genre-draft-generate-btn');
      const status = document.getElementById('genre-draft-status');
      if (!btn || btn.dataset.initialized === 'true') return;

      btn.dataset.initialized = 'true';
      btn.addEventListener('click', async () => {
        const serviceName = document.getElementById('genre-draft-service-name')?.value.trim();
        const strongPoints = document.getElementById('genre-draft-strong-points')?.value.trim();

        if (!serviceName && !strongPoints) {
          if (status) {
            status.hidden = false;
            status.textContent = 'サービス名または訴求ポイントを入力してください。';
            status.className = 'genre-quick-setup-status genre-quick-setup-status--error';
          }
          return;
        }

        btn.disabled = true;
        if (status) {
          status.hidden = false;
          status.textContent = 'AIがジャンルを提案しています…';
          status.className = 'genre-quick-setup-status genre-quick-setup-status--loading';
        }

        try {
          const response = await fetch(quickSetupUrl, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'X-CSRF-Token': csrfToken,
              'Accept': 'application/json'
            },
            body: JSON.stringify({ service_name: serviceName, strong_points: strongPoints })
          });
          const result = await response.json();
          if (!response.ok || !result.success) {
            if (status) {
              status.textContent = result.error || '提案の生成に失敗しました。';
              status.className = 'genre-quick-setup-status genre-quick-setup-status--error';
            }
            return;
          }

          applyDraftToForm(result.draft);
          closeGenreDraftModal();
        } catch (error) {
          if (status) {
            status.textContent = '通信エラーが発生しました。';
            status.className = 'genre-quick-setup-status genre-quick-setup-status--error';
          }
        } finally {
          btn.disabled = false;
        }
      });
    };

    window.openGenreDraftModal = () => {
      initGenreDraftModal();
      const status = document.getElementById('genre-draft-status');
      if (status) status.hidden = true;
      const modal = document.getElementById('genre-draft-modal');
      if (modal) modal.style.display = 'flex';
    };

    window.closeGenreDraftModal = () => {
      const modal = document.getElementById('genre-draft-modal');
      if (modal) modal.style.display = 'none';
    };

    window.openGenreDraftPlanNoticeModal = () => {
      const modal = document.getElementById('genre-draft-plan-notice-modal');
      if (modal) modal.style.display = 'flex';
    };

    window.closeGenreDraftPlanNoticeModal = () => {
      const modal = document.getElementById('genre-draft-plan-notice-modal');
      if (modal) modal.style.display = 'none';
    };

    window.handleGenreAiSuggestClick = () => {
      if (subCategoriesAllowed) {
        openGenreDraftModal();
      } else {
        openGenreDraftPlanNoticeModal();
      }
    };

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        closeGenreDraftModal();
        closeGenreDraftPlanNoticeModal();
      }
    });

    const initSubCategories = () => {
      const list = document.getElementById('sub-categories-list');
      const addBtn = document.getElementById('add-sub-category');
      const template = document.getElementById('sub-category-template');
      const suggestBtn = document.getElementById('suggest-sub-categories');
      const suggestStatus = document.getElementById('sub-category-suggest-status');
      if (!list || !addBtn || !template) return;

      if (list.dataset.initialized === 'true') return;
      list.dataset.initialized = 'true';

      const syncHeaderState = (item, open) => {
        const header = item.querySelector('.sub-category-item__header');
        if (!header) return;
        header.setAttribute('aria-expanded', open ? 'true' : 'false');
      };

      const setOpen = (item, open) => {
        item.classList.toggle('is-open', open);
        syncHeaderState(item, open);
      };

      const updateTitles = () => {
        list.querySelectorAll('.sub-category-item').forEach((item) => {
          const nameInput = item.querySelector('input[name*="[name]"]');
          const title = item.querySelector('.sub-category-item__title');
          if (!title || !nameInput) return;
          title.textContent = nameInput.value.trim() || '新しい中分類';
        });
      };

      const setFieldValue = (item, selector, value) => {
        const field = item.querySelector(selector);
        if (!field) return;
        field.value = value || '';
      };

      const appendSubCategoryItem = (data, open = true) => {
        const node = template.content.cloneNode(true);
        list.appendChild(node);
        const item = list.lastElementChild;
        if (!item) return;

        setFieldValue(item, 'input[name*="[key]"]', data.key);
        setFieldValue(item, 'input[name*="[name]"]', data.name);
        setFieldValue(item, 'input[name*="[target]"]', data.target);
        setFieldValue(item, 'textarea[name*="[description]"]', data.description);
        setFieldValue(item, 'textarea[name*="[features_text]"]', data.features_text);
        setFieldValue(item, 'textarea[name*="[keywords_text]"]', data.keywords_text);
        setFieldValue(item, 'input[name*="[price_hint]"]', data.price_hint);
        setFieldValue(item, 'input[name*="[area]"]', data.area);
        setFieldValue(item, 'textarea[name*="[strengths]"]', data.strengths);
        setFieldValue(item, 'textarea[name*="[industry_weakness]"]', data.industry_weakness);

        setOpen(item, open);
      };

      const showSuggestStatus = (message, type = 'info') => {
        if (!suggestStatus) return;
        suggestStatus.hidden = false;
        suggestStatus.textContent = message;
        suggestStatus.className = `sub-category-suggest-status sub-category-suggest-status--${type}`;
      };

      addBtn.addEventListener('click', () => {
        appendSubCategoryItem({}, true);
        updateTitles();
      });

      if (suggestBtn) {
        suggestBtn.addEventListener('click', async () => {
          const key = readFormValue('key');
          const ja = readFormValue('ja');
          const serviceName = readFormValue('service_name');
          const strongPoints = readFormValue('strong_points');
          const keywords = readFormValue('keywords_text');
          const suggestionCount = document.getElementById('sub-category-suggestion-count')?.value || '1';

          if (!key && !serviceName && !ja) {
            showSuggestStatus('キー・表示名・サービス名のいずれかを入力してください。', 'error');
            return;
          }

          if (!strongPoints && !ja && !serviceName) {
            showSuggestStatus('表示名・サービス名・訴求ポイントのいずれかを入力してください。', 'error');
            return;
          }

          const hasExisting = list.querySelectorAll('.sub-category-item').length > 0;
          if (hasExisting && !window.confirm('既存の中分類をAI提案で置き換えます。よろしいですか？')) {
            return;
          }

          suggestBtn.disabled = true;
          showSuggestStatus('AIが中分類を生成しています…', 'loading');

          try {
            const response = await fetch(suggestUrl, {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                'X-CSRF-Token': csrfToken,
                'Accept': 'application/json'
              },
              body: JSON.stringify({
                key,
                ja,
                service_name: serviceName,
                strong_points: strongPoints,
                keywords,
                suggestion_count: suggestionCount
              })
            });

            const result = await response.json();
            if (!response.ok || !result.success) {
              showSuggestStatus(result.error || '中分類の生成に失敗しました。', 'error');
              return;
            }

            list.innerHTML = '';
            result.sub_categories.forEach((item, index) => {
              appendSubCategoryItem(item, index === 0);
            });
            updateTitles();
            showSuggestStatus(`${result.sub_categories.length}件の中分類を提案しました。内容を確認して保存してください。`, 'success');
          } catch (error) {
            showSuggestStatus('通信エラーが発生しました。時間をおいて再度お試しください。', 'error');
          } finally {
            suggestBtn.disabled = false;
          }
        });
      }

      list.addEventListener('click', (event) => {
        const removeBtn = event.target.closest('.sub-category-remove');
        if (removeBtn) {
          event.stopPropagation();
          removeBtn.closest('.sub-category-item')?.remove();
          return;
        }

        const header = event.target.closest('.sub-category-item__header');
        if (!header) return;

        const item = header.closest('.sub-category-item');
        if (!item) return;
        setOpen(item, !item.classList.contains('is-open'));
      });

      list.addEventListener('keydown', (event) => {
        if (event.key !== 'Enter' && event.key !== ' ') return;
        const header = event.target.closest('.sub-category-item__header');
        if (!header) return;
        event.preventDefault();
        const item = header.closest('.sub-category-item');
        if (!item) return;
        setOpen(item, !item.classList.contains('is-open'));
      });

      list.addEventListener('input', (event) => {
        if (event.target.matches('input[name*="[name]"]')) {
          updateTitles();
        }
      });

      updateTitles();
    };

    const boot = () => {
      initGenreDraftModal();
      initSubCategories();
    };

    document.addEventListener('turbolinks:load', boot);
    document.addEventListener('DOMContentLoaded', boot);
    boot();
  })();
