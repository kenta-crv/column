.container-fluid.py-4
  .api-settings-page.service-genres-page
    .api-settings-header
      .service-genres-header-row
        div
          h1.api-settings-title = t("drafity.dashboard.genres.title")
          p.api-settings-subtitle = t("drafity.dashboard.genres.subtitle")
        = link_to t("drafity.dashboard.genres.new"), new_dashboard_service_genre_path, class: "btn btn-primary btn-sm"

    .api-settings-card
      .api-settings-card__body
        - if @service_genres.present?
          .management-table-wrap
            table.management-table.service-genres-table
              thead
                tr
                  th = t("drafity.dashboard.labels.key")
                  th = t("drafity.dashboard.labels.display_name")
                  th = t("drafity.dashboard.labels.service_name")
                  - if acting_as_admin?
                    th = t("drafity.dashboard.labels.client")
                  th = t("drafity.dashboard.labels.sub_count")
                  th CTA
                  th = t("drafity.dashboard.labels.actions")
              tbody
                - @service_genres.each do |genre|
                  tr
                    td
                      code.genre-key = genre.key
                    td
                      strong = genre.display_name
                    td = genre.service_name.presence || "—"
                    - if acting_as_admin?
                      td
                        - if genre.client_id.present?
                          span = genre.client&.email || "Client ##{genre.client_id}"
                        - else
                          span.empty-text = t("drafity.dashboard.common.system")
                    td = t("drafity.dashboard.common.count_items", count: genre.sub_categories_count)
                    td
                      - cta_state = genre.column_cta_index_state
                      - if cta_state[:enabled] && cta_state[:title_present]
                        span.status-badge.status-active = t("drafity.dashboard.genres.cta_active")
                      - elsif cta_state[:enabled]
                        span.status-badge.status-warning = t("drafity.dashboard.genres.cta_needed")
                      - else
                        span.status-badge.status-inactive = t("drafity.dashboard.genres.cta_off")
                    td style="white-space: nowrap; width: 1%;"
                      .service-genres-actions
                        = link_to edit_dashboard_service_genre_path(genre), class: "icon-action-btn icon-action-btn--edit", title: t("drafity.dashboard.common.edit") do
                          svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                            path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"
                            path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"
                        = link_to dashboard_service_genre_path(genre), method: :delete, data: { confirm: t("drafity.dashboard.genres.confirm_delete", name: genre.display_name) }, class: "icon-action-btn icon-action-btn--delete", title: t("drafity.dashboard.common.delete") do
                          svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                            polyline points="3 6 5 6 21 6"
                            path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"
        - else
          .service-genres-empty
            p = t("drafity.dashboard.genres.empty")
            = link_to t("drafity.dashboard.genres.create_first"), new_dashboard_service_genre_path, class: "btn btn-primary btn-sm"
