.service-genres-dashboard
  .admin-content-header.dashboard-toolbar.service-genres-toolbar
    .dashboard-toolbar__main
      div
        h1.service-genres-dashboard__title サービス・ジャンル管理
        p.service-genres-dashboard__subtitle 記事生成やAPI連携で使用するジャンル・サービス情報を管理します
    .dashboard-toolbar__actions
      = link_to new_dashboard_service_genre_path, class: "btn btn-title-suggest service-genres-dashboard__create-btn" do
        svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"
          line x1="12" y1="5" x2="12" y2="19"
          line x1="5" y1="12" x2="19" y2="12"
        span 新規作成

  .service-genres-kpi-row
    .service-genres-kpi-card
      .service-genres-kpi-card__label 登録ジャンル
      .service-genres-kpi-card__value = @service_genres.size
      .service-genres-kpi-card__unit 件
    .service-genres-kpi-card
      .service-genres-kpi-card__label 中分類合計
      .service-genres-kpi-card__value = @service_genres.sum(&:sub_categories_count)
      .service-genres-kpi-card__unit 件
    - if client_signed_in? && current_client_usage_summary
      - genre_usage = current_client_usage_summary[:genres]
      .service-genres-kpi-card
        .service-genres-kpi-card__label プラン上限
        .service-genres-kpi-card__value = "#{genre_usage[:used]} / #{genre_usage[:limit]}"
        .service-genres-kpi-card__unit ジャンル

  .table-wrap.service-genres-table-wrap
    - if @service_genres.present?
      table.rich-dashboard-table.service-genres-table
        thead
          tr
            th キー
            th 表示名
            th サービス名
            - if admin_signed_in?
              th クライアント
            th 中分類
            th 操作
        tbody
          - @service_genres.each do |genre|
            tr
              td
                code.service-genres-key = genre.key
              td
                strong.service-genres-name = genre.ja
              td.service-genres-service = genre.service_name.presence || "—"
              - if admin_signed_in?
                td
                  - if genre.client_id.present?
                    span.service-genres-client = genre.client&.email || "Client ##{genre.client_id}"
                  - else
                    span.service-genres-client.service-genres-client--system システム
              td
                span.count-badge = "#{genre.sub_categories_count}件"
              td
                .service-genres-row-actions
                  = link_to edit_dashboard_service_genre_path(genre), class: "btn-genre-action btn-genre-action--edit", title: "編集" do
                    svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                      path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"
                      path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"
                    span 編集
                  = link_to dashboard_service_genre_path(genre), method: :delete, data: { confirm: "「#{genre.ja}」を削除しますか？\nこの操作は取り消せません。" }, class: "btn-genre-action btn-genre-action--delete", title: "削除" do
                    svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                      polyline points="3 6 5 6 21 6"
                      path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"
                    span 削除
    - else
      .service-genres-empty
        .service-genres-empty__icon 📂
        h3 まだジャンルが登録されていません
        p 記事生成で使うジャンルとサービス情報を登録してください。
        = link_to "最初のジャンルを作成", new_dashboard_service_genre_path, class: "btn btn-title-suggest service-genres-dashboard__create-btn"
