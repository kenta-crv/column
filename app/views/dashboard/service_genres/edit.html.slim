.container-fluid.py-4
  .api-settings-page
    .api-settings-header
      h1.api-settings-title = t("drafity.dashboard.genres.edit_title")
      p.api-settings-subtitle = @service_genre.display_name

    .api-settings-card
      .api-settings-card__body
        = render "form", service_genre: @service_genre, submit_label: t("drafity.dashboard.genres.submit_update")
