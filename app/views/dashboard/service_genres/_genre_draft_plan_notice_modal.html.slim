#genre-draft-plan-notice-modal.modal-overlay style="display: none;"
  .modal-content
    .modal-header
      h3 = t("drafity.dashboard.genres.plan_notice_title")
      button.modal-close type="button" onclick="closeGenreDraftPlanNoticeModal()" ✕
    .modal-body
      p.genre-draft-plan-notice__message
        = t("drafity.dashboard.genres.plan_notice_body")
      .genre-draft-plan-notice__actions
        = link_to t("drafity.dashboard.genres.plan_notice_cta"), plans_path, class: "btn btn-primary"
        button.btn.btn-secondary type="button" onclick="closeGenreDraftPlanNoticeModal()" = t("drafity.dashboard.common.close")
