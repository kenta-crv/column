.container-fluid.py-4
  .api-settings-page
    .api-settings-header
      h1.api-settings-title = @run.title
      p.api-settings-subtitle
        = t("drafity.dashboard.autonomous.status")
        strong = @run.status_label
        - if admin_signed_in? && @run.admin_run?
          = " #{t("drafity.dashboard.autonomous.runner")}"
          strong = t("drafity.dashboard.common.admin")
        - elsif admin_signed_in? && @run.client
          = " #{t("drafity.dashboard.autonomous.client_label")}"
          strong = @run.client.email
        - if @run.pillar_column
          = " #{t("drafity.dashboard.autonomous.pillar_label")}"
          - if @run.pillar_column.code.present?
            = link_to @run.pillar_column.title, public_column_show_path(@run.pillar_column), target: "_blank"
          - else
            = @run.pillar_column.title

    - if @run.error_message.present?
      .alert.alert-warning = @run.error_message

    .api-settings-card
      .api-settings-card__body
        .form-section
          h3.form-section-title = t("drafity.dashboard.autonomous.progress")
          - pillar_status = @run.pillar_column.present? ? (@run.pillar_column.generated_body? ? t("drafity.dashboard.labels.completed") : t("drafity.dashboard.labels.generating")) : t("drafity.dashboard.labels.not_started")
          ul
            li = t("drafity.dashboard.autonomous.progress_pillar", status: pillar_status)
            li = t("drafity.dashboard.autonomous.progress_child_titles", count: @child_columns.size)
            li = t("drafity.dashboard.autonomous.progress_child_bodies", done: @run.completed_child_count, total: @child_columns.size)

        - if @run.status == "awaiting_child_title_approval"
          .form-section
            h3.form-section-title = t("drafity.dashboard.autonomous.awaiting_titles")
            p.form-text = t("drafity.dashboard.autonomous.awaiting_hint")

            - if @child_columns.any?
              table.rich-dashboard-table
                thead
                  tr
                    th = t("drafity.dashboard.labels.title")
                    th
                tbody
                  - @child_columns.each do |child|
                    tr
                      td = child.title
                      td
                        = link_to t("drafity.dashboard.common.delete"), destroy_child_dashboard_autonomous_run_path(@run, child_id: child.id), method: :delete, class: "btn btn-sm btn-danger", data: { confirm: t("drafity.dashboard.autonomous.confirm_delete_child") }

              = button_to t("drafity.dashboard.autonomous.start_bodies"), approve_child_titles_dashboard_autonomous_run_path(@run), method: :post, class: "btn btn-primary", data: { confirm: t("drafity.dashboard.autonomous.confirm_start_bodies") }
            - else
              p.form-text = t("drafity.dashboard.autonomous.no_child_titles")

        - elsif @run.status == "completed" && @run.next_pillar_titles.present?
          .form-section
            h3.form-section-title = t("drafity.dashboard.autonomous.next_titles")
            ol
              - Array(@run.next_pillar_titles).each do |title|
                li = title
            = link_to t("drafity.dashboard.autonomous.new_cycle"), new_dashboard_autonomous_run_path, class: "btn btn-primary"

        .form-actions style="margin-top: 20px;"
          - if %w[failed paused generating_pillar].include?(@run.status)
            = button_to t("drafity.dashboard.autonomous.resume"), retry_dashboard_autonomous_run_path(@run), method: :post, class: "btn btn-primary", data: { confirm: t("drafity.dashboard.autonomous.confirm_resume") }
          = link_to t("drafity.dashboard.common.back_to_list"), dashboard_autonomous_runs_path, class: "btn btn-secondary"
