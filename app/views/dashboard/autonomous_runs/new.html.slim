.container-fluid.py-4
  .api-settings-page
    .api-settings-header
      h1.api-settings-title = t("drafity.dashboard.autonomous.new_title")
      p.api-settings-subtitle = t("drafity.dashboard.autonomous.new_subtitle")

    .api-settings-card
      .api-settings-card__body
        = form_with model: @run, url: dashboard_autonomous_runs_path, local: true do |f|
          .form-section
            h3.form-section-title = t("drafity.dashboard.autonomous.basic")

            - if acting_as_admin?
              p.form-text = t("drafity.dashboard.autonomous.admin_note")

            .form-group
              = f.label :title, t("drafity.dashboard.autonomous.pillar_title")
              = f.text_field :title, class: "form-control", required: true, placeholder: t("drafity.dashboard.autonomous.ph_title")

            .form-group
              = f.label :genre, t("drafity.dashboard.labels.genre")
              = f.select :genre, @genre_options, { include_blank: t("drafity.dashboard.common.please_select") }, class: "form-control", required: true

            .form-group
              = f.label :cluster_limit, t("drafity.dashboard.autonomous.child_count")
              .suggestion-count-control
                = f.range_field :cluster_limit, class: "form-control-range", min: 1, max: 25, value: @run.cluster_limit, id: "clusterLimitRange"
                .suggestion-count-scale#clusterLimitScale
                  - [1, 5, 10, 15, 20, 25].each do |n|
                    span class=("is-available #{'is-active' if n == @run.cluster_limit.to_i}") data-value=n = n
                .suggestion-count-display
                  span#clusterLimitValue = @run.cluster_limit
                  span.suggestion-count-unit = t("drafity.dashboard.common.unit_articles")
                small.form-text = t("drafity.dashboard.autonomous.slider_hint")

            .form-group
              = f.label :language, t("drafity.dashboard.autonomous.language")
              = f.select :language,
                article_language_options_for_select,
                { selected: Column.normalize_language(@run.language) },
                { class: "form-control" }
              small.form-text = t("drafity.dashboard.autonomous.language_hint")

          .form-actions
            = f.submit t("drafity.dashboard.autonomous.start"), class: "btn btn-primary", data: { confirm: t("drafity.dashboard.autonomous.confirm_start") }
            = link_to t("drafity.dashboard.common.cancel"), dashboard_autonomous_runs_path, class: "btn btn-secondary"

javascript:
  (function() {
    const bindClusterLimitRange = () => {
      const range = document.getElementById('clusterLimitRange');
      const label = document.getElementById('clusterLimitValue');
      const scale = document.getElementById('clusterLimitScale');
      if (!range || !label) return;
      if (range.dataset.initialized === 'true') return;
      range.dataset.initialized = 'true';

      const sync = () => {
        const value = parseInt(range.value, 10);
        label.textContent = value;
        if (scale) {
          scale.querySelectorAll('span').forEach((span) => {
            const active = parseInt(span.dataset.value, 10) === value;
            span.classList.toggle('is-active', active);
          });
        }
      };

      range.addEventListener('input', sync);
      range.addEventListener('change', sync);
      sync();
    };

    document.addEventListener('turbolinks:load', bindClusterLimitRange);
    document.addEventListener('DOMContentLoaded', bindClusterLimitRange);
    bindClusterLimitRange();
  })();
