.container-fluid.py-4
  .api-settings-page
    .api-settings-header
      h1.api-settings-title AI主導生成を開始
      p.api-settings-subtitle 親タイトルを入力するだけで、親記事→子タイトル→子記事を自動生成します

    .api-settings-card
      .api-settings-card__body
        = form_with model: @run, url: dashboard_autonomous_runs_path, local: true do |f|
          .form-section
            h3.form-section-title 基本設定

            - if admin_signed_in?
              p.form-text 管理者として直接実行します。プラン制限は適用されません。

            .form-group
              = f.label :title, "親記事タイトル"
              = f.text_field :title, class: "form-control", required: true, placeholder: "例：オフィス清掃の完全ガイド"

            .form-group
              = f.label :genre, "ジャンル"
              = f.select :genre, @genre_options, { include_blank: "選択してください" }, class: "form-control", required: true

            .form-group
              = f.label :cluster_limit, "子記事数"
              .suggestion-count-control
                = f.range_field :cluster_limit, class: "form-control-range", min: 1, max: 25, value: @run.cluster_limit, id: "clusterLimitRange"
                .suggestion-count-scale#clusterLimitScale
                  - [1, 5, 10, 15, 20, 25].each do |n|
                    span class=("is-available #{'is-active' if n == @run.cluster_limit.to_i}") data-value=n = n
                .suggestion-count-display
                  span#clusterLimitValue = @run.cluster_limit
                  span.suggestion-count-unit 本
                small.form-text スライダーで1〜25本の子記事を生成できます。

          .form-actions
            = f.submit "自律生成を開始", class: "btn btn-primary", data: { confirm: "バックグラウンドで生成を開始します。よろしいですか？" }
            = link_to "キャンセル", dashboard_autonomous_runs_path, class: "btn btn-secondary"

javascript:
  (function() {
    const bindClusterLimitRange = () => {
      const range = document.getElementById('clusterLimitRange');
      const label = document.getElementById('clusterLimitValue');
      const scale = document.getElementById('clusterLimitScale');
      if (!range || !label) return;
      if (range.dataset.initialized === 'true') return;
      range.dataset.initialized = 'true';

      const sync = () => {
        const value = parseInt(range.value, 10);
        label.textContent = value;
        if (scale) {
          scale.querySelectorAll('span').forEach((span) => {
            const active = parseInt(span.dataset.value, 10) === value;
            span.classList.toggle('is-active', active);
          });
        }
      };

      range.addEventListener('input', sync);
      range.addEventListener('change', sync);
      sync();
    };

    document.addEventListener('turbolinks:load', bindClusterLimitRange);
    document.addEventListener('DOMContentLoaded', bindClusterLimitRange);
    bindClusterLimitRange();
  })();
