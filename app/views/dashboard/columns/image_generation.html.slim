.image-generation-page
  .dashboard-page-header
    h1 = t("drafity.dashboard.image_generation.title")
    p.dashboard-page-subtitle = t("drafity.dashboard.image_generation.subtitle")

  .image-generation-list-panel
    .image-generation-list-header
      h3 = t("drafity.dashboard.image_generation.list_title")
      span.image-generation-list-count = t("drafity.dashboard.common.count_items", count: @missing_image_total)

    - if @columns.present?
      = form_with url: bulk_generate_images_dashboard_columns_path, method: :post, local: true, data: { turbo: false }, html: { id: "bulk-image-form" } do
        = hidden_field_tag :run_all, "0", id: "bulk-image-run-all"
        .bulk-action-bar.image-generation-action-bar
          button.btn.btn-primary type="button" id="btn-trigger-bulk-generation"
            span ⚡
            span = t("drafity.dashboard.image_generation.generate_selected")
          button.btn.btn-success type="button" id="btn-trigger-run-all-generation"
            span = t("drafity.dashboard.image_generation.generate_all")
          span.image-generation-selected-count id="selected-image-count" = t("drafity.dashboard.common.count_selected", count: 0)

        .table-wrap
          table.rich-dashboard-table.image-generation-table
            thead
              tr
                th width="40"
                  input type="checkbox" class="table-checkbox" id="select-all-image-columns" onclick="toggleAllImageColumns(this)"
                th ID
                th = t("drafity.dashboard.csv.headers.title")
                th = t("drafity.dashboard.labels.genre")
                th = t("drafity.dashboard.labels.type")
                th = t("drafity.dashboard.labels.updated_at")
            tbody
              - @columns.each do |column|
                tr
                  td
                    input type="checkbox" name="column_ids[]" value=column.id class="table-checkbox image-select-checkbox" data-image-select="true"
                  td = column.id
                  td
                    - link_target = column.code.presence || column.id
                    = link_to column.title, column_path(link_target), class: "article-link"
                  td
                    span.img-gen-badge-genre = column.genre.presence || "—"
                  td
                    - if column.article_type == "pillar"
                      span.img-gen-badge-type.img-gen-badge-type--pillar = t("drafity.dashboard.labels.pillar")
                    - else
                      span.img-gen-badge-type.img-gen-badge-type--child = t("drafity.dashboard.labels.child")
                  td.date-text = column.updated_at.strftime("%Y/%m/%d %H:%M")

      .table-footer-pagination
        .pagination-info
          = t("drafity.dashboard.common.showing_range", from: @columns.offset_value + 1, to: @columns.offset_value + @columns.length, total: @columns.total_count)
        .pagination-nav
          = paginate @columns, params: { per: @per_page }
        .per-page-selector
          span = t("drafity.dashboard.common.per_page_label")
          = form_with url: image_generation_dashboard_columns_path, method: :get, local: true do
              = select_tag :per,
                options_for_select([[t("drafity.dashboard.common.per_page_option", count: 30), 30], [t("drafity.dashboard.common.per_page_option", count: 50), 50], [t("drafity.dashboard.common.per_page_option", count: 100), 100]], @per_page),
                onchange: "this.form.submit();",
                "aria-label": t("drafity.dashboard.common.per_page_label")
    - else
      p.image-generation-empty = t("drafity.dashboard.image_generation.empty")

  .dashboard-back-link
    = link_to t("drafity.dashboard.common.back_to_dashboard"), dashboard_root_path

ruby:
  js_i18n = {
    countSelected: t("drafity.dashboard.common.count_selected", count: "%{count}"),
    selectRequired: t("drafity.dashboard.flashes.image_select_required"),
    confirmSelected: t("drafity.dashboard.image_generation.confirm_selected", count: "%{count}"),
    noneToGenerate: t("drafity.dashboard.image_generation.none_to_generate"),
    confirmAll: t("drafity.dashboard.image_generation.confirm_all", count: "%{count}")
  }.to_json.html_safe
javascript:
  (function() {
    const I18nDash = #{js_i18n};
    const missingImageTotal = #{@missing_image_total.to_i};
    const fmt = (template, count) => String(template).replace(/%\{count\}/g, String(count));

    const updateSelectedCount = () => {
      const countEl = document.getElementById('selected-image-count');
      const selected = document.querySelectorAll('.image-select-checkbox:checked').length;
      if (countEl) countEl.textContent = fmt(I18nDash.countSelected, selected);
    };

    const initBulkImagePanel = () => {
      const btnTrigger = document.getElementById('btn-trigger-bulk-generation');
      const btnRunAll = document.getElementById('btn-trigger-run-all-generation');
      const form = document.getElementById('bulk-image-form');
      const runAllField = document.getElementById('bulk-image-run-all');
      if (!form || !runAllField) return;

      document.querySelectorAll('.image-select-checkbox').forEach((checkbox) => {
        checkbox.addEventListener('change', updateSelectedCount);
      });

      if (btnTrigger) {
        btnTrigger.onclick = function() {
          const selected = document.querySelectorAll('.image-select-checkbox:checked');
          if (selected.length === 0) {
            alert(I18nDash.selectRequired);
            return;
          }

          const confirmed = confirm(fmt(I18nDash.confirmSelected, selected.length));
          if (confirmed) {
            runAllField.value = "0";
            form.submit();
          }
        };
      }

      if (btnRunAll) {
        btnRunAll.onclick = function() {
          if (missingImageTotal <= 0) {
            alert(I18nDash.noneToGenerate);
            return;
          }

          const confirmed = confirm(fmt(I18nDash.confirmAll, missingImageTotal));
          if (confirmed) {
            runAllField.value = "1";
            form.submit();
          }
        };
      }

      updateSelectedCount();
    };

    window.toggleAllImageColumns = function(source) {
      document.querySelectorAll('.image-select-checkbox').forEach((cb) => {
        cb.checked = source.checked;
      });
      updateSelectedCount();
    };

    document.addEventListener('turbo:load', initBulkImagePanel);
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initBulkImagePanel);
    } else {
      initBulkImagePanel();
    }
  })();
