.manual-child-title-panel
  .manual-child-title-panel__header
    h4.manual-child-title-panel__title 子記事タイトルを手動追加
    p.manual-child-title-panel__desc AI 生成の代わりに、親記事を選んで 1 件ずつ登録できます

  = form_with url: create_child_title_dashboard_columns_path, method: :post, local: true, html: { class: "manual-child-title-panel__form" } do |f|
    .manual-child-title-panel__field
      label.manual-child-title-panel__label for="pillar_id" 親記事
      = select_tag :pillar_id, options_for_select(@manual_child_parent_options), include_blank: "親記事を選択", class: "filter-select manual-child-title-panel__select", required: true
    .manual-child-title-panel__field.manual-child-title-panel__field--grow
      label.manual-child-title-panel__label for="child_title" 子記事タイトル
      = text_field_tag :child_title, nil, class: "form-control manual-child-title-panel__input", placeholder: "例: ○○の選び方と注意点", required: true
    .manual-child-title-panel__submit
      = f.submit "追加する", class: "btn btn-primary"
