.api-settings-page.subscription-page
  .api-settings-header
    h1.api-settings-title = t("drafity.dashboard.subscription.title")
    p.api-settings-subtitle = t("drafity.dashboard.subscription.subtitle")

  - is_trial = (@subscription&.trial?) || (@target_client.subscription_plan == "trial")
  - current_plan_key = (@subscription&.plan_type || @target_client.subscription_plan || "trial").to_sym
  - is_active = @subscription.present? ? @subscription.active? : (@target_client.subscription_status == "active" || is_trial)
  - trial_ends_at = @subscription&.trial_ends_at
  - if trial_ends_at.blank? && is_trial && @subscription&.created_at.present?
    - trial_ends_at = @subscription.created_at + Subscription::TRIAL_DAYS.days

  - if @subscription.present? || is_trial
    .api-settings-card
      .api-settings-card__body
        .form-section
          h3.form-section-title = t("drafity.dashboard.subscription.current")

          .subscription-info-grid
            .subscription-info-item
              span.subscription-info-label = t("drafity.dashboard.labels.plan_name")
              span.subscription-info-value.subscription-info-value--plan = Subscription.display_name_for(current_plan_key)

            .subscription-info-item
              span.subscription-info-label = t("drafity.dashboard.labels.status")
              - status_class = is_active ? "active" : "canceled"
              span.status-badge class="status-#{status_class}"
                = is_trial ? t("drafity.dashboard.labels.trialing") : @subscription&.status&.capitalize

            - if is_trial && trial_ends_at.present?
              .subscription-info-item
                span.subscription-info-label = t("drafity.dashboard.subscription.trial_ends")
                span.subscription-info-value = l(trial_ends_at.to_date)

        .form-section style="margin-bottom: 0; padding-bottom: 0; border-bottom: none;"
          h3.form-section-title = t("drafity.dashboard.subscription.change")
          p.subscription-note = t("drafity.dashboard.subscription.change_note")
          .subscription-actions
            = link_to plans_path(client_id: params[:client_id]), class: "subscription-btn subscription-btn--primary" do
              = t("drafity.dashboard.subscription.change_cta")

    - if is_active
      .subscription-cancel-box
        = link_to cancel_confirm_dashboard_subscription_path(client_id: params[:client_id]), class: "subscription-btn subscription-btn--danger", data: { turbo: false } do
          = t("drafity.dashboard.subscription.cancel_cta")

  - else
    .api-settings-card
      .api-settings-card__body.subscription-empty
        p = t("drafity.dashboard.subscription.none")
        = link_to plans_path(client_id: params[:client_id]), class: "subscription-btn subscription-btn--warning" do
          = t("drafity.dashboard.subscription.select_plan")

  .api-settings-card
    .api-settings-card__body
      .form-section style="margin-bottom: 0; padding-bottom: 0; border-bottom: none;"
        h3.form-section-title = t("drafity.dashboard.subscription.history")

        - if @payments.present?
          .management-table-wrap
            table.management-table
              thead
                tr
                  th = t("drafity.dashboard.labels.date")
                  th = t("drafity.dashboard.labels.amount")
                  th = t("drafity.dashboard.labels.description")
                  th = t("drafity.dashboard.labels.status")
              tbody
                - @payments.each do |payment|
                  tr
                    td = payment.created_at.strftime("%Y/%m/%d")
                    td.price-text = payment.formatted_amount
                    td = payment.description
                    td
                      - p_status = payment.succeeded? ? "active" : "canceled"
                      span.status-badge class="status-#{p_status}"
                        = payment.status.capitalize
        - else
          .subscription-empty.subscription-empty--compact
            p = t("drafity.dashboard.subscription.history_empty")
