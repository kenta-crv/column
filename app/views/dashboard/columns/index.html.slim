          span ↓ 5.2%
      .kpi-body
        .value = Column.where(status: "draft").count
        .comparison 前月比
        .kpi-chart
          svg viewBox="0 0 100 30" class="mini-graph"
            path d="M0,5 Q25,12 50,8 T75,22 T100,18" fill="none" stroke="#f59e0b" stroke-width="2"
            path d="M0,5 Q25,12 50,8 T75,22 T100,18 L100,30 L0,30 Z" fill="url(#grad-orange)" opacity="0.1"
