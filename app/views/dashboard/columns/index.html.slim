/ ジャンル別記事総数
- summary_genres = ((@genre_pillar_counts&.keys || []) + (@genre_child_counts&.keys || [])).uniq.compact
- if summary_genres.present?
  .genre-summary-section
    .genre-summary-title 【ジャンル別記事総数】
