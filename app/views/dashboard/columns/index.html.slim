javascript:
  const I18nDash = #{js_i18n};
  const i18nFmt = (template, vars) => String(template).replace(/%\{(\w+)\}/g, (_, k) => (vars && vars[k] != null ? vars[k] : ''));

  let sessionCompletedCount = 0;
  let generationPollTimer = null;
  let lastInProgressCount = null;

  function escapeHtml(text) {
    const div = document.createElement('div');
    div.textContent = text || '';
    return div.innerHTML;
  }

  function renderGenerationItem(column) {
    return `
      <div class="generation-item" id="generation-item-${column.id}" data-status="${column.status}">
        <div class="generation-spinner">
          <svg class="spinner-icon" viewBox="0 0 50 50">
            <circle cx="25" cy="25" r="20" fill="none" stroke="#3b82f6" stroke-width="4"></circle>
          </svg>
        </div>
        <div class="generation-info">
          <div class="generation-title">${escapeHtml(column.title)}</div>
          <div class="generation-status">${I18nDash.realtimeGenerating}</div>
        </div>
        <button type="button" class="generation-stop-btn" style="margin-left:auto;background:#ef4444;color:#fff;border:1px solid #dc2626;border-radius:6px;height:28px;padding:0 10px;font-size:12px;font-weight:600;" onclick="stopGeneration(${column.id})">
          <span>${I18nDash.stop}</span>
        </button>
      </div>`;
  }

  function renderGenerationPanel(data) {
    const generatingCount = document.getElementById('generating-count');
    const completedCount = document.getElementById('completed-count');
    const generationList = document.getElementById('generation-list');
    if (!generationList) return;

    const inProgressCount = (data.queued_count || 0) + (data.generating_count || 0);
    if (generatingCount) generatingCount.textContent = inProgressCount;
    if (completedCount) completedCount.textContent = sessionCompletedCount;

    if (!data.columns || data.columns.length === 0) {
      generationList.innerHTML = '<div class="no-generation">' + I18nDash.noGenerating + '</div>';
      return;
    }

    generationList.innerHTML = data.columns.map(renderGenerationItem).join('');
  }

  function syncGenerationPanelFromServer() {
    return fetch('/dashboard/columns/generation_status', {
      headers: { 'Accept': 'application/json' }
    })
      .then((response) => response.ok ? response.json() : null)
      .then((data) => {
        if (!data) return;
        const inProgress = (data.queued_count || 0) + (data.generating_count || 0);
        const previous = lastInProgressCount;
        lastInProgressCount = inProgress;
        renderGenerationPanel(data);
        configureGenerationPolling(inProgress > 0);

        if (previous > 0 && inProgress === 0) {
          window.setTimeout(function() { window.location.reload(); }, 600);
        }
      })
      .catch(() => {});
  }

  function configureGenerationPolling(shouldPoll) {
    if (generationPollTimer) {
      clearInterval(generationPollTimer);
      generationPollTimer = null;
    }
    if (!shouldPoll) return;

    generationPollTimer = setInterval(syncGenerationPanelFromServer, 3000);
  }

  function initGenerationTracking() {
    if (window.__generationCableSubscription) {
      window.__generationCableSubscription.unsubscribe();
      window.__generationCableSubscription = null;
    }

    syncGenerationPanelFromServer();

    if (typeof ActionCable === 'undefined') return;

    const cable = (window.App && App.cable) ? App.cable : ActionCable.createConsumer('/cable');
    window.__generationCableSubscription = cable.subscriptions.create('GenerationChannel', {
      received(data) { updateGenerationStatus(data); },
      connected() { syncGenerationPanelFromServer(); },
      disconnected() { configureGenerationPolling(true); }
    });
  }

  (function() {
    const initAll = () => {
      initGenerationTracking();
    };

    document.addEventListener('turbolinks:load', initAll);
    document.addEventListener('turbolinks:before-cache', () => {
      if (generationPollTimer) {
        clearInterval(generationPollTimer);
        generationPollTimer = null;
      }
    });
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAll);
    } else {
      initAll();
    }
  })();

  function toggleAllColumns(source) {
    document.querySelectorAll('.column-select-checkbox:not(:disabled)')
      .forEach(cb => cb.checked = source.checked);
  }

  function updateGenerationStatus(data) {
    if (data.status === 'completed') {
      sessionCompletedCount += 1;
      markGenerationItemDone(data);
      applyGeneratedRow(data);
      const completedCount = document.getElementById('completed-count');
      if (completedCount) completedCount.textContent = sessionCompletedCount;
    }

    syncGenerationPanelFromServer();

    if (data.status === 'evaluated' && data.quality_score) {
      updateTableRowScore(data.column_id, data.quality_score, data.evaluation_metrics);
    }
  }

  function markGenerationItemDone(data) {
    const item = document.getElementById('generation-item-' + data.column_id);
    if (!item) return;

    item.dataset.status = 'completed';
    const statusEl = item.querySelector('.generation-status');
    if (statusEl) statusEl.textContent = I18nDash.realtimeDone;
    const spinner = item.querySelector('.generation-spinner');
    if (spinner) spinner.innerHTML = '<span style="color:#16a34a;font-weight:700;">✓</span>';
    const stopBtn = item.querySelector('.generation-stop-btn');
    if (stopBtn) stopBtn.remove();
  }

  function applyGeneratedRow(data) {
    const row = document.querySelector(`tr[data-column-id="${data.column_id}"]`);
    if (!row) return;

    const badge = row.querySelector('.status-badge');
    if (badge && !badge.classList.contains('published')) {
      badge.className = 'status-badge review_pending';
      badge.textContent = I18nDash.pendingReview;
    }

    const titleEl = row.querySelector('.article-title');
    const link = titleEl && titleEl.closest('a.article-link');
    if (link && data.path) {
      link.setAttribute('href', data.path);
      link.removeAttribute('onclick');
      link.onclick = null;
    }

    if (data.file_url) {
      const placeholder = row.querySelector('.article-thumb-placeholder');
      if (placeholder) {
        const img = document.createElement('img');
        img.src = data.file_url;
        img.className = 'article-thumb';
        placeholder.replaceWith(img);
      } else {
        const img = row.querySelector('img.article-thumb');
        if (img) img.src = data.file_url;
      }
    }
  }

  function updateTableRowScore(columnId, score, metrics) {
    const row = document.querySelector(`tr[data-column-id="${columnId}"]`);
    if (!row) return;

    const scoreCell = row.querySelector('.quality-score-cell, .quality-score-pending');
    if (!scoreCell) return;

    scoreCell.outerHTML = buildQualityScoreCellHtml(score, metrics);
  }

  function buildQualityScoreCellHtml(score, metrics) {
    const value = parseFloat(score);
    if (!value || value <= 0) {
      return '<div class="quality-score-pending">' + I18nDash.scorePending + '</div>';
    }

    const levelClass = value >= 80 ? 'score-high' : (value >= 60 ? 'score-mid' : 'score-low');
    const lines = buildQualityTooltipLines(value, metrics);
    const tooltipHtml = lines.length
      ? `<div class="quality-score-tooltip" role="tooltip">${lines.map(line => {
          let css = 'tooltip-line';
          if (line.kind === 'overall') css += ' tooltip-line--overall';
          if (line.kind === 'axis') css += ' tooltip-line--axis';
          if (line.kind === 'feedback') css += ' tooltip-line--feedback';
          return `<div class="${css}">${escapeHtml(line.text)}</div>`;
        }).join('')}</div>`
      : '';

    return `
      <div class="quality-score-cell has-tooltip">
        <div class="quality-score-value ${levelClass}">${value.toFixed(1)}</div>
        ${tooltipHtml}
      </div>`;
  }

  function buildQualityTooltipLines(score, metrics) {
    const data = metrics || {};
    const axes = data.axes || {};
    const axisLabels = {
      structure: I18nDash.scoreStructure,
      seo: I18nDash.scoreSeo,
      readability: I18nDash.scoreReadability,
      usefulness: I18nDash.scoreUsefulness,
      originality: I18nDash.scoreOriginality
    };
    const lines = [{ kind: 'overall', text: i18nFmt(I18nDash.scoreOverall, { score: score.toFixed(1) }) }];

    Object.keys(axisLabels).forEach(key => {
      const axis = axes[key];
      if (!axis || axis.score === undefined || axis.score === null) return;
      const note = (axis.note || '').trim();
      let text = `${axisLabels[key]}: ${parseInt(axis.score, 10)}/20`;
      if (note) text += ` — ${note}`;
      lines.push({ kind: 'axis', text });
    });

    const feedback = (data.feedback || '').trim();
    if (feedback) lines.push({ kind: 'feedback', text: feedback });
    return lines;
  }

  function escapeHtml(text) {
    return String(text)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  function stopGeneration(columnId) {
    if (!confirm(I18nDash.confirmStop)) return;

    fetch(`/dashboard/columns/${columnId}/stop_generation`, {
      method: 'PATCH',
      headers: {
        'Content-Type': 'application/json',
        'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content
      }
    }).catch(() => {
      alert(I18nDash.stopFailed);
    });
  }

  function clampSuggestionCount(value) {
    const input = document.getElementById('suggestion-count');
    const planMax = parseInt(input?.dataset.planMax || '5', 10);
    const parsed = parseInt(value, 10);
    const count = Number.isNaN(parsed) ? 1 : parsed;
    return Math.min(planMax, Math.max(1, count));
  }

  function syncSuggestionCountDisplay() {
    const input = document.getElementById('suggestion-count');
    const valueEl = document.getElementById('suggestion-count-value');
    if (!input || !valueEl) return;

    const clamped = clampSuggestionCount(input.value);
    if (String(clamped) !== input.value) {
      input.value = clamped;
    }
    valueEl.textContent = clamped;
  }

  function initSuggestionCountSlider() {
    const input = document.getElementById('suggestion-count');
    if (!input || input.dataset.initialized === 'true') return;

    input.dataset.initialized = 'true';
    input.addEventListener('input', syncSuggestionCountDisplay);
    input.addEventListener('change', syncSuggestionCountDisplay);
    syncSuggestionCountDisplay();
  }

  function getModalSubCategories() {
    const subSelect = document.getElementById('sub-genre-select-modal');
    if (!subSelect) return {};
    try {
      return JSON.parse(subSelect.dataset.masterData || '{}');
    } catch (e) {
      return {};
    }
  }

  function setModalSubCategories(data) {
    const subSelect = document.getElementById('sub-genre-select-modal');
    if (!subSelect) return;
    subSelect.dataset.masterData = JSON.stringify(data || {});
  }

  function updateModalSubGenre(selectedGenre) {
    const subSelect = document.getElementById('sub-genre-select-modal');
    if (!subSelect) return;

    const subCategories = getModalSubCategories();
    subSelect.innerHTML = '';

    if (selectedGenre && subCategories[selectedGenre] && subCategories[selectedGenre].length > 0) {
      const defaultOption = document.createElement('option');
      defaultOption.value = '';
      defaultOption.textContent = I18nDash.subOptional;
      subSelect.appendChild(defaultOption);

      subCategories[selectedGenre].forEach((sub) => {
        const option = document.createElement('option');
        option.value = sub.id;
        option.textContent = sub.name;
        subSelect.appendChild(option);
      });
      subSelect.disabled = false;
    } else if (!selectedGenre) {
      const emptyOption = document.createElement('option');
      emptyOption.value = '';
      emptyOption.textContent = I18nDash.subSelectGenreFirst;
      subSelect.appendChild(emptyOption);
      subSelect.disabled = true;
    } else {
      const emptyOption = document.createElement('option');
      emptyOption.value = '';
      emptyOption.textContent = I18nDash.subNone;
      subSelect.appendChild(emptyOption);
      subSelect.disabled = true;
    }
  }

  function initModalSubGenreSelect() {
    const genreSelect = document.getElementById('genre-select-modal');
    if (!genreSelect || genreSelect.dataset.subGenreInitialized === 'true') return;

    genreSelect.dataset.subGenreInitialized = 'true';
    genreSelect.addEventListener('change', (e) => updateModalSubGenre(e.target.value));
    updateModalSubGenre(genreSelect.value);
  }

  function initQuickGenreCreate() {
    const btn = document.getElementById('quick-genre-create-btn');
    const status = document.getElementById('quick-genre-status');
    const genreSelect = document.getElementById('genre-select-modal');
    if (!btn || btn.dataset.initialized === 'true') return;

    btn.dataset.initialized = 'true';
    btn.addEventListener('click', async () => {
      const serviceName = document.getElementById('quick-genre-service-name')?.value.trim();
      const strongPoints = document.getElementById('quick-genre-strong-points')?.value.trim();
      const keyword1 = document.getElementById('keyword1')?.value.trim();
      const keyword2 = document.getElementById('keyword2')?.value.trim();

      if (!serviceName && !strongPoints) {
        if (status) {
          status.hidden = false;
          status.textContent = I18nDash.genreNeedInput;
          status.className = 'genre-quick-setup-status genre-quick-setup-status--error';
        }
        return;
      }

      btn.disabled = true;
      if (status) {
        status.hidden = false;
        status.textContent = I18nDash.genreRegistering;
        status.className = 'genre-quick-setup-status genre-quick-setup-status--loading';
      }

      try {
        const response = await fetch('#{quick_create_dashboard_service_genres_path}', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.content,
            'Accept': 'application/json'
          },
          body: JSON.stringify({
            service_name: serviceName,
            strong_points: strongPoints,
            keyword1,
            keyword2
          })
        });
        const result = await response.json();
        if (!response.ok || !result.success) {
          if (status) {
            status.textContent = result.error || I18nDash.genreRegisterFailed;
            status.className = 'genre-quick-setup-status genre-quick-setup-status--error';
          }
          return;
        }

        if (genreSelect) {
          const option = document.createElement('option');
          option.value = result.genre.key;
          option.textContent = result.genre.ja;
          option.selected = true;
          genreSelect.appendChild(option);
          genreSelect.disabled = false;

          const master = getModalSubCategories();
          master[result.genre.key] = Array.isArray(result.sub_categories) ? result.sub_categories : [];
          setModalSubCategories(master);
          updateModalSubGenre(result.genre.key);
        }

        const panel = document.getElementById('genre-quick-setup-panel');
        if (panel) panel.style.display = 'none';

        if (status) {
          status.textContent = I18nDash.genreRegistered;
          status.className = 'genre-quick-setup-status genre-quick-setup-status--success';
        }
      } catch (error) {
        if (status) {
          status.textContent = I18nDash.networkError;
          status.className = 'genre-quick-setup-status genre-quick-setup-status--error';
        }
      } finally {
        btn.disabled = false;
      }
    });
  }

  function openTitleSuggestionModal() {
    initSuggestionCountSlider();
    initModalSubGenreSelect();
    initQuickGenreCreate();
    const modal = document.getElementById('title-suggestion-modal');
    if (modal) modal.style.display = 'flex';
  }

  function closeTitleSuggestionModal() {
    const modal = document.getElementById('title-suggestion-modal');
    if (modal) modal.style.display = 'none';
  }

  function generateTitles() {
    const keyword1    = document.getElementById('keyword1').value;
    const keyword2    = document.getElementById('keyword2').value;
    const targetLayer = document.getElementById('target_layer').value;
    const genre       = document.getElementById('genre-select-modal').value;
    const subGenre    = document.getElementById('sub-genre-select-modal')?.value || '';
    const customPrompt = document.getElementById('custom-prompt').value;
    const articleLanguage = document.getElementById('article-language-select')?.value || 'ja';
    const suggestionCount = clampSuggestionCount(document.getElementById('suggestion-count').value);

    if (!keyword1 || !keyword2 || !genre) {
      alert(I18nDash.keywordsGenreRequired);
      return;
    }

    document.getElementById('title-suggestion-form').style.display    = 'none';
    document.getElementById('title-suggestion-loading').style.display = 'block';

    const params = new URLSearchParams({
      keyword1,
      keyword2,
      target_layer: targetLayer,
      genre,
      suggestion_count: suggestionCount
    });
    if (subGenre) {
      params.set('sub_genre', subGenre);
    }
    if (customPrompt.trim()) {
      params.set('custom_prompt', customPrompt.trim());
    }
    if (articleLanguage) {
      params.set('language', articleLanguage);
    }

    fetch(`/dashboard/columns/suggest?${params.toString()}`, {
      method: 'GET',
      headers: {
        'Accept': 'application/json',
        'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content
      }
    })
    .then(async (response) => {
      const data = await response.json().catch(() => null);
      document.getElementById('title-suggestion-loading').style.display  = 'none';
      document.getElementById('title-suggestion-results').style.display  = 'block';

      if (!data) {
        document.getElementById('titles-list').innerHTML = '<p style="color: red;">' + I18nDash.parseError + '</p>';
        return;
      }

      if (data.success) {
        const titlesList = document.getElementById('titles-list');
        titlesList.innerHTML = '';
        data.titles.forEach((title, index) => {
          const div = document.createElement('div');
          div.className = 'title-option';
          div.innerHTML = `
            <input type="checkbox" class="title-checkbox" value="${title}" id="title-${index}">
            <label for="title-${index}" style="margin-left: 8px; cursor: pointer;">${title}</label>
          `;
          titlesList.appendChild(div);
        });
      } else {
        document.getElementById('titles-list').innerHTML = '<p style="color: red;">' + data.error + '</p>';
      }
    })
    .catch(() => {
      document.getElementById('title-suggestion-loading').style.display = 'none';
      document.getElementById('title-suggestion-results').style.display = 'block';
      document.getElementById('titles-list').innerHTML = '<p style="color: red;">' + I18nDash.genericError + '</p>';
    });
  }

  function createSelectedColumns() {
    const checkboxes = document.querySelectorAll('.title-checkbox:checked');
    if (checkboxes.length === 0) {
      alert(I18nDash.selectTitles);
      return;
    }

    const titles = Array.from(checkboxes).map(cb => cb.value);
    const genre  = document.getElementById('genre-select-modal').value;
    const subGenre = document.getElementById('sub-genre-select-modal')?.value || '';

    if (!confirm(i18nFmt(I18nDash.confirmRegisterTitles, { count: titles.length }))) return;

    const payload = { titles, genre };
    if (subGenre) payload.sub_genre = subGenre;
    const articleLanguage = document.getElementById('article-language-select')?.value || 'ja';
    if (articleLanguage) payload.language = articleLanguage;

    fetch('/dashboard/columns/bulk_create_from_suggestions', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content
      },
      body: JSON.stringify(payload)
    })
    .then(response => response.json())
    .then(data => {
      if (data.success) {
        closeTitleSuggestionModal();
        alert(i18nFmt(I18nDash.createdArticles, { count: data.created_count }));
        location.reload();
      } else {
        alert(i18nFmt(I18nDash.errorPrefix, { message: data.error }));
      }
    })
    .catch(() => { alert(I18nDash.genericError); });
  }

  function backToForm() {
    document.getElementById('title-suggestion-results').style.display = 'none';
    document.getElementById('title-suggestion-form').style.display    = 'block';
  }

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeTitleSuggestionModal();
  });