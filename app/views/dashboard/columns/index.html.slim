    h1 生成管理
    p.header-subtitle 生成した記事の一覧とステータスを管理できます
  
  .header-right
    .search-box-wrapper
      svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="search-icon"
        circle cx="11" cy="11" r="8"
        line x1="21" y1="21" x2="16.65" y2="16.65"
      input type="text" placeholder="記事タイトル・キーワードで検索" class="search-input"
      span.search-shortcut ⌘ K
    
    button.btn-icon-badge
      svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
        path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-7"
        path d="M13.73 21a2 2 0 0 1-3.46 0"
      span.notification-dot
      
    button.btn-icon-action
      svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
        circle cx="12" cy="12" r="10"
        line x1="2" y1="12" x2="22" y2="12"
        path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"

/ 2. エクスポート等のセカンダリアクションバー
.sub-header-actions
