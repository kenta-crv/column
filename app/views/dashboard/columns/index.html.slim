= render "title_suggestion_modal"

javascript:
  (function() {
    const initAll = () => {
      // 言語ドロップダウン
      const btn  = document.getElementById('languageDropdownBtn');
      const menu = document.getElementById('languageMenu');
      if (btn && menu) {
        const freshBtn = btn.cloneNode(true);
        btn.replaceWith(freshBtn);
        freshBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          menu.style.display = menu.style.display === 'block' ? 'none' : 'block';
        });
        document.addEventListener('click', (e) => {
          if (!menu.contains(e.target) && e.target !== freshBtn) {
            menu.style.display = 'none';
          }
        });
      }

      // ActionCable
      if (typeof ActionCable !== 'undefined') {
        const cable = ActionCable.createConsumer('/cable');
        cable.subscriptions.create('GenerationChannel', {
          received(data) { updateGenerationStatus(data); },
          connected()    { console.log('Connected to GenerationChannel'); },
          disconnected() { console.log('Disconnected from GenerationChannel'); }
        });
      } else {
        console.error('ActionCable is not defined.');
      }
    };

    document.addEventListener('turbo:load', initAll);
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAll);
    } else {
      initAll();
    }
  })();

  function toggleAllColumns(source) {
    document.querySelectorAll('.column-select-checkbox')
      .forEach(cb => cb.checked = source.checked);
  }

  function updateGenerationStatus(data) {
    const generatingCount = document.getElementById('generating-count');
    const completedCount  = document.getElementById('completed-count');
    const generationList  = document.getElementById('generation-list');

    if (data.status === 'generating') {
      if (generatingCount) {
        generatingCount.textContent = parseInt(generatingCount.textContent || 0) + 1;
      }
      if (generationList && !document.getElementById(`generation-item-${data.column_id}`)) {
        const noGen = generationList.querySelector('.no-generation');
        if (noGen) noGen.remove();

        const item = document.createElement('div');
        item.id             = `generation-item-${data.column_id}`;
        item.className      = 'generation-item';
        item.dataset.status = 'generating';
        item.innerHTML      = `
          <div class="generation-spinner">
            <svg class="spinner-icon" viewBox="0 0 50 50">
              <circle cx="25" cy="25" r="20" fill="none" stroke="#3b82f6" stroke-width="4"></circle>
            </svg>
          </div>
          <div class="generation-info">
            <div class="generation-title">${data.title || ''}</div>
            <div class="generation-status">生成中...</div>
          </div>`;
        generationList.insertBefore(item, generationList.firstChild);
      }

    } else if (data.status === 'completed') {
      if (generatingCount) {
        generatingCount.textContent = Math.max(0, parseInt(generatingCount.textContent || 0) - 1);
      }
      if (completedCount) {
        completedCount.textContent = parseInt(completedCount.textContent || 0) + 1;
      }
      const item = document.getElementById(`generation-item-${data.column_id}`);
      if (item) {
        item.dataset.status = 'completed';
        const spinner = item.querySelector('.generation-spinner');
        if (spinner) {
          spinner.innerHTML = `
            <svg class="check-icon" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="3">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>`;
        }
        const statusEl = item.querySelector('.generation-status');
        if (statusEl) {
          statusEl.textContent = '完了';
          statusEl.style.color = '#10b981';
        }
      }
      if (data.quality_score) {
        updateTableRowScore(data.column_id, data.quality_score, data.evaluation_metrics);
      }

    } else if (data.status === 'evaluated') {
      updateTableRowScore(data.column_id, data.quality_score, data.evaluation_metrics);

    } else if (data.status === 'failed') {
      if (generatingCount) {
        generatingCount.textContent = Math.max(0, parseInt(generatingCount.textContent || 0) - 1);
      }
      const item = document.getElementById(`generation-item-${data.column_id}`);
      if (item) {
        item.dataset.status = 'failed';
        const statusEl = item.querySelector('.generation-status');
        if (statusEl) {
          statusEl.textContent = 'エラー';
          statusEl.style.color = '#ef4444';
        }
      }
    }
  }

  function updateTableRowScore(columnId, score, metrics) {
    const row = document.querySelector(`tr[data-column-id="${columnId}"]`);
    if (!row) return;

    const scoreCell = row.querySelector('.quality-score-cell, .quality-score-pending');
    if (!scoreCell) return;

    scoreCell.outerHTML = `
      <div class="quality-score-cell">
        <div class="quality-score-value">${parseFloat(score).toFixed(1)}</div>
      </div>`;
  }

  function openTitleSuggestionModal() {
    const modal = document.getElementById('title-suggestion-modal');
    if (modal) modal.style.display = 'flex';
  }

  function closeTitleSuggestionModal() {
    const modal = document.getElementById('title-suggestion-modal');
    if (modal) modal.style.display = 'none';
  }

  function generateTitles() {
    const keyword1    = document.getElementById('keyword1').value;
    const keyword2    = document.getElementById('keyword2').value;
    const targetLayer = document.getElementById('target_layer').value;
    const genre       = document.getElementById('genre-select-modal').value;
    const customPrompt = document.getElementById('custom-prompt').value;
    const suggestionCount = document.getElementById('suggestion-count').value;

    if (!keyword1 || !keyword2 || !genre) {
      alert('キーワードとジャンルを入力してください');
      return;
    }

    document.getElementById('title-suggestion-form').style.display    = 'none';
    document.getElementById('title-suggestion-loading').style.display = 'block';

    const params = new URLSearchParams({
      keyword1,
      keyword2,
      target_layer: targetLayer,
      genre,
      suggestion_count: suggestionCount
    });
    if (customPrompt.trim()) {
      params.set('custom_prompt', customPrompt.trim());
    }

    fetch(`/dashboard/columns/suggest?${params.toString()}`, {
      method: 'GET',
      headers: {
        'Content-Type': 'application/json',
        'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content
      }
    })
    .then(response => response.json())
    .then(data => {
      document.getElementById('title-suggestion-loading').style.display  = 'none';
      document.getElementById('title-suggestion-results').style.display  = 'block';

      if (data.success) {
        const titlesList = document.getElementById('titles-list');
        titlesList.innerHTML = '';
        data.titles.forEach((title, index) => {
          const div = document.createElement('div');
          div.className = 'title-option';
          div.innerHTML = `
            <input type="checkbox" class="title-checkbox" value="${title}" id="title-${index}">
            <label for="title-${index}" style="margin-left: 8px; cursor: pointer;">${title}</label>
          `;
          titlesList.appendChild(div);
        });
      } else {
        document.getElementById('titles-list').innerHTML = '<p style="color: red;">' + data.error + '</p>';
      }
    })
    .catch(() => {
      document.getElementById('title-suggestion-loading').style.display = 'none';
      document.getElementById('title-suggestion-results').style.display = 'block';
      document.getElementById('titles-list').innerHTML = '<p style="color: red;">エラーが発生しました</p>';
    });
  }

  function createSelectedColumns() {
    const checkboxes = document.querySelectorAll('.title-checkbox:checked');
    if (checkboxes.length === 0) {
      alert('タイトルを選択してください');
      return;
    }

    const titles = Array.from(checkboxes).map(cb => cb.value);
    const genre  = document.getElementById('genre-select-modal').value;

    if (!confirm(`${titles.length}件のタイトルを登録しますか？`)) return;

    fetch('/dashboard/columns/bulk_create_from_suggestions', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content
      },
      body: JSON.stringify({ titles, genre })
    })
    .then(response => response.json())
    .then(data => {
      if (data.success) {
        closeTitleSuggestionModal();
        alert(`${data.created_count}件の記事を作成しました`);
        location.reload();
      } else {
        alert('エラー: ' + data.error);
      }
    })
    .catch(() => { alert('エラーが発生しました'); });
  }

  function backToForm() {
    document.getElementById('title-suggestion-results').style.display = 'none';
    document.getElementById('title-suggestion-form').style.display    = 'block';
  }

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeTitleSuggestionModal();
  });