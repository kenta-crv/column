= link_to new_column_path, class: "floating-sparkle-btn" do
  svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
    line x1="12" y1="5" x2="12" y2="19"
    line x1="5" y1="12" x2="19" y2="12"

javascript:
  document.addEventListener('DOMContentLoaded', () => {
    const btn  = document.getElementById('languageDropdownBtn');
    const menu = document.getElementById('languageMenu');

    if (btn && menu) {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        menu.style.display = menu.style.display === 'block' ? 'none' : 'block';
      });
      document.addEventListener('click', (e) => {
        if (!menu.contains(e.target) && e.target !== btn) {
          menu.style.display = 'none';
        }
      });
    }

    if (typeof ActionCable !== 'undefined') {
      const cable = ActionCable.createConsumer('/cable');
      cable.subscriptions.create('GenerationChannel', {
        received(data) {
          console.log('Received ActionCable data:', data);
          updateGenerationStatus(data);
        },
        connected() {
          console.log('Connected to GenerationChannel');
        },
        disconnected() {
          console.log('Disconnected from GenerationChannel');
        }
      });
    } else {
      console.error('ActionCable is not defined. Make sure cable.js is loaded.');
    }
  });

  function toggleAllColumns(source) {
    document.querySelectorAll('.column-select-checkbox')
      .forEach(cb => cb.checked = source.checked);
  }

  function updateGenerationStatus(data) {
    const generatingCount = document.getElementById('generating-count');
    const completedCount  = document.getElementById('completed-count');
    const generationList  = document.getElementById('generation-list');

    if (data.status === 'generating') {
      if (generatingCount) {
        generatingCount.textContent = parseInt(generatingCount.textContent || 0) + 1;
      }
      if (generationList && !document.getElementById(`generation-item-${data.column_id}`)) {
        const noGen = generationList.querySelector('.no-generation');
        if (noGen) noGen.remove();

        const item = document.createElement('div');
        item.id             = `generation-item-${data.column_id}`;
        item.className      = 'generation-item';
        item.dataset.status = 'generating';
        item.innerHTML      = `
          <div class="generation-spinner">
            <svg class="spinner-icon" viewBox="0 0 50 50">
              <circle cx="25" cy="25" r="20" fill="none" stroke="#3b82f6" stroke-width="4"></circle>
            </svg>
          </div>
          <div class="generation-info">
            <div class="generation-title">${data.title || ''}</div>
            <div class="generation-status">生成中...</div>
          </div>`;
        generationList.insertBefore(item, generationList.firstChild);
      }

    } else if (data.status === 'completed') {
      if (generatingCount) {
        generatingCount.textContent = Math.max(0, parseInt(generatingCount.textContent || 0) - 1);
      }
      if (completedCount) {
        completedCount.textContent = parseInt(completedCount.textContent || 0) + 1;
      }
      const item = document.getElementById(`generation-item-${data.column_id}`);
      if (item) {
        item.dataset.status = 'completed';
        const spinner = item.querySelector('.generation-spinner');
        if (spinner) {
          spinner.innerHTML = `
            <svg class="check-icon" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="3">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>`;
        }
        const statusEl = item.querySelector('.generation-status');
        if (statusEl) {
          statusEl.textContent = '完了';
          statusEl.style.color = '#10b981';
        }
      }
      if (data.quality_score) {
        updateTableRowScore(data.column_id, data.quality_score, data.evaluation_metrics);
      }

    } else if (data.status === 'evaluated') {
      updateTableRowScore(data.column_id, data.quality_score, data.evaluation_metrics);

    } else if (data.status === 'failed') {
      if (generatingCount) {
        generatingCount.textContent = Math.max(0, parseInt(generatingCount.textContent || 0) - 1);
      }
      const item = document.getElementById(`generation-item-${data.column_id}`);
      if (item) {
        item.dataset.status = 'failed';
        const statusEl = item.querySelector('.generation-status');
        if (statusEl) {
          statusEl.textContent = 'エラー';
          statusEl.style.color = '#ef4444';
        }
      }
    }
  }

  function updateTableRowScore(columnId, score, metrics) {
    const row = document.querySelector(`tr[data-column-id="${columnId}"]`);
    if (!row) return;

    const scoreCell = row.querySelector('.quality-score-cell, .quality-score-pending');
    if (!scoreCell) return;

    const feedback = (metrics && metrics.feedback) ? metrics.feedback : '';

    scoreCell.outerHTML = `
      <div class="quality-score-cell">
        <div class="quality-score-value">
          ${parseFloat(score).toFixed(1)} / 100
        </div>
        ${feedback ? `<div class="quality-feedback">${feedback}</div>` : ''}
      </div>`;
  }