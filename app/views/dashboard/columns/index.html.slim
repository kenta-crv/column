    = link_to dashboard_columns_path(scope: "cluster"), class: "tab-btn #{'active' if params[:scope] == 'cluster'}" do
      span.tab-label 子記事
      span.count-badge = @tab_count_cluster
    = link_to dashboard_columns_path(scope: "published"), class: "tab-btn #{'active' if params[:scope] == 'published'}" do
      span.tab-label 公開済み
