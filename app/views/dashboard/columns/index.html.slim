.admin-content-header style="display: flex; justify-content: space-between; align-items: center; width: 100%; box-sizing: border-box;"
  .header-left style="display: flex; align-items: center; gap: 12px;"
    form action=export_dashboard_columns_path method="get" data-turbo="false" style="display: flex; align-items: center; gap: 8px; margin: 0; padding: 0;"
      - if params[:scope].present?
        input type="hidden" name="scope" value=params[:scope]
      - if params[:genre].present?
        input type="hidden" name="genre" value=params[:genre]
      - if params[:language].present?
        input type="hidden" name="language" value=params[:language]
      select.filter-select name="export_format" style="height: 32px; min-width: 140px; padding: 0 24px 0 10px; border-radius: 4px; border: 1px solid #e2e8f0; font-size: 13px; background-color: #fff; box-sizing: border-box; cursor: pointer;"
        option value="text" テキストのみ抽出
        option value="html" HTML構造を維持
      button type="submit" class="btn btn-export" style="display: inline-flex; align-items: center; gap: 6px; cursor: pointer; height: 36px; padding: 0 12px;"
        svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
          path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"
          polyline points="17 8 12 3 7 8"
          line x1="12" y1="3" x2="12" y2="15"
        span エクスポート

  .header-right style="display: flex; align-items: center; gap: 12px;"
    = form_with url: columns_path, method: :get, local: true, html: { target: "_blank", class: "search-box-form" } do |f|
      .search-box-wrapper
        button type="submit" style="background: none; border: none; padding: 0; cursor: pointer; display: flex; align-items: center;"
          svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="search-icon"
            circle cx="11" cy="11" r="8"
            line x1="21" y1="21" x2="16.65" y2="16.65"
        input type="text" name="q" placeholder="記事タイトル・キーワードで検索" class="search-input" value=params[:q]
        span.search-shortcut ⌘ K

    button.btn-icon-badge
      svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
        path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-7"
        path d="M13.73 21a2 2 0 0 1-3.46 0"
      span.notification-dot

    .language-dropdown-wrapper style="position: relative; display: inline-block;"
      button.btn-icon-action#languageDropdownBtn type="button" style="cursor: pointer;"
        svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
          circle cx="12" cy="12" r="10"
          line x1="2" y1="12" x2="22" y2="12"
          path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"
      .language-menu#languageMenu style="display: none; position: absolute; right: 0; top: 100%; margin-top: 8px; background-color: #fff; border: 1px solid #e2e8f0; border-radius: 6px; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06); z-index: 50; min-width: 140px; padding: 4px 0;"
        a href="?lang=ja" style="display: block; padding: 8px 16px; font-size: 13px; color: #334155; text-decoration: none; transition: background-color 0.2s;" onmouseover="this.style.backgroundColor='#f1f5f9'" onmouseout="this.style.backgroundColor='transparent'"
          | 日本語
        a href="?lang=ko" style="display: block; padding: 8px 16px; font-size: 13px; color: #334155; text-decoration: none; transition: background-color 0.2s;" onmouseover="this.style.backgroundColor='#f1f5f9'" onmouseout="this.style.backgroundColor='transparent'"
          | 한국어
        a href="?lang=en" style="display: block; padding: 8px 16px; font-size: 13px; color: #334155; text-decoration: none; transition: background-color 0.2s;" onmouseover="this.style.backgroundColor='#f1f5f9'" onmouseout="this.style.backgroundColor='transparent'"
          | English
        a href="?lang=de" style="display: block; padding: 8px 16px; font-size: 13px; color: #334155; text-decoration: none; transition: background-color 0.2s;" onmouseover="this.style.backgroundColor='#f1f5f9'" onmouseout="this.style.backgroundColor='transparent'"
          | Deutsch

