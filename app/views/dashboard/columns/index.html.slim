          path class="circle" stroke-dasharray="92, 100" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"
        .percentage 92%

/ 4. フィルターコントロール・ツールバー
.filter-control-bar
  .tabs-group
    = link_to dashboard_columns_path, class: "tab-btn #{'active' if params[:scope].blank?}" do
      span すべて
      span.count-badge.bg-primary = Column.count
    
    = link_to dashboard_columns_path(scope: "draft"), class: "tab-btn #{'active' if params[:scope] == 'draft'}" do
      span 下書き
      span.count-badge = Column.where(body: [nil, ""]).count
      
    = link_to dashboard_columns_path(scope: "pillar"), class: "tab-btn #{'active' if params[:scope] == 'pillar'}" do
      span 親記事
      span.count-badge = Column.where(article_type: "pillar").count
      
    = link_to dashboard_columns_path(scope: "cluster"), class: "tab-btn #{'active' if params[:scope] == 'cluster'}" do
      span 子記事
      span.count-badge = Column.where(article_type: "cluster").count
      
    = link_to dashboard_columns_path(scope: "published"), class: "tab-btn #{'active' if params[:scope] == 'published'}" do
      span 公開済み
      span.count-badge = Column.where.not(body: [nil, ""]).count
      
    = link_to dashboard_columns_path(scope: "error"), class: "tab-btn #{'active' if params[:scope] == 'error'}" do
      span エラー
      span.count-badge = Column.where(status: "error").count

  .dropdowns-group
    select.filter-select
      option すべてのカテゴリ
    select.filter-select
      option すべてのモデル
    button.btn-filter-toggle
      svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
        polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"
      span 絞り込み

/ 5. 一括画像生成パネル
.bulk-panel
  h3 ⚡ 一括画像生成
  = form_with url: bulk_generate_images_dashboard_columns_path, method: :post, local: true, id: "bulk-image-form" do |f|
    .grid
      .field
        label ジャンル
        select#bulk-genre-select name="bulk_genre"
          option value="" 全て
          - if @all_genres.present?
            - @all_genres.each do |g|
              option value=g = g
      .field
        label タイプ
        select#bulk-article-type-select name="bulk_article_type"
          option value="" 全て
          option value="pillar" 親
          option value="child" 子
      = f.button type: "submit", id: "btn-trigger-bulk-generation" do
        | 生成開始

/ 6. リッチなデータテーブル一覧
.table-wrap
  / 共通管理ルート定義の bulk_update_drafts_columns_path に修正してエラーを解消
  = form_with url: bulk_update_drafts_columns_path, method: :post, local: true do |bulk_f|
    .bulk-action-bar style="padding: 10px; display: flex; gap: 10px;"
      = bulk_f.button "選択項目を承認・本文生成", name: "action_type", value: "approve_bulk", class: "btn btn-primary", type: "submit"
      = bulk_f.button "選択項目を削除", name: "action_type", value: "delete_bulk", class: "btn btn-danger", type: "submit", data: { confirm: "本当に削除しますか？" }

    table.rich-dashboard-table
      thead
        tr
          th width="40"
            input type="checkbox" class="table-checkbox" id="select-all-columns"
          th 記事タイトル
          th ステータス
          th カテゴリ
          th AIモデル
          th 生成日時
          th 品質スコア
          th 操作
      tbody
        - if @columns.present?
          - @columns.each do |c|
            tr
              td
                input type="checkbox" name="column_ids[]" value=c.id class="table-checkbox column-select-checkbox"
              td
                .article-info-cell
                  - if c.file.present?
                    img src=c.file class="article-thumb"
                  - else
                    .article-thumb-placeholder 📄
                  .article-detail
                    / 共通管理ルートの edit_column_path を使用
                    = link_to edit_column_path(c), class: "article-link" do
                      span.article-title = c.title
                    .article-tags
                      span.tag-item = c.article_type == "pillar" ? "親記事" : "子記事"
                      - if c.keyword.present?
                        span.tag-item = c.keyword
                      - if c.sub_genre.present?
                        span.tag-item = c.sub_genre
              td
                - if c.status == "approved"
                  span.status-badge.published 公開済み
                - elsif c.status == "draft"
                  span.status-badge.draft 下書き
                - else
                  span.status-badge.reserved = c.status || "未設定"
              td
                span.category-text = c.genre.presence || "全般"
              td
                .ai-model-badge.gpt4
                  span.model-icon 🤖
                  span GPT-4.5
              td.date-text = c.updated_at.strftime("%Y/%m/%d %H:%M")
              td
                .quality-score-radial.high 4.5
              td.actions-cell style="display: flex; gap: 5px;"
                / 共通管理ルートの各個別操作アクションURLヘルパーを適用
                = link_to approve_column_path(c), method: :patch, class: "btn-row-action", title: "承認する" do
                  svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                    polyline points="20 6 9 17 4 12"
                - if c.file.present?
                  = link_to remove_image_column_path(c), method: :patch, class: "btn-row-action action-stop", title: "画像を削除" do
                    svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                      line x1="18" y1="6" x2="6" y2="18"
                      line x1="6" y1="6" x2="18" y2="18"
                = link_to column_path(c), method: :delete, data: { confirm: "削除しますか？" }, class: "btn-row-menu", title: "物理削除" do
                  svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                    polyline points="3 6 5 6 21 6"
                    path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"

/ 7. 下部フッター・ページネーションエリア
.table-footer-pagination
  .pagination-info
    - if @columns.respond_to?(:current_page)
      | #{ @columns.offset_value + 1 } - #{ @columns.offset_value + @columns.length } / #{ @columns.total_count }件を表示
    - else
      | #{ @columns.size }件を表示
  
  .pagination-nav
    - if @columns.respond_to?(:current_page)
      = paginate @columns
    - else
      button.pager-btn disabled=true ‹
      button.pager-num.active 1
      button.pager-nav-btn ›
    
  .per-page-selector
    span 表示件数
    select
      option 30件
      option 50件

/ 右下の固定フローティングネオンボタン（共通管理ルートの新規作成画面へ接続）
= link_to new_column_path, class: "floating-sparkle-btn" do
  svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
    line x1="12" y1="5" x2="12" y2="19"
    line x1="5" y1="12" x2="19" y2="12"