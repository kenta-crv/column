      polyline points="6 9 12 15 18 9"

/ 3. KPIグリッド（ミニチャート・成功率サークル付き）
.kpi-main-grid
  .kpi-stat-cards
    .kpi-card
      .kpi-header
        .kpi-title-wrap
          .kpi-icon.icon-blue
            svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
              polygon points="12 2 2 7 12 12 22 7 12 2"
          span.label 総生成数
        .trend.up
          span ↑ 23.5%
      .kpi-body
        .value = @columns.total_count rescue @columns.size
        .comparison 前月比
        .kpi-chart
          svg viewBox="0 0 100 30" class="mini-graph"
            path d="M0,25 Q15,18 30,22 T60,10 T90,5 T100,2" fill="none" stroke="#3b82f6" stroke-width="2"
            path d="M0,25 Q15,18 30,22 T60,10 T90,5 T100,2 L100,30 L0,30 Z" fill="url(#grad-blue)" opacity="0.1"
            defs
              linearGradient id="grad-blue" x1="0%" y1="0%" x2="0%" y2="100%"
                stop offset="0%" stop-color="#3b82f6"
                stop offset="100%" stop-color="#3b82f6" stop-opacity="0"

    .kpi-card
      .kpi-header
        .kpi-title-wrap
          .kpi-icon.icon-green
            svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
              path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"
              polyline points="22 4 12 14.01 9 11.01"
          span.label 公開済み
        .trend.up
          span ↑ 18.7%
      .kpi-body
        .value = Column.where(status: "approved").count
        .comparison 前月比
        .kpi-chart
          svg viewBox="0 0 100 30" class="mini-graph"
            path d="M0,28 Q20,20 40,25 T70,12 T100,4" fill="none" stroke="#10b981" stroke-width="2"
            path d="M0,28 Q20,20 40,25 T70,12 T100,4 L100,30 L0,30 Z" fill="url(#grad-green)" opacity="0.1"
            defs
              linearGradient id="grad-green" x1="0%" y1="0%" x2="0%" y2="100%"
                stop offset="0%" stop-color="#10b981"
                stop offset="100%" stop-color="#10b981" stop-opacity="0"

    .kpi-card
      .kpi-header
        .kpi-title-wrap
          .kpi-icon.icon-orange
