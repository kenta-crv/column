- subscription = @subscription
- current_plan = subscription&.plan_type || current_client.subscription_plan

.plans-onboarding-wrap
  .plans-onboarding
    .plans-onboarding__header
      h1.plans-onboarding__title プラン選択
      p.plans-onboarding__lead プランを選んでお支払い画面へ進みます。

    - if @is_new_account
      .plans-onboarding__notice
        | 新規アカウントは
        strong = "#{Subscription::TRIAL_DAYS}日間"
        | の無料トライアルが利用できます。

    .plans-onboarding__grid
      - if @is_new_account
        - is_trial_active = subscription&.trial_active?
        - trial = Subscription.new(plan_type: :trial)
        - trial_config = Subscription.config_for(:trial)

        .plans-onboarding__card class=("plans-onboarding__card--current" if is_trial_active)
          .plans-onboarding__card-body
            .plans-onboarding__card-top
              span.plans-onboarding__badge.plans-onboarding__badge--empty aria-hidden="true" &nbsp;
            h2.plans-onboarding__card-name = trial.plan_name
            p.plans-onboarding__card-desc = trial_config[:description]
            .plans-onboarding__card-price
              span.plans-onboarding__card-amount ¥0
              span.plans-onboarding__card-period
                = "/ #{Subscription::TRIAL_DAYS}日間"
            ul.plans-onboarding__card-features
              - trial.feature_list.each do |feature|
                li = feature
            .plans-onboarding__card-action
              - if is_trial_active
                button.plans-onboarding__btn.plans-onboarding__btn--disabled type="button" disabled="disabled" 現在のプラン
              - else
                = link_to "このプランを選択", checkout_confirmation_path(plan_type: "trial"), class: "plans-onboarding__btn plans-onboarding__btn--trial"

      - Subscription.checkout_plans.each do |plan_key|
        - plan = Subscription.new(plan_type: plan_key)
        - config = Subscription.config_for(plan_key)
        - is_current = current_plan == plan_key.to_s && subscription&.active?
        - card_classes = ["plans-onboarding__card"]
        - card_classes << "plans-onboarding__card--current" if is_current
        - card_classes << "plans-onboarding__card--popular" if config[:lp_popular]
        - card_classes << "plans-onboarding__card--featured" if config[:lp_featured]

        .plans-onboarding__card class=card_classes.join(" ")
          .plans-onboarding__card-body
            .plans-onboarding__card-top
              - if config[:lp_popular]
                span.plans-onboarding__badge.plans-onboarding__badge--popular 人気 No.1
              - elsif config[:lp_featured]
                span.plans-onboarding__badge.plans-onboarding__badge--featured イチオシ
              - else
                span.plans-onboarding__badge.plans-onboarding__badge--empty aria-hidden="true" &nbsp;
            h2.plans-onboarding__card-name = plan.plan_name
            p.plans-onboarding__card-desc = config[:description]
            .plans-onboarding__card-price
              span.plans-onboarding__card-amount = "¥#{number_with_delimiter(plan.price)}"
              span.plans-onboarding__card-period
                | / 月（税込）
            ul.plans-onboarding__card-features
              - plan.feature_list.each do |feature|
                li = feature
            .plans-onboarding__card-action
              - if is_current
                button.plans-onboarding__btn.plans-onboarding__btn--disabled type="button" disabled="disabled" 現在のプラン
              - else
                = link_to "このプランを選択", checkout_confirmation_path(plan_type: plan_key), class: "plans-onboarding__btn plans-onboarding__btn--primary"
