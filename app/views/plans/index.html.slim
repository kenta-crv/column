.drafify-lp.plans-page
  section.pricing-section
    .pricing-inner
      .plans-top
        .drafity-auth__lang style="margin:0 0 12px auto;max-width:none;padding:0"
          = render "shared/lang_switch"
        .section-header
          span.overline = t("drafity.auth.plans_overline")
          h2.section-title = t("drafity.auth.plans_choose_title")
          - if @is_new_account
            p.section-sub
              = t("drafity.auth.plans_trial_prefix")
              strong = t("drafity.auth.plans_trial_strong", days: Subscription::TRIAL_DAYS)
              = t("drafity.auth.plans_trial_suffix")
        .toggle-wrap
          button.toggle-btn.active type="button" data-plans-toggle="monthly" = t("drafity.auth.plans_monthly")
          button.toggle-btn type="button" data-plans-toggle="yearly"
            = t("drafity.auth.plans_yearly")
            span.toggle-save = t("drafity.auth.plans_yearly_save")

      - if @subscription&.active?
        - usage = current_client.usage_summary
        .plans-usage
          h3.plans-usage__title = t("drafity.auth.plans_usage_title")
          .plans-usage__grid
            .plans-usage__item
              span.plans-usage__label = t("drafity.auth.plans_usage_pillar")
              span.plans-usage__value = "#{usage[:pillar][:used]} / #{usage[:pillar][:limit]}"
            .plans-usage__item
              span.plans-usage__label = t("drafity.auth.plans_usage_child")
              span.plans-usage__value = "#{usage[:child][:used]} / #{usage[:child][:limit]}"
            .plans-usage__item
              span.plans-usage__label = t("drafity.auth.plans_usage_titles")
              span.plans-usage__value = "#{usage[:title_suggestions][:used]} / #{usage[:title_suggestions][:limit]}"
            .plans-usage__item
              span.plans-usage__label = t("drafity.auth.plans_usage_images")
              span.plans-usage__value = "#{usage[:image_generations][:used]} / #{usage[:image_generations][:limit]}"
            .plans-usage__item
              span.plans-usage__label = t("drafity.auth.plans_usage_genres")
              span.plans-usage__value = "#{usage[:genres][:used]} / #{usage[:genres][:limit]}"
            .plans-usage__item
              span.plans-usage__label = t("drafity.auth.plans_usage_api")
              span.plans-usage__value = usage[:api_enabled] ? t("drafity.auth.plans_usage_api_on") : t("drafity.auth.plans_usage_api_off")

      .pricing-scroll-wrap
        button.pricing-scroll-btn.pricing-scroll-prev type="button" aria-label=t("drafity.auth.pricing_prev") data-plans-scroll="-1" disabled=true
          svg viewBox="0 0 24 24" fill="none"
            path d="M15 6l-6 6 6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
        .pricing-grid#plans-pricing-grid
          - current_plan = @subscription&.plan_type || current_client.subscription_plan
          - trial_used = current_client.subscriptions.exists?(plan_type: :trial)

          - Subscription.lp_plans.each do |plan|
            - card_classes = []
            - card_classes << "popular" if plan[:popular]
            - card_classes << "featured" if plan[:featured]
            - is_current = current_plan == plan[:key].to_s && @subscription&.active?
            - card_classes << "current-plan" if is_current
            - cta_class = plan[:popular] ? "filled" : (plan[:featured] ? "featured-cta" : "outline")
            - trial_selectable = plan[:key] == :trial && @is_new_account && !trial_used

            .plan-card class=card_classes.join(" ") data-plan-key=plan[:key] data-monthly=plan[:monthly_price] data-yearly=plan[:yearly_price]
              - if plan[:popular]
                .popular-badge = t("drafity.auth.plans_popular")
              - elsif plan[:featured]
                .featured-badge = t("drafity.auth.plans_featured")
              - elsif is_current
                .popular-badge.current-badge = t("drafity.auth.plans_current")

              .plan-name class=(plan[:popular] ? "accent" : (plan[:featured] ? "featured-name" : "")) = plan[:name]
              .plan-desc = plan[:description]
              .plan-price
                - if plan[:monthly_price] && plan[:yearly_price] && plan[:monthly_price] > 0
                  .plan-price-orig id="plans-#{plan[:key]}-orig" style="display:none" = "¥#{number_with_delimiter(plan[:monthly_price])}#{t('drafity.auth.pricing_per_month')}"
                .plan-price-main
                  span.price-yen ¥
                  span.price-num id="plans-#{plan[:key]}-price" = number_with_delimiter(plan[:monthly_price])
                  - if plan[:key] != :trial
                    span.price-unit = t("drafity.auth.pricing_per_month")
              .plan-price-note id="plans-#{plan[:key]}-note"
                - if plan[:key] == :trial
                  = plan[:note]
                - else
                  = t("drafity.lp.price_note_monthly", price: number_with_delimiter(plan[:monthly_price]))

              hr.plan-divider
              ul.plan-features
                - plan[:features].each do |feature|
                  li
                    svg viewBox="0 0 16 16" fill="none"
                      path d="M3 8l3 3 7-7" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"
                    = feature

              - if is_current
                span.plan-cta.is-disabled = t("drafity.auth.plans_current")
              - elsif plan[:key] == :trial && !trial_selectable
                span.plan-cta.is-disabled = t("drafity.auth.plans_unavailable")
              - else
                = link_to t("drafity.auth.plans_select_cta"), checkout_confirmation_path(plan_type: plan[:key]), class: "plan-cta #{cta_class}"

        button.pricing-scroll-btn.pricing-scroll-next type="button" aria-label=t("drafity.auth.pricing_next") data-plans-scroll="1"
          svg viewBox="0 0 24 24" fill="none"
            path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"

script
  == "window.DRAFITY_PLANS_NOTES = #{ { yearly: t('drafity.lp.js_note_yearly'), monthlyTpl: t('drafity.lp.js_note_monthly', price: '__PRICE__') }.to_json };"
  | (function() {
  |   const initPlansPage = () => {
  |     const page = document.querySelector('.plans-page');
  |     if (!page || page.dataset.plansReady === 'true') return;
  |     page.dataset.plansReady = 'true';
  |
  |     const grid = document.getElementById('plans-pricing-grid');
  |     const prevBtn = page.querySelector('[data-plans-scroll="-1"]');
  |     const nextBtn = page.querySelector('[data-plans-scroll="1"]');
  |
  |     const syncToggle = (isYearly, btn) => {
  |       page.querySelectorAll('.toggle-btn').forEach((b) => b.classList.remove('active'));
  |       btn.classList.add('active');
  |       page.querySelectorAll('.plan-card').forEach((card) => {
  |         const key = card.dataset.planKey;
  |         const monthly = parseInt(card.dataset.monthly, 10);
  |         const yearly = parseInt(card.dataset.yearly, 10);
  |         if (!key || Number.isNaN(monthly)) return;
  |         const price = isYearly ? yearly : monthly;
  |         const priceEl = card.querySelector('#plans-' + key + '-price');
  |         const origEl = card.querySelector('#plans-' + key + '-orig');
  |         const noteEl = card.querySelector('#plans-' + key + '-note');
  |         if (priceEl) priceEl.textContent = price.toLocaleString('ja-JP');
  |         if (origEl) origEl.style.display = (isYearly && monthly > yearly) ? '' : 'none';
  |         if (noteEl) {
  |           noteEl.textContent = (key === 'trial')
  |             ? ''
  |             : (isYearly ? (window.DRAFITY_PLANS_NOTES && window.DRAFITY_PLANS_NOTES.yearly) : ((window.DRAFITY_PLANS_NOTES && window.DRAFITY_PLANS_NOTES.monthlyTpl) || '¥__PRICE__').replace('__PRICE__', monthly.toLocaleString('ja-JP')));
  |         }
  |       });
  |     };
  |
  |     const scrollStep = () => {
  |       const card = grid?.querySelector('.plan-card');
  |       if (!card || !grid) return 280;
  |       const gap = parseFloat(getComputedStyle(grid).columnGap || getComputedStyle(grid).gap) || 20;
  |       return card.offsetWidth + gap;
  |     };
  |
  |     const updateScrollButtons = () => {
  |       if (!grid || !prevBtn || !nextBtn) return;
  |       const maxScroll = grid.scrollWidth - grid.clientWidth;
  |       prevBtn.disabled = grid.scrollLeft <= 1;
  |       nextBtn.disabled = maxScroll <= 1 || grid.scrollLeft >= maxScroll - 1;
  |     };
  |
  |     const scrollPlans = (direction) => {
  |       if (!grid) return;
  |       grid.scrollBy({ left: direction * scrollStep(), behavior: 'smooth' });
  |     };
  |
  |     page.querySelectorAll('[data-plans-toggle]').forEach((btn) => {
  |       btn.addEventListener('click', () => syncToggle(btn.dataset.plansToggle === 'yearly', btn));
  |     });
  |
  |     page.querySelectorAll('[data-plans-scroll]').forEach((btn) => {
  |       btn.addEventListener('click', () => scrollPlans(parseInt(btn.dataset.plansScroll, 10)));
  |     });
  |
  |     if (grid) {
  |       grid.addEventListener('scroll', updateScrollButtons, { passive: true });
  |       window.addEventListener('resize', updateScrollButtons);
  |       updateScrollButtons();
  |     }
  |   };
  |
  |   document.addEventListener('DOMContentLoaded', initPlansPage);
  |   document.addEventListener('turbolinks:load', initPlansPage);
  |   initPlansPage();
  | })();
