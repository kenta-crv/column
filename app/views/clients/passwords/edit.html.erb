<% set_meta_tags title: t("drafity.auth.meta_password_edit_title"), description: t("drafity.auth.meta_password_description") %>

<div class="auth-wrapper auth-wrapper--signup">
  <div class="drafity-auth__lang">
    <%= render "shared/lang_switch" %>
  </div>
  <div class="auth-forms">
    <div class="auth-card auth-card--signup auth-card--login">
      <div class="auth-card__header">
        <%= link_to locale_root_href do %>
          <%= image_tag drafity_logo_image, alt: "Drafity", width: "120" %>
        <% end %>
        <h2 class="auth-card__title"><%= t("drafity.auth.password_edit_title") %></h2>
        <p class="auth-card__lead"><%= t("drafity.auth.password_edit_lead") %></p>
      </div>

      <%= form_for(resource, as: resource_name, url: client_password_update_url_for_locale, html: { method: :put, class: "auth-signup-form" }) do |f| %>
        <%= render "clients/shared/error_messages", resource: resource %>
        <%= f.hidden_field :reset_password_token %>

        <div class="auth-form-section">
          <div class="field">
            <%= f.label :password, t("drafity.auth.new_password") %>
            <% if @minimum_password_length %>
              <em><%= t("drafity.auth.password_hint", count: @minimum_password_length) %></em>
            <% end %>
            <%= f.password_field :password, autofocus: true, autocomplete: "new-password", class: "input-field" %>
          </div>

          <div class="field">
            <%= f.label :password_confirmation, t("drafity.auth.new_password_confirmation") %>
            <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "input-field" %>
          </div>
        </div>

        <div class="actions">
          <%= f.submit t("drafity.auth.submit_password_update"), class: "btn-signup" %>
        </div>
      <% end %>

      <div class="auth-card__footer">
        <%= render "clients/shared/links" %>
      </div>
    </div>
  </div>
</div>
