<%- if controller_name != 'sessions' %>
  <%= link_to t("drafity.auth.link_login"), client_sign_in_path_for_locale %><br />
<% end %>

<%- if devise_mapping.registerable? && controller_name != 'registrations' %>
  <%= link_to t("drafity.auth.link_signup"), client_sign_up_path_for_locale %><br />
<% end %>

<%- if devise_mapping.recoverable? && controller_name != 'passwords' && controller_name != 'registrations' %>
  <%= link_to t("drafity.auth.link_forgot"), client_password_new_path_for_locale %><br />
<% end %>
