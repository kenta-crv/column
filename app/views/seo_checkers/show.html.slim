- set_meta_tags title: t("drafity.seo_checker.meta_title")
- set_meta_tags description: t("drafity.seo_checker.meta_description")

.drafify-lp.seo-checker-page
  nav.nav
    .nav-inner
      = link_to locale_root_href
        = image_tag "logo2.png", width: "150px"
      .nav-links
        = link_to t("drafity.lp.nav_features"), "#{locale_root_href}#features"
        = link_to t("drafity.seo_checker.nav_label"), seo_checker_path_for_locale, class: "active"
        = link_to t("drafity.lp.nav_columns"), ai_article_columns_index_path
        = link_to t("drafity.lp.nav_pricing"), "#{locale_root_href}#pricing"
      .nav-cta
        = render "shared/lang_switch"
        = link_to t("drafity.lp.login"), new_client_session_path, class: "btn-login"
        = link_to t("drafity.lp.cta_start"), "/clients/sign_up", class: "btn-primary"

  section.seo-hero
    .seo-hero-inner
      p.seo-brand Drafity
      h1.seo-title = t("drafity.seo_checker.title")
      p.seo-lead = t("drafity.seo_checker.lead")

      = form_with url: seo_checker_submit_path_for_locale, method: :post, local: true, html: { class: "seo-form" } do
        label.seo-label for="seo-url" = t("drafity.seo_checker.url_label")
        .seo-form-row
          - if @limit_reached
            input#seo-url.seo-input type="url" name="url" value=@url placeholder=t("drafity.seo_checker.url_placeholder") disabled=true
          - else
            input#seo-url.seo-input type="url" name="url" value=@url placeholder=t("drafity.seo_checker.url_placeholder") required=true autocomplete="url"

        label.seo-label.seo-label-spaced for="seo-keyword" = t("drafity.seo_checker.keyword_label")
        - if @limit_reached
          input#seo-keyword.seo-input type="text" name="keyword" value=@keyword placeholder=t("drafity.seo_checker.keyword_placeholder") disabled=true
        - else
          input#seo-keyword.seo-input type="text" name="keyword" value=@keyword placeholder=t("drafity.seo_checker.keyword_placeholder") autocomplete="off"
        p.seo-field-hint = t("drafity.seo_checker.keyword_hint")

        .seo-form-actions
          - if @limit_reached
            button.seo-submit type="button" disabled=true = t("drafity.seo_checker.submit")
          - else
            button.seo-submit type="submit" = t("drafity.seo_checker.submit")
        p.seo-remaining
          - if seo_checker_unlimited?
            = t("drafity.seo_checker.remaining_unlimited")
          - else
            = t("drafity.seo_checker.remaining", count: @remaining.to_i, limit: SeoChecker::UsageLimiter::DAILY_LIMIT)

  - if @report
    section.seo-result#seo-result
      .seo-result-inner
        .seo-score-block
          .seo-score-main class=seo_score_level(@report.overall_score)
            span.seo-score-number = @report.overall_score
            span.seo-score-unit = "/ 100"
          .seo-score-meta
            p.seo-score-label = t("drafity.seo_checker.overall")
            p.seo-score-url = @report.final_url
            - if @report.title.present?
              p.seo-score-page-title = @report.title

        .seo-axes
          - @report.axes.each do |key, axis|
            .seo-axis class=("is-excluded" if axis[:excluded])
              .seo-axis-head
                span.seo-axis-name = seo_axis_label(key)
                span.seo-axis-score
                  - if axis[:excluded] || axis[:score].nil?
                    = t("drafity.seo_checker.score_na")
                  - else
                    = axis[:score]
              .seo-axis-bar
                - unless axis[:excluded] || axis[:score].nil?
                  span.seo-axis-fill style="width: #{axis[:score]}%"
              p.seo-axis-note = axis[:note]

        .seo-method
          h2.seo-section-title = t("drafity.seo_checker.method_title")
          ul.seo-method-list
            li = t("drafity.seo_checker.method_1")
            li = t("drafity.seo_checker.method_2")
            li = t("drafity.seo_checker.method_3")
            li = t("drafity.seo_checker.method_4")

        - cluster = @report.cluster
        .seo-cluster
          h2.seo-section-title = t("drafity.seo_checker.cluster_title")
          p.seo-cluster-status class="is-#{cluster[:status]}"
            = t("drafity.seo_checker.cluster_status_#{cluster[:status]}")

          - crumbs = Array(@report.stats[:breadcrumb_labels]).reject(&:blank?)
          - if crumbs.any?
            p.seo-cluster-line
              span.seo-cluster-key = t("drafity.seo_checker.breadcrumb_found")
              span = crumbs.join(" › ")
          - else
            p.seo-cluster-line
              span.seo-cluster-key = t("drafity.seo_checker.breadcrumb_found")
              span = t("drafity.seo_checker.breadcrumb_none")

          - if cluster[:status] == "not_applicable"
            p.seo-cluster-evidence = t("drafity.seo_checker.cluster_top_page_help")
          - else
            - if cluster[:genre_hint].present?
              p.seo-cluster-line
                span.seo-cluster-key = t("drafity.seo_checker.genre_candidate")
                span = cluster[:genre_hint]
            - if cluster[:pillar_candidate].present? || cluster[:cluster_candidate].present?
              p.seo-cluster-line
                span.seo-cluster-key = t("drafity.seo_checker.pillar_candidate")
                span = cluster[:pillar_candidate].presence || "—"
              p.seo-cluster-line
                span.seo-cluster-key = t("drafity.seo_checker.cluster_candidate")
                span = cluster[:cluster_candidate].presence || "—"
            p.seo-cluster-evidence
              = t("drafity.seo_checker.cluster_evidence")
              = " "
              = Array(cluster[:evidence]).join(" / ")
            - if cluster[:confidence].present?
              p.seo-cluster-confidence
                = t("drafity.seo_checker.confidence", value: cluster[:confidence].to_i)
        .seo-metrics
          h2.seo-section-title = t("drafity.seo_checker.metrics_title")
          - stats = @report.stats
          - kw = stats[:keyword] || {}
          - tech = @report.technical || {}

          .seo-metrics-grid
            .seo-metric
              span.seo-metric-label = t("drafity.seo_checker.metric_title")
              p.seo-metric-value.seo-metric-text = stats[:title].presence || t("drafity.seo_checker.metric_empty")
              p.seo-metric-sub = t("drafity.seo_checker.metric_chars", count: stats[:title_length].to_i)

            .seo-metric
              span.seo-metric-label = t("drafity.seo_checker.metric_description")
              p.seo-metric-value.seo-metric-text = stats[:meta_description].presence || t("drafity.seo_checker.metric_empty")
              p.seo-metric-sub = t("drafity.seo_checker.metric_chars", count: stats[:meta_description_length].to_i)

            .seo-metric
              span.seo-metric-label = t("drafity.seo_checker.metric_char_count")
              p.seo-metric-value = number_with_delimiter(stats[:char_count].to_i)
              p.seo-metric-sub = t("drafity.seo_checker.metric_char_count_hint")

            .seo-metric
              span.seo-metric-label = t("drafity.seo_checker.metric_headings")
              ul.seo-metric-list
                li
                  span = "H2"
                  strong = stats[:h2_count].to_i
                li
                  span = "H3"
                  strong = stats[:h3_count].to_i
                li
                  span = "H4"
                  strong = stats[:h4_count].to_i

            .seo-metric.seo-metric-wide
              span.seo-metric-label = t("drafity.seo_checker.metric_keyword")
              - if kw[:present]
                p.seo-metric-keyword
                  span.seo-metric-keyword-chip = kw[:keyword]
                  span.seo-metric-keyword-total = t("drafity.seo_checker.metric_keyword_total", count: kw[:total_count].to_i)
                ul.seo-metric-list.seo-metric-list-inline
                  li
                    span = t("drafity.seo_checker.metric_keyword_title")
                    strong = kw[:title_count].to_i
                  li
                    span = t("drafity.seo_checker.metric_keyword_heading")
                    strong = kw[:heading_count].to_i
                  li
                    span = t("drafity.seo_checker.metric_keyword_body")
                    strong = kw[:body_count].to_i
                  li
                    span = t("drafity.seo_checker.metric_keyword_description")
                    strong = kw[:description_count].to_i
              - else
                p.seo-metric-value.seo-metric-muted = t("drafity.seo_checker.metric_keyword_blank")

            - domain_age = tech[:domain_age] || {}
            .seo-metric class="is-#{domain_age[:status].presence || 'unknown'}"
              span.seo-metric-label = t("drafity.seo_checker.metric_domain_age")
              p.seo-metric-value = domain_age[:message].presence || t("drafity.seo_checker.metric_empty")
              - if domain_age[:domain].present?
                p.seo-metric-sub = domain_age[:domain]

            - ssl = tech[:ssl] || {}
            .seo-metric class="is-#{ssl[:status].presence || 'unknown'}"
              span.seo-metric-label = t("drafity.seo_checker.metric_ssl")
              p.seo-metric-value = ssl[:message].presence || t("drafity.seo_checker.metric_empty")
              - if ssl[:issuer].present?
                p.seo-metric-sub = t("drafity.seo_checker.metric_ssl_issuer", issuer: ssl[:issuer])

            - dns = tech[:dns] || {}
            .seo-metric class="is-#{dns[:status].presence || 'unknown'}"
              span.seo-metric-label = t("drafity.seo_checker.metric_dns")
              p.seo-metric-value = dns[:message].presence || t("drafity.seo_checker.metric_empty")
              - if Array(dns[:a_records]).any?
                p.seo-metric-sub = t("drafity.seo_checker.metric_dns_a", records: Array(dns[:a_records]).first(3).join(", "))
              - if Array(dns[:mx_records]).any?
                - mx_text = Array(dns[:mx_records]).first(3).map { |m| "#{m[:exchange]} (#{m[:preference]})" }.join(", ")
                p.seo-metric-sub = t("drafity.seo_checker.metric_dns_mx", records: mx_text)

        .seo-stats
          p.seo-stats-line = t("drafity.seo_checker.stats_line", chars: @report.stats[:char_count].to_i, h2: @report.stats[:h2_count].to_i, h3: @report.stats[:h3_count].to_i, h4: @report.stats[:h4_count].to_i, links: @report.stats[:internal_link_count].to_i)
          - if @report.axes[:cluster] && @report.axes[:cluster][:excluded]
            p.seo-stats-line = t("drafity.seo_checker.overall_without_cluster")

        - if @report.improvements.any?
          .seo-improvements
            h2.seo-section-title = t("drafity.seo_checker.improvements_title")
            ol.seo-improve-list
              - @report.improvements.each do |tip|
                li = tip

        .seo-cta-block
          p.seo-cta-text = t("drafity.seo_checker.cta_text")
          = link_to t("drafity.seo_checker.cta_button"), "/clients/sign_up", class: "btn-primary-lg"
          p.seo-remaining
            - if seo_checker_unlimited?
              = t("drafity.seo_checker.remaining_unlimited")
            - else
              = t("drafity.seo_checker.remaining", count: @remaining.to_i, limit: SeoChecker::UsageLimiter::DAILY_LIMIT)

  - elsif @limit_reached
    section.seo-limit
      .seo-limit-inner
        h2.seo-section-title = t("drafity.seo_checker.limit_title")
        p = t("drafity.seo_checker.limit_body")
        = link_to t("drafity.seo_checker.cta_button"), "/clients/sign_up", class: "btn-primary-lg"

  footer.lp-footer
    .lp-footer-inner
      = link_to locale_root_href, class: "lp-footer-brand" do
        = image_tag "logo2.png", width: "120", alt: "Drafity"
      nav.lp-footer-nav aria-label=t("drafity.lp.footer_nav")
        = link_to t("drafity.seo_checker.nav_label"), seo_checker_path_for_locale
        = link_to t("drafity.lp.footer_articles"), ai_article_columns_index_path
        = link_to t("drafity.lp.footer_start"), "/clients/sign_up"
      p.lp-footer-copy = t("drafity.lp.footer_copy", year: Time.current.year)
