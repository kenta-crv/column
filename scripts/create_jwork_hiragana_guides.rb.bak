UPDATES.each do |code, attrs|
  column = Column.find_by!(code: code)
  column.update!(
    title: attrs[:title],
    keyword: attrs[:keyword],
    description: attrs[:description],
    body: attrs[:body].strip,
    language: "hiragana"
  )
  puts "OK | #{column.id} | #{column.language} | #{column.code} | #{column.title}"
end

puts "DONE #{UPDATES.size}"
